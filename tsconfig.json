{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    
    // Basic settings (keeping current state)
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    
    // Fix for drizzle-zod .omit() type issues
    "strictNullChecks": true,
    
    // Very safe strict checks (minimal risk)
    "noFallthroughCasesInSwitch": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "forceConsistentCasingInFileNames": true,
    
    // Temporarily disabled - will enable incrementally
    // "noImplicitReturns": true,            // Needs function return fixes
    // "exactOptionalPropertyTypes": true,   // Needs strictNullChecks + fixes
    // "verbatimModuleSyntax": true,         // Needs import statement fixes
    // "noImplicitOverride": true,           // Needs override keyword additions
    
    "baseUrl": ".",
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"],
      "@assets/*": ["./attached_assets/*"]
    }
  },
  "include": [
    "client/src",
    "shared",
    "server",
    "vite.config.ts"
  ],
  "exclude": ["node_modules"]
}