{
  "include": ["client/src/**/*", "shared/**/*", "server/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    },
    
    // Additional strict checks for better code quality
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // "noUncheckedIndexedAccess": true,  // Temporarily disabled
    // "exactOptionalPropertyTypes": true,  // Temporarily disabled
    "noImplicitOverride": true,
    // "noPropertyAccessFromIndexSignature": true,  // Temporarily disabled
    
    // Helpful for catching unused code
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    
    // Better import/export checking
    // "verbatimModuleSyntax": true,  // Temporarily disabled
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    
    // Ensure consistent casing
    "forceConsistentCasingInFileNames": true
  }
}
