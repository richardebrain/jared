\n                break;\n              }\n            }\n          }\n          \n          correctInARow = 0;\n        } else if (incorrectInARow >= 2 && currentQuestion + 1 < totalQuestions) {\n          // Try to decrease difficulty of next question\n          for (let i = currentQuestion + 1; i < totalQuestions; i++) {\n            if (questions[i].points > 5) {\n              let nextLevel;\n              \n              if (questions[i].points === 15) nextLevel = \'level2\';\n              else nextLevel = \'level1\';\n              \n              // Find a replacement question from lower level\n              const possibleReplacements = questionsData[nextLevel].filter(q => \n                !questions.some(existingQ => existingQ.question === q.question)\n              );\n              \n              if (possibleReplacements.length > 0) {\n                // Replace with a lower difficulty question\n                const randomIndex = Math.floor(Math.random() * possibleReplacements.length);\n                questions[i] = possibleReplacements[randomIndex];\n                break;\n              }\n            }\n          }\n          \n          incorrectInARow = 0;\n        }\n        \n        loadQuestion();\n        updateProgress();\n      } else {\n        showResults();\n      }\n    }\n\n    // Update progress bar\n    function updateProgress() {\n      const progress = ((currentQuestion) / totalQuestions) * 100;\n      progressFill.style.width = `${progress}%`;\n    }\n\n    // Show quiz results\n    function showResults() {\n      quizSection.style.display = \'none\';\n      resultsSection.style.display = \'block\';\n      \n      // Set final score\n      finalScore.textContent = points;\n      \n      // Calculate accuracy\n      let totalCorrect = 0;\n      let totalQuestionsTaken = 0;\n      \n      Object.values(domainScores).forEach(domain => {\n        totalCorrect += domain.correct;\n        totalQuestionsTaken += domain.total;\n      })