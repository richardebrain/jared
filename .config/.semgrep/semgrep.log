n        ],\n        correctIndex: 1,\n        explanation: "Children have different sensory and movement needs. Providing appropriate accommodations helps them participate successfully."\n      },\n      {\n        text: "What is the main purpose of the CLASS assessment tool in early childhood settings?",\n        options: [\n          "To evaluate physical facilities only",\n          "To assess teacher-child interactions",\n          "To measure children\'s academic achievement",\n          "To ensure compliance with licensing requirements"\n        ],\n        correctIndex: 1,\n        explanation: "CLASS (Classroom Assessment Scoring System) measures the quality of teacher-child interactions across emotional support, classroom organization, and instructional support domains."\n      }\n    ];\n\n    // Variables\n    let currentQuestionIndex = 0;\n    let score = 0;\n    let selectedOptionIndex = null;\n    let optionElements = [];\n\n    // DOM Elements\n    const questionContainer = document.getElementById(\'question-container\');\n    const checkBtn = document.getElementById(\'check-btn\');\n    const nextBtn = document.getElementById(\'next-btn\');\n    const scoreDisplay = document.getElementById(\'score\');\n    const quizContainer = document.getElementById(\'quiz-container\');\n    const finalResults = document.getElementById(\'final-results\');\n    const finalScoreDisplay = document.getElementById(\'final-score\');\n    const feedbackDisplay = document.getElementById(\'feedback\');\n    const restartBtn = document.getElementById(\'restart-btn\');\n\n    // Initialize Quiz\n    function initQuiz() {\n      currentQuestionIndex = 0;\n      score = 0;\n      loadQuestion();\n      updateScore();\n      quizContainer.style.display = \'block\';\n      finalResults.style.display = \'none\';\n    }\n\n    // Load Question\n    function loadQuestion() {\n      selectedOptionIndex = null;\n      \n      const question = questions[currentQuestionIndex];\n      \