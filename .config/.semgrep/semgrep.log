2025-07-06 02:31:06,042 - semgrep.rule_match - DEBUG - match_key = ('\n    // Question data by difficulty level\n    const level1Questions = [\n      {\n        id: 1,\n        question: "Which of the following is a key principle of developmentally appropriate practice?",\n        options: [\n          "Focusing on academic skills only",\n          "Treating all children the same way",\n          "Acknowledging children\'s individual development",\n          "Prioritizing teacher-directed activities"\n        ],\n        correctAnswer: "Acknowledging children\'s individual development",\n        explanation: "Developmentally appropriate practice recognizes each child\'s unique development trajectory and adapts teaching approaches accordingly.",\n        domain: "Child Development",\n        difficulty: 1,\n        pointValue: 5\n      },\n      {\n        id: 2,\n        question: "What is an effective way to promote language development in preschoolers?",\n        options: [\n          "Correcting grammatical errors immediately",\n          "Engaging in back-and-forth conversations",\n          "Using simplified vocabulary only",\n          "Limiting conversation to instruction time"\n        ],\n        correctAnswer: "Engaging in back-and-forth conversations",\n        explanation: "Back-and-forth conversations (serve and return interactions) build language skills and neural connections.",\n        domain: "Language Development",\n        difficulty: 1,\n        pointValue: 5\n      },\n      {\n        id: 3,\n        question: "Which strategy best supports social-emotional learning in toddlers?",\n        options: [\n          "Removing emotional challenges",\n          "Focusing only on academic readiness",\n          "Naming and validating feelings",\n          "Implementing strict behavioral controls"\n        ],\n        correctAnswer: "Naming and validating feelings",\n        explanation: "Helping toddlers identify and name their emotions supports emotional regulation development.",\n        domain: "Social-Emotional Development",\n        difficulty: 1,\n        pointValue: 5\n      },\n      {\n        id: 11,\n        question: "During circle time, you notice a child has trouble sitting still. What might be the best initial response?",\n        options: [\n          "Tell them to sit still or they\'ll lose their turn",\n          "Provide a fidget tool or movement cushion to help them regulate",\n          "Remove them from circle time until they can behave",\n          "Ignore the behavior as they\'ll eventually learn to sit still"\n        ],\n        correctAnswer: "Provide a fidget tool or movement cushion to help them regulate",\n        explanation: "Children have different sensory and movement needs. Providing appropriate accommodations helps them participate successfully in group activities.",\n        domain: "Classroom Management",\n        difficulty: 1,\n        pointValue: 5\n      },\n      {\n        id: 12,\n        question: "What is the most appropriate way to display children\'s artwork in a preschool classroom?",\n        options: [\n          "Only display the best pieces that meet teacher standards",\n          "Post all artwork at children\'s eye level with their permission",\n          "Have teachers correct mistakes before displaying work",\n          "Only display artwork of children who follow directions well"\n        ],\n        correctAnswer: "Post all artwork at children\'s eye level with their permission",\n        explanation: "Displaying artwork at children\'s eye level shows respect for their perspective, while getting permission honors their agency and ownership of their creations.",\n        domain: "Learning Environment",\n        difficulty: 1,\n        pointValue: 5\n      }\n    ];\n\n    const level2Questions = [\n      {\n        id: 4,\n        question: "What is the main purpose of the CLASS assessment tool in early childhood settings?",\n        options: [\n          "To evaluate physical facilities only",\n          "To assess teacher-child interactions",\n          "To measure children\'s academic achievement",\n          "To ensure compliance with licensing requirements"\n        ],\n        correctAnswer: "To assess teacher-child interactions",\n        explanation: "The Classroom Assessment Scoring System (CLASS) measures the quality of teacher-child interactions.",\n        domain: "Assessment",\n        difficulty: 2,\n        pointValue: 10\n      },\n      {\n        id: 5,\n        question: "Which approach best represents authentic assessment in early childhood?",\n        options: [\n          "Weekly standardized tests",\n          "Observation during natural play",\n          "Workbooks completed at home",\n          "Comparing children to age norms only"\n        ],\n        correctAnswer: "Observation during natural play",\n        explanation: "Authentic assessment gathers information about children\'s abilities during regular activities and play.",\n        domain: "Assessment",\n        difficulty: 2,\n        pointValue: 10\n      },\n      {\n        id: 6,\n        question: "According to Vygotsky\'s Zone of Proximal Development, when should teachers provide scaffolding?",\n        options: [\n          "Only when children ask for help",\n          "For tasks children can already do independently",\n          "For tasks slightly beyond current ability",\n          "Only during formal instruction"\n        ],\n        correctAnswer: "For tasks slightly beyond current ability",\n        explanation: "Scaffolding is most effective in the zone between what a child can do independently and what they cannot do yet.",\n        domain: "Child Development",\n        difficulty: 2,\n        pointValue: 10\n      },\n      {\n        id: 13,\n        question: "When using \'serve and return\' interactions with infants and toddlers, what are you primarily supporting?",\n        options: [\n          "Table manners for meal times",\n          "Their need for constant entertainment",\n          "Brain architecture and secure attachments",\n          "Future athletic abilities"\n        ],\n        correctAnswer: "Brain architecture and secure attachments",\n        explanation: "Serve and return interactions, where adults respond appropriately to a child\'s communication attempts, strengthen neural connections and build secure relationships that are foundational for development.",\n        domain: "Brain Development",\n        difficulty: 2,\n        pointValue: 10\n      },\n      {\n        id: 14,\n        question: "A child in your class frequently bites others when frustrated. Which approach is most developmentally appropriate?",\n        options: [\n          "Time-out until they apologize",\n          "Bite them back so they understand how it feels",\n          "Closely observe triggers, provide teethers/alternatives, and teach communication skills",\n          "Tell their parents to handle it at home"\n        ],\n        correctAnswer: "Closely observe triggers, provide teethers/alternatives, and teach communication skills",\n        explanation: "Biting is often a communication strategy for children who lack verbal skills. The appropriate response involves understanding triggers, providing sensory alternatives, and teaching more effective communication methods.",\n        domain: "Guidance and Behavior",\n        difficulty: 2,\n        pointValue: 10\n      }\n    ];\n\n    const level3Questions = [\n      {\n        id: 7,\n        question: "What is the key difference between Piaget\'s and Vygotsky\'s theories of cognitive development?",\n        options: [\n          "Piaget emphasized social interaction; Vygotsky emphasized biological maturation",\n          "Piaget emphasized stages; Vygotsky emphasized cultural context and social learning",\n          "Piaget studied infants; Vygotsky studied only school-age children",\n          "Piaget focused on language; Vygotsky ignored language development"\n        ],\n        correctAnswer: "Piaget emphasized stages; Vygotsky emphasized cultural context and social learning",\n        explanation: "Piaget\'s theory focuses on universal cognitive stages, while Vygotsky emphasized the role of culture and social interaction in learning.",\n        domain: "Child Development",\n        difficulty: 3,\n        pointValue: 15\n      },\n      {\n        id: 8,\n        question: "Which best describes the concept of executive function in early childhood?",\n        options: [\n          "The ability to follow multi-step instructions perfectly",\n          "Mental processes including working memory, self-control and flexible thinking",\n          "Leadership skills demonstrated among peer groups",\n          "Early literacy and numeracy foundations"\n        ],\n        correctAnswer: "Mental processes including working memory, self-control and flexible thinking",\n        explanation: "Executive function involves cognitive processes that help children manage thoughts, actions, and emotions.",\n        domain: "Cognitive Development",\n        difficulty: 3,\n        pointValue: 15\n      },\n      {\n        id: 9,\n        question: "What is the significance of secure attachment in infant development?",\n        options: [\n          "It ensures academic success in kindergarten",\n          "It prevents all behavioral problems",\n          "It forms the foundation for healthy social-emotional development",\n          "It guarantees advanced language acquisition"\n        ],\n        correctAnswer: "It forms the foundation for healthy social-emotional development",\n        explanation: "Secure attachment provides a safe base that supports exploration and healthy relationship development.",\n        domain: "Social-Emotional Development",\n        difficulty: 3,\n        pointValue: 15\n      },\n      {\n        id: 10,\n        question: "What is the primary purpose of the ECERS-R assessment tool?",\n        options: [\n          "To evaluate child development outcomes",\n          "To assess overall program environment quality",\n          "To measure teacher qualifications",\n          "To determine curriculum effectiveness"\n        ],\n        correctAnswer: "To assess overall program environment quality",\n        explanation: "The Early Childhood Environment Rating Scale-Revised (ECERS-R) evaluates the quality of the overall early childhood program environment.",\n        domain: "Program Quality",\n        difficulty: 3,\n        pointValue: 15\n      },\n      {\n        id: 15,\n        question: "According to research on adverse childhood experiences (ACEs), which statement is most accurate?",\n        options: [\n          "Children are naturally resilient and will outgrow trauma with time",\n          "ACEs cannot be counteracted once they have occurred",\n          "Supportive adult relationships can buffer against the effects of toxic stress",\n          "ACEs only affect emotional development, not physical health"\n        ],\n        correctAnswer: "Supportive adult relationships can buffer against the effects of toxic stress",\n        explanation: "Research shows that while ACEs can have significant impacts, consistent supportive relationships with caring adults can provide significant protection against toxic stress and promote resilience.",\n        domain: "Trauma and Resilience",\n        difficulty: 3,\n        pointValue: 15\n      }\n    ];\n\n    // Combine all questions and shuffle within each level\n    function shuffleArray(array) {\n      const shuffled = [...array];\n      for (let i = shuffled.length - 1; i > 0; i--) {\n        const j = Math.floor(Math.random() * (i + 1));\n        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];\n      }\n      return shuffled;\n    }\n\n    // Get questions for current difficulty level\n    function getQuestionsForDifficulty(difficulty) {\n      switch(difficulty) {\n        case 1:\n          return shuffleArray(level1Questions);\n        case 2:\n          return shuffleArray(level2Questions);\n        case 3:\n          return shuffleArray(level3Questions);\n        default:\n          return shuffleArray(level1Questions);\n      }\n    }\n    \n    // State management\n    let currentDifficulty = 1;\n    let currentQuestions = getQuestionsForDifficulty(currentDifficulty);\n    let currentQuestionIndex = 0;\n    let selectedAnswer = null;\n    let isAnswerSubmitted = false;\n    let correctAnswers = 0;\n    let answeredQuestions = 0;\n    let pointsEarned = 0;\n    let correctStreak = 0;\n    let incorrectStreak = 0;\n    let maxDifficultyReached = 1;\n    let domainResults = {};\n    let startTime = null;\n    let difficultyHistory = [1];\n    let questionHistory = [];\n    const MAX_QUESTIONS = 10;\n\n    // DOM Elements\n    const introScreen = document.getElementById(\'intro-screen\');\n    const assessmentScreen = document.getElementById(\'assessment-screen\');\n    const resultsScreen = document.getElementById(\'results-screen\');\n    const startBtn = document.getElementById(\'start-btn\');\n    const submitBtn = document.getElementById(\'submit-btn\');\n    const nextBtn = document.getElementById(\'next-btn\');\n    const restartBtn = document.getElementById(\'restart-btn\');\n\n    // Event Listeners\n    startBtn.addEventListener(\'click\', startAssessment);\n    submitBtn.addEventListener(\'click\', submitAnswer);\n    nextBtn.addEventListener(\'click\', nextQuestion);\n    restartBtn.addEventListener(\'click\', restartAssessment);\n\n    function startAssessment() {\n      introScreen.classList.add(\'hidden\');\n      assessmentScreen.classList.remove(\'hidden\');\n      startTime = new Date();\n      loadQuestion();\n    }\n\n    function loadQuestion() {\n      // Reset state for new question\n      selectedAnswer = null;\n      isAnswerSubmitted = false;\n      submitBtn.disabled = true;\n      submitBtn.style.display = \'block\';\n      nextBtn.style.display = \'none\';\n      document.getElementById(\'feedback-container\').style.display = \'none\';\n\n      // Get current question\n      const currentQuestion = currentQuestions[currentQuestionIndex];\n\n      // Update UI with question data\n      document.getElementById(\'question-text\').textContent = currentQuestion.question;\n      document.getElementById(\'domain-badge\').textContent = currentQuestion.domain;\n      document.getElementById(\'points-badge\').textContent = `${currentQuestion.pointValue} points`;\n      \n      // Update difficulty display\n      updateDifficultyDisplay();\n      \n      // Update progress\n      const progressPercent = (answeredQuestions / MAX_QUESTIONS) * 100;\n      document.getElementById(\'progress-bar\').style.width = `${progressPercent}%`;\n      document.getElementById(\'progress-text\').textContent = `Question ${answeredQuestions + 1} of ${MAX_QUESTIONS}`;\n      document.getElementById(\'question-counter\').textContent = `${answeredQuestions + 1}/${MAX_QUESTIONS}`;\n      document.getElementById(\'points-earned\').textContent = `${pointsEarned} points earned`;\n\n      // Generate options\n      const optionsContainer = document.getElementById(\'options-container\');\n      optionsContainer.innerHTML = \'\';\n      \n      currentQuestion.options.forEach((option, index) => {\n        const optionElement = document.createElement(\'div\');\n        optionElement.className = \'option p-3 border rounded-lg cursor-pointer relative\';\n        optionElement.textContent = option;\n        \n        // Add event listener to select this option\n        optionElement.addEventListener(\'click\', () => {\n          if (isAnswerSubmitted) return;\n          \n          // Remove selected class from all options\n          document.querySelectorAll(\'.option\').forEach(opt => opt.classList.remove(\'selected\'));\n          \n          // Add selected class to this option\n          optionElement.classList.add(\'selected\');\n          \n          // Update selected answer\n          selectedAnswer = option;\n          \n          // Enable submit button\n          submitBtn.disabled = false;\n        });\n        \n        optionsContainer.appendChild(optionElement);\n      });\n    }\n\n    function updateDifficultyDisplay() {\n      const difficultyText = document.getElementById(\'difficulty-display\');\n      let labelText, bgColor;\n      \n      switch(currentDifficulty) {\n        case 1:\n          labelText = "Level 1: Foundational";\n          bgColor = "bg-blue-600";\n          break;\n        case 2:\n          labelText = "Level 2: Intermediate";\n          bgColor = "bg-indigo-600";\n          break;\n        case 3:\n          labelText = "Level 3: Advanced";\n          bgColor = "bg-purple-600";\n          break;\n      }\n      \n      difficultyText.textContent = labelText;\n      difficultyText.className = `${bgColor} px-3 py-1 rounded-full text-sm text-white`;\n    }\n\n    function submitAnswer() {\n      if (!selectedAnswer) return;\n      \n      isAnswerSubmitted = true;\n      \n      const currentQuestion = currentQuestions[currentQuestionIndex];\n      const isCorrect = selectedAnswer === currentQuestion.correctAnswer;\n      \n      // Update state\n      answeredQuestions++;\n      \n      // Track question result for history\n      questionHistory.push({\n        id: currentQuestion.id,\n        difficulty: currentQuestion.difficulty,\n        domain: currentQuestion.domain,\n        isCorrect: isCorrect,\n        pointValue: currentQuestion.pointValue\n      });\n      \n      if (isCorrect) {\n        correctAnswers++;\n        const pointsForThisQuestion = currentQuestion.pointValue;\n        pointsEarned += pointsForThisQuestion;\n        correctStreak++;\n        incorrectStreak = 0;\n        \n        // Update domain scores\n        if (!domainResults[currentQuestion.domain]) {\n          domainResults[currentQuestion.domain] = { \n            correct: 0, \n            total: 0,\n            points: 0\n          };\n        }\n        domainResults[currentQuestion.domain].correct++;\n        domainResults[currentQuestion.domain].points += pointsForThisQuestion;\n        \n        // Play success sound and animation\n        playSuccessSound();\n        triggerConfetti();\n        \n        // Show points animation\n        showPointsAnimation(pointsForThisQuestion);\n        \n        // Update points display immediately\n        document.getElementById(\'points-earned\').textContent = `${pointsEarned} points earned`;\n      } else {\n        incorrectStreak++;\n        correctStreak = 0;\n      }\n      \n      // Always increment total for the domain\n      if (!domainResults[currentQuestion.domain]) {\n        domainResults[currentQuestion.domain] = { \n          correct: 0, \n          total: 0,\n          points: 0\n        };\n      }\n      domainResults[currentQuestion.domain].total++;\n      \n      // Update UI\n      const feedbackContainer = document.getElementById(\'feedback-container\');\n      feedbackContainer.style.display = \'block\';\n      feedbackContainer.className = isCorrect ? \n        \'p-4 rounded-lg border border-green-200 bg-green-50 animate-fade-in\' : \n        \'p-4 rounded-lg border border-red-200 bg-red-50 animate-fade-in\';\n      \n      const feedbackHTML = `\n        <div class="flex items-start">\n          <div class="mr-3 text-2xl">${isCorrect ? \'✓\' : \'✗\'}</div>\n          <div>\n            <div class="${isCorrect ? \'text-green-600\' : \'text-red-600\'} font-bold text-lg mb-1">\n              ${isCorrect ? \'Correct!\' : \'Incorrect\'}\n            </div>\n            <div class="text-gray-700 mb-2">\n              <strong>Correct answer:</strong> ${currentQuestion.correctAnswer}\n            </div>\n            <div class="text-gray-600">\n              ${currentQuestion.explanation}\n            </div>\n          </div>\n        </div>\n      `;\n      \n      feedbackContainer.innerHTML = feedbackHTML;\n      \n      // Update difficulty level based on performance\n      adjustDifficulty();\n      \n      document.getElementById(\'points-earned\').textContent = `${pointsEarned} points earned`;\n      \n      submitBtn.style.display = \'none\';\n      nextBtn.style.display = \'block\';\n      \n      // Highlight correct answer\n      document.querySelectorAll(\'.option\').forEach(option => {\n        if (option.textContent === currentQuestion.correctAnswer) {\n          option.classList.add(\'correct-answer\');\n        } else if (option.classList.contains(\'selected\') && option.textContent !== currentQuestion.correctAnswer) {\n          option.classList.add(\'incorrect-answer\');\n        }\n      });\n    }\n    \n    function adjustDifficulty() {\n      // Get current difficulty before adjustment\n      const previousDifficulty = currentDifficulty;\n      \n      // If the user gets 2 questions correct in a row at their current level, increase difficulty\n      if (correctStreak >= 2 && currentDifficulty < 3) {\n        currentDifficulty++;\n        correctStreak = 0; // Reset streak after changing difficulty\n        \n        // Track highest difficulty reached\n        if (currentDifficulty > maxDifficultyReached) {\n          maxDifficultyReached = currentDifficulty;\n        }\n        \n        // Show difficulty increase notification\n        showDifficultyChangeNotification(true);\n        \n        // Get new questions for the higher difficulty\n        currentQuestions = getQuestionsForDifficulty(currentDifficulty);\n        currentQuestionIndex = 0; // Reset index for new difficulty level\n      }\n      \n      // If the user gets 2 questions wrong in a row, decrease difficulty\n      if (incorrectStreak >= 2 && currentDifficulty > 1) {\n        currentDifficulty--;\n        incorrectStreak = 0; // Reset streak after changing difficulty\n        \n        // Show difficulty decrease notification\n        showDifficultyChangeNotification(false);\n        \n        // Get new questions for the lower difficulty\n        currentQuestions = getQuestionsForDifficulty(currentDifficulty);\n        currentQuestionIndex = 0; // Reset index for new difficulty level\n      }\n      \n      // Add new difficulty to history if it changed\n      if (previousDifficulty !== currentDifficulty) {\n        difficultyHistory.push(currentDifficulty);\n      }\n    }\n    \n    function showDifficultyChangeNotification(isIncrease) {\n      const notification = document.createElement(\'div\');\n      notification.className = isIncrease ? \n        \'notification bg-green-100 border-l-4 border-green-500 text-green-700\' :\n        \'notification bg-amber-100 border-l-4 border-amber-500 text-amber-700\';\n      \n      const icon = document.createElement(\'span\');\n      icon.className = \'mr-2\';\n      icon.innerHTML = isIncrease ? \'⬆️\' : \'⬇️\';\n      \n      const message = document.createElement(\'span\');\n      message.innerHTML = isIncrease ? \n        \'<b>Difficulty increased!</b> Questions will be more challenging.\' :\n        \'<b>Difficulty adjusted.</b> Questions will be more accessible.\';\n      \n      notification.appendChild(icon);\n      notification.appendChild(message);\n      document.body.appendChild(notification);\n      \n      // Notification will be removed by the animation\n      setTimeout(() => {\n        document.body.removeChild(notification);\n      }, 3000);\n    }\n    \n    function nextQuestion() {\n      try {\n        // Clear feedback\n        document.getElementById(\'feedback-container\').style.display = \'none\';\n        \n        // Update points display immediately to ensure it\'s always current\n        document.getElementById(\'points-earned\').textContent = `${pointsEarned} points earned`;\n        \n        // Move to next question in current difficulty level\n        currentQuestionIndex++;\n        \n        // Check if we need new questions at the current difficulty level\n        if (currentQuestionIndex >= currentQuestions.length) {\n          // Reset index and get fresh questions at the current difficulty\n          currentQuestionIndex = 0;\n          currentQuestions = getQuestionsForDifficulty(currentDifficulty);\n        }\n        \n        // If we\'ve reached max questions, end assessment\n        if (answeredQuestions >= MAX_QUESTIONS) {\n          showResults();\n          return;\n        }\n        \n        // Otherwise, load the next question\n        loadQuestion();\n      } catch (error) {\n        // Error recovery - if something goes wrong, show a message and try to continue\n        console.error("Error in nextQuestion:", error);\n        alert("There was a problem loading the next question. The assessment will try to continue.");\n        \n        // Try to reset and continue\n        currentQuestionIndex = 0;\n        currentQuestions = getQuestionsForDifficulty(currentDifficulty);\n        loadQuestion();\n      }\n    }\n    \n    function showResults() {\n      const endTime = new Date();\n      const timeTaken = Math.floor((endTime - startTime) / 1000); // in seconds\n      \n      assessmentScreen.classList.add(\'hidden\');\n      resultsScreen.classList.remove(\'hidden\');\n      \n      // Calculate score as percentage\n      const score = Math.round((correctAnswers / answeredQuestions) * 100);\n      \n      // Update results UI\n      document.getElementById(\'final-score\').textContent = `Your Score: ${score}%`;\n      document.getElementById(\'final-points\').innerHTML = `You earned <span class="font-bold text-green-600">${pointsEarned} points</span>`;\n      document.getElementById(\'final-time\').textContent = `Time taken: ${Math.floor(timeTaken / 60)} minutes ${timeTaken % 60} seconds`;\n      \n      document.getElementById(\'total-questions\').textContent = answeredQuestions;\n      document.getElementById(\'correct-answers\').textContent = correctAnswers;\n      document.getElementById(\'highest-difficulty\').textContent = `${maxDifficultyReached}/3`;\n      document.getElementById(\'accuracy\').textContent = `${score}%`;\n      \n      // Create difficulty chart\n      createDifficultyChart();\n      \n      // Process domain results for strengths and weaknesses\n      const domainPerformance = [];\n      \n      for (const domain in domainResults) {\n        const result = domainResults[domain];\n        const percentage = Math.round((result.correct / result.total) * 100);\n        \n        domainPerformance.push({\n          domain,\n          percentage,\n          points: result.points,\n          correct: result.correct,\n          total: result.total\n        });\n      }\n      \n      // Sort domains by performance\n      domainPerformance.sort((a, b) => b.percentage - a.percentage);\n      \n      // Display strengths (top half of domains)\n      const strengthsContainer = document.getElementById(\'strengths-container\');\n      strengthsContainer.innerHTML = \'\';\n      \n      const numberOfDomains = Object.keys(domainResults).length;\n      const topDomains = domainPerformance.slice(0, Math.ceil(numberOfDomains / 2));\n      \n      if (topDomains.length > 0) {\n        topDomains.forEach(domain => {\n          const domainElement = document.createElement(\'div\');\n          domainElement.className = \'flex justify-between items-center\';\n          domainElement.innerHTML = `\n            <div>\n              <span class="font-medium">${domain.domain}</span>\n              <span class="text-gray-500 text-xs ml-1">(${domain.correct}/${domain.total})</span>\n            </div>\n            <span class="text-green-600 font-bold">${domain.percentage}%</span>\n          `;\n          strengthsContainer.appendChild(domainElement);\n        });\n      } else {\n        strengthsContainer.innerHTML = \'<p class="text-slate-500 italic">Keep practicing to discover your strengths</p>\';\n      }\n      \n      // Display weaknesses (bottom half of domains)\n      const weaknessesContainer = document.getElementById(\'weaknesses-container\');\n      weaknessesContainer.innerHTML = \'\';\n      \n      const bottomDomains = domainPerformance.slice(Math.ceil(numberOfDomains / 2));\n      \n      if (bottomDomains.length > 0) {\n        bottomDomains.forEach(domain => {\n          const domainElement = document.createElement(\'div\');\n          domainElement.className = \'flex justify-between items-center\';\n          domainElement.innerHTML = `\n            <div>\n              <span class="font-medium">${domain.domain}</span>\n              <span class="text-gray-500 text-xs ml-1">(${domain.correct}/${domain.total})</span>\n            </div>\n            <span class="text-amber-600 font-bold">${domain.percentage}%</span>\n          `;\n          weaknessesContainer.appendChild(domainElement);\n        });\n      } else {\n        weaknessesContainer.innerHTML = \'<p class="text-slate-500 italic">Great work! Focus on maintaining your knowledge</p>\';\n      }\n      \n      // Generate personalized recommendations\n      generateRecommendations(bottomDomains);\n      \n      // Trigger a celebratory confetti explosion\n      confetti({\n        particleCount: 100,\n        spread: 70,\n        origin: { y: 0.6 }\n      });\n    }\n    \n    function createDifficultyChart() {\n      const chartContainer = document.getElementById(\'difficulty-chart\');\n      chartContainer.innerHTML = \'\';\n      \n      // Create bars for each question answered\n      questionHistory.forEach((question, index) => {\n        const bar = document.createElement(\'div\');\n        \n        // Set height based on difficulty (1=33%, 2=66%, 3=100%)\n        const heightPercent = (question.difficulty / 3) * 100;\n        \n        // Set colors based on difficulty and correctness\n        let bgColor;\n        if (question.isCorrect) {\n          bgColor = question.difficulty === 1 ? \'bg-blue-400\' : \n                   question.difficulty === 2 ? \'bg-indigo-400\' : \'bg-purple-400\';\n        } else {\n          bgColor = question.difficulty === 1 ? \'bg-blue-200\' : \n                   question.difficulty === 2 ? \'bg-indigo-200\' : \'bg-purple-200\';\n        }\n        \n        bar.className = `flex-1 ${bgColor} mx-0.5 relative`;\n        bar.style.height = `${heightPercent}%`;\n        \n        // Add tooltip with question info\n        bar.title = `Q${index+1}: ${question.domain} (Level ${question.difficulty}) - ${question.isCorrect ? \'Correct\' : \'Incorrect\'}`;\n        \n        // Display difficulty level at the top of the bar for the first question of each level\n        if (index === 0 || questionHistory[index-1].difficulty !== question.difficulty) {\n          const label = document.createElement(\'div\');\n          label.className = \'absolute -top-5 left-0 text-xs font-bold\';\n          label.textContent = `L${question.difficulty}`;\n          bar.appendChild(label);\n        }\n        \n        chartContainer.appendChild(bar);\n      });\n    }\n    \n    function generateRecommendations(weakDomains) {\n      const recommendationsContainer = document.getElementById(\'recommendations-container\');\n      recommendationsContainer.innerHTML = \'\';\n      \n      // Create recommendations based on weakest domains\n      if (weakDomains.length > 0) {\n        weakDomains.forEach(domain => {\n          const recommendationElement = document.createElement(\'div\');\n          recommendationElement.className = \'bg-white rounded-md p-3 border border-indigo-100 flex items-start\';\n          \n          // Generate specific recommendations based on domain\n          let recommendations;\n          switch(domain.domain) {\n            case \'Child Development\':\n              recommendations = "Review child development milestones and theories. Consider exploring resources on cognitive, social, and physical development stages.";\n              break;\n            case \'Classroom Management\':\n              recommendations = "Focus on positive guidance techniques and creating consistent routines. Explore strategies for managing challenging behaviors.";\n              break;\n            case \'Assessment\':\n              recommendations = "Learn more about authentic assessment methods and documentation strategies that capture children\'s natural learning.";\n              break;\n            case \'Social-Emotional Development\':\n              recommendations = "Explore resources on supporting emotional regulation, building secure attachments, and fostering social skills.";\n              break;\n            case \'Brain Development\':\n              recommendations = "Review resources on early brain architecture, executive function development, and the impact of experiences on neural connections.";\n              break;\n            case \'Program Quality\':\n              recommendations = "Study quality standards like ECERS-R and learn strategies for creating rich, developmentally appropriate environments.";\n              break;\n            case \'Trauma and Resilience\':\n              recommendations = "Deepen your understanding of ACEs, trauma-informed practices, and strategies for building resilience in young children.";\n              break;\n            case \'Language Development\':\n              recommendations = "Focus on effective language modeling, book reading strategies, and creating language-rich environments.";\n              break;\n            case \'Guidance and Behavior\':\n              recommendations = "Explore positive guidance techniques, understanding the meaning behind behaviors, and supportive intervention strategies.";\n              break;\n            case \'Cognitive Development\':\n              recommendations = "Learn more about how children construct knowledge through experiences and how to support higher-order thinking skills.";\n              break;\n            case \'Learning Environment\':\n              recommendations = "Study principles of effective classroom design, materials selection, and creating engaging learning centers.";\n              break;\n            default:\n              recommendations = `Review current research and best practices related to ${domain.domain.toLowerCase()}.`;\n          }\n          \n          recommendationElement.innerHTML = `\n            <div class="mr-3 text-indigo-500 text-lg">📚</div>\n            <div>\n              <div class="font-medium text-indigo-700 mb-1">${domain.domain}</div>\n              <p class="text-sm text-gray-600">${recommendations}</p>\n            </div>\n          `;\n          \n          recommendationsContainer.appendChild(recommendationElement);\n        });\n      } else {\n        recommendationsContainer.innerHTML = `\n          <div class="bg-white rounded-md p-3 border border-indigo-100">\n            <p class="text-indigo-700 font-medium">Excellent work! You demonstrated strong knowledge across all domains.</p>\n            <p class="text-sm text-gray-600 mt-1">Continue building your expertise by exploring advanced topics in early childhood education.</p>\n          </div>\n        `;\n      }\n    }\n    \n    function restartAssessment() {\n      // Reset all state\n      currentDifficulty = 1;\n      currentQuestions = getQuestionsForDifficulty(currentDifficulty);\n      currentQuestionIndex = 0;\n      selectedAnswer = null;\n      isAnswerSubmitted = false;\n      correctAnswers = 0;\n      answeredQuestions = 0;\n      pointsEarned = 0;\n      correctStreak = 0;\n      incorrectStreak = 0;\n      maxDifficultyReached = 1;\n      domainResults = {};\n      difficultyHistory = [1];\n      questionHistory = [];\n      \n      // Reset UI\n      resultsScreen.classList.add(\'hidden\');\n      introScreen.classList.remove(\'hidden\');\n      \n      // Shuffle questions\n      level1Questions = shuffleArray(level1Questions);\n      level2Questions = shuffleArray(level2Questions);\n      level3Questions = shuffleArray(level3Questions);\n    }\n    \n    function playSuccessSound() {\n      const audio = new Audio(\'data:audio/mp3;base64,\');\n      audio.volume = 0.5;\n      audio.play();\n    }\n    \n    function triggerConfetti() {\n      const colors = [\'#22c55e\', \'#10b981\', \'#059669\'];\n      \n      confetti({\n        particleCount: 30,\n        angle: 60,\n        spread: 55,\n        origin: { x: 0.1, y: 0.7 },\n        colors: colors\n      });\n      \n      confetti({\n        particleCount: 30,\n        angle: 120,\n        spread: 55,\n        origin: { x: 0.9, y: 0.7 },\n        colors: colors\n      });\n    }\n    // Function to show points animation\n    function showPointsAnimation(points) {\n      const pointsPopup = document.createElement(\'div\');\n      pointsPopup.className = \'fixed z-50 animate-pop\';\n      pointsPopup.style.left = \'50%\';\n      pointsPopup.style.top = \'50%\';\n      pointsPopup.style.transform = \'translate(-50%, -50%)\';\n      pointsPopup.style.pointerEvents = \'none\';\n      \n      // Different colors based on point value\n      let color, size;\n      if (points === 5) {\n        color = \'text-blue-500\';\n        size = \'text-4xl\';\n      } else if (points === 10) {\n        color = \'text-indigo-500\';\n        size = \'text-5xl\';\n      } else {\n        color = \'text-purple-500\';\n        size = \'text-6xl\';\n      }\n      \n      pointsPopup.innerHTML = `<div class="font-bold ${color} ${size} drop-shadow-lg">+${points} points!</div>`;\n      document.body.appendChild(pointsPopup);\n      \n      // Animate up and fade out\n      let top = 50;\n      let opacity = 1;\n      const anim = setInterval(() => {\n        top -= 1;\n        opacity -= 0.03;\n        pointsPopup.style.top = `${top}%`;\n        pointsPopup.style.opacity = opacity;\n        \n        if (opacity <= 0) {\n          clearInterval(anim);\n          document.body.removeChild(pointsPopup);\n        }\n      }, 30);\n    }\n    \n    // Emergency save mechanism - save progress to localStorage\n    function saveProgress() {\n      try {\n        const progressData = {\n          answeredQuestions,\n          correctAnswers,\n          pointsEarned,\n          currentDifficulty,\n          maxDifficultyReached,\n          domainResults,\n          questionHistory,\n          timestamp: new Date().getTime()\n        };\n        \n        localStorage.setItem(\'eceAssessmentProgress\', JSON.stringify(progressData));\n      } catch (e) {\n        console.error("Failed to save progress:", e);\n      }\n    }\n    \n    // Save progress after each answer\n    document.addEventListener(\'visibilitychange\', () => {\n      if (document.visibilityState === \'hidden\' && answeredQuestions > 0) {\n        saveProgress();\n      }\n    });\n    \n    // Also save progress periodically\n    setInterval(saveProgress, 30000);\n   $X $X. ... .$V = "..." $X. ... .innerHTML = ... $X. ... .outerHTML = ... javascript <script ...>\n    // Question data by difficulty level\n    const level1Questions = [\n      {\n        id: 1,\n        question: "Which of the following is a key principle of developmentally appropriate practice?",\n        options: [\n          "Focusing on academic skills only",\n          "Treating all children the same way",\n          "Acknowledging children\'s individual development",\n          "Prioritizing teacher-directed activities"\n        ],\n        correctAnswer: "Acknowledging children\'s individual development",\n        explanation: "Developmentally appropriate practice recognizes each child\'s unique development trajectory and adapts teaching approaches accordingly.",\n        domain: "Child Development",\n        difficulty: 1,\n        pointValue: 5\n      },\n      {\n        id: 2,\n        question: "What is an effective way to promote language development in preschoolers?",\n        options: [\n          "Correcting grammatical errors immediately",\n          "Engaging in back-and-forth conversations",\n          "Using simplified vocabulary only",\n          "Limiting conversation to instruction time"\n        ],\n        correctAnswer: "Engaging in back-and-forth conversations",\n        explanation: "Back-and-forth conversations (serve and return interactions) build language skills and neural connections.",\n        domain: "Language Development",\n        difficulty: 1,\n        pointValue: 5\n      },\n      {\n        id: 3,\n        question: "Which strategy best supports social-emotional learning in toddlers?",\n        options: [\n          "Removing emotional challenges",\n          "Focusing only on academic readiness",\n          "Naming and validating feelings",\n          "Implementing strict behavioral controls"\n        ],\n        correctAnswer: "Naming and validating feelings",\n        explanation: "Helping toddlers identify and name their emotions supports emotional regulation development.",\n        domain: "Social-Emotional Development",\n        difficulty: 1,\n        pointValue: 5\n      },\n      {\n        id: 11,\n        question: "During circle time, you notice a child has trouble sitting still. What might be the best initial response?",\n        options: [\n          "Tell them to sit still or they\'ll lose their turn",\n          "Provide a fidget tool or movement cushion to help them regulate",\n          "Remove them from circle time until they can behave",\n          "Ignore the behavior as they\'ll eventually learn to sit still"\n        ],\n        correctAnswer: "Provide a fidget tool or movement cushion to help them regulate",\n        explanation: "Children have different sensory and movement needs. Providing appropriate accommodations helps them participate successfully in group activities.",\n        domain: "Classroom Management",\n        difficulty: 1,\n        pointValue: 5\n      },\n      {\n        id: 12,\n        question: "What is the most appropriate way to display children\'s artwork in a preschool classroom?",\n        options: [\n          "Only display the best pieces that meet teacher standards",\n          "Post all artwork at children\'s eye level with their permission",\n          "Have teachers correct mistakes before displaying work",\n          "Only display artwork of children who follow directions well"\n        ],\n        correctAnswer: "Post all artwork at children\'s eye level with their permission",\n        explanation: "Displaying artwork at children\'s eye level shows respect for their perspective, while getting permission honors their agency and ownership of their creations.",\n        domain: "Learning Environment",\n        difficulty: 1,\n        pointValue: 5\n      }\n    ];\n\n    const level2Questions = [\n      {\n        id: 4,\n        question: "What is the main purpose of the CLASS assessment tool in early childhood settings?",\n        options: [\n          "To evaluate physical facilities only",\n          "To assess teacher-child interactions",\n          "To measure children\'s academic achievement",\n          "To ensure compliance with licensing requirements"\n        ],\n        correctAnswer: "To assess teacher-child interactions",\n        explanation: "The Classroom Assessment Scoring System (CLASS) measures the quality of teacher-child interactions.",\n        domain: "Assessment",\n        difficulty: 2,\n        pointValue: 10\n      },\n      {\n        id: 5,\n        question: "Which approach best represents authentic assessment in early childhood?",\n        options: [\n          "Weekly standardized tests",\n          "Observation during natural play",\n          "Workbooks completed at home",\n          "Comparing children to age norms only"\n        ],\n        correctAnswer: "Observation during natural play",\n        explanation: "Authentic assessment gathers information about children\'s abilities during regular activities and play.",\n        domain: "Assessment",\n        difficulty: 2,\n        pointValue: 10\n      },\n      {\n        id: 6,\n        question: "According to Vygotsky\'s Zone of Proximal Development, when should teachers provide scaffolding?",\n        options: [\n          "Only when children ask for help",\n          "For tasks children can already do independently",\n          "For tasks slightly beyond current ability",\n          "Only during formal instruction"\n        ],\n        correctAnswer: "For tasks slightly beyond current ability",\n        explanation: "Scaffolding is most effective in the zone between what a child can do independently and what they cannot do yet.",\n        domain: "Child Development",\n        difficulty: 2,\n        pointValue: 10\n      },\n      {\n        id: 13,\n        question: "When using \'serve and return\' interactions with infants and toddlers, what are you primarily supporting?",\n        options: [\n          "Table manners for meal times",\n          "Their need for constant entertainment",\n          "Brain architecture and secure attachments",\n          "Future athletic abilities"\n        ],\n        correctAnswer: "Brain architecture and secure attachments",\n        explanation: "Serve and return interactions, where adults respond appropriately to a child\'s communication attempts, strengthen neural connections and build secure relationships that are foundational for development.",\n        domain: "Brain Development",\n        difficulty: 2,\n        pointValue: 10\n      },\n      {\n        id: 14,\n        question: "A child in your class frequently bites others when frustrated. Which approach is most developmentally appropriate?",\n        options: [\n          "Time-out until they apologize",\n          "Bite them back so they understand how it feels",\n          "Closely observe triggers, provide teethers/alternatives, and teach communication skills",\n          "Tell their parents to handle it at home"\n        ],\n        correctAnswer: "Closely observe triggers, provide teethers/alternatives, and teach communication skills",\n        explanation: "Biting is often a communication strategy for children who lack verbal skills. The appropriate response involves understanding triggers, providing sensory alternatives, and teaching more effective communication methods.",\n        domain: "Guidance and Behavior",\n        difficulty: 2,\n        pointValue: 10\n      }\n    ];\n\n    const level3Questions = [\n      {\n        id: 7,\n        question: "What is the key difference between Piaget\'s and Vygotsky\'s theories of cognitive development?",\n        options: [\n          "Piaget emphasized social interaction; Vygotsky emphasized biological maturation",\n          "Piaget emphasized stages; Vygotsky emphasized cultural context and social learning",\n          "Piaget studied infants; Vygotsky studied only school-age children",\n          "Piaget focused on language; Vygotsky ignored language development"\n        ],\n        correctAnswer: "Piaget emphasized stages; Vygotsky emphasized cultural context and social learning",\n        explanation: "Piaget\'s theory focuses on universal cognitive stages, while Vygotsky emphasized the role of culture and social interaction in learning.",\n        domain: "Child Development",\n        difficulty: 3,\n        pointValue: 15\n      },\n      {\n        id: 8,\n        question: "Which best describes the concept of executive function in early childhood?",\n        options: [\n          "The ability to follow multi-step instructions perfectly",\n          "Mental processes including working memory, self-control and flexible thinking",\n          "Leadership skills demonstrated among peer groups",\n          "Early literacy and numeracy foundations"\n        ],\n        correctAnswer: "Mental processes including working memory, self-control and flexible thinking",\n        explanation: "Executive function involves cognitive processes that help children manage thoughts, actions, and emotions.",\n        domain: "Cognitive Development",\n        difficulty: 3,\n        pointValue: 15\n      },\n      {\n        id: 9,\n        question: "What is the significance of secure attachment in infant development?",\n        options: [\n          "It ensures academic success in kindergarten",\n          "It prevents all behavioral problems",\n          "It forms the foundation for healthy social-emotional development",\n          "It guarantees advanced language acquisition"\n        ],\n        correctAnswer: "It forms the foundation for healthy social-emotional development",\n        explanation: "Secure attachment provides a safe base that supports exploration and healthy relationship development.",\n        domain: "Social-Emotional Development",\n        difficulty: 3,\n        pointValue: 15\n      },\n      {\n        id: 10,\n        question: "What is the primary purpose of the ECERS-R assessment tool?",\n        options: [\n          "To evaluate child development outcomes",\n          "To assess overall program environment quality",\n          "To measure teacher qualifications",\n          "To determine curriculum effectiveness"\n        ],\n        correctAnswer: "To assess overall program environment quality",\n        explanation: "The Early Childhood Environment Rating Scale-Revised (ECERS-R) evaluates the quality of the overall early childhood program environment.",\n        domain: "Program Quality",\n        difficulty: 3,\n        pointValue: 15\n      },\n      {\n        id: 15,\n        question: "According to research on adverse childhood experiences (ACEs), which statement is most accurate?",\n        options: [\n          "Children are naturally resilient and will outgrow trauma with time",\n          "ACEs cannot be counteracted once they have occurred",\n          "Supportive adult relationships can buffer against the effects of toxic stress",\n          "ACEs only affect emotional development, not physical health"\n        ],\n        correctAnswer: "Supportive adult relationships can buffer against the effects of toxic stress",\n        explanation: "Research shows that while ACEs can have significant impacts, consistent supportive relationships with caring adults can provide significant protection against toxic stress and promote resilience.",\n        domain: "Trauma and Resilience",\n        difficulty: 3,\n        pointValue: 15\n      }\n    ];\n\n    // Combine all questions and shuffle within each level\n    function shuffleArray(array) {\n      const shuffled = [...array];\n      for (let i = shuffled.length - 1; i > 0; i--) {\n        const j = Math.floor(Math.random() * (i + 1));\n        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];\n      }\n      return shuffled;\n    }\n\n    // Get questions for current difficulty level\n    function getQuestionsForDifficulty(difficulty) {\n      switch(difficulty) {\n        case 1:\n          return shuffleArray(level1Questions);\n        case 2:\n          return shuffleArray(level2Questions);\n        case 3:\n          return shuffleArray(level3Questions);\n        default:\n          return shuffleArray(level1Questions);\n      }\n    }\n    \n    // State management\n    let currentDifficulty = 1;\n    let currentQuestions = getQuestionsForDifficulty(currentDifficulty);\n    let currentQuestionIndex = 0;\n    let selectedAnswer = null;\n    let isAnswerSubmitted = false;\n    let correctAnswers = 0;\n    let answeredQuestions = 0;\n    let pointsEarned = 0;\n    let correctStreak = 0;\n    let incorrectStreak = 0;\n    let maxDifficultyReached = 1;\n    let domainResults = {};\n    let startTime = null;\n    let difficultyHistory = [1];\n    let questionHistory = [];\n    const MAX_QUESTIONS = 10;\n\n    // DOM Elements\n    const introScreen = document.getElementById(\'intro-screen\');\n    const assessmentScreen = document.getElementById(\'assessment-screen\');\n    const resultsScreen = document.getElementById(\'results-screen\');\n    const startBtn = document.getElementById(\'start-btn\');\n    const submitBtn = document.getElementById(\'submit-btn\');\n    const nextBtn = document.getElementById(\'next-btn\');\n    const restartBtn = document.getElementById(\'restart-btn\');\n\n    // Event Listeners\n    startBtn.addEventListener(\'click\', startAssessment);\n    submitBtn.addEventListener(\'click\', submitAnswer);\n    nextBtn.addEventListener(\'click\', nextQuestion);\n    restartBtn.addEventListener(\'click\', restartAssessment);\n\n    function startAssessment() {\n      introScreen.classList.add(\'hidden\');\n      assessmentScreen.classList.remove(\'hidden\');\n      startTime = new Date();\n      loadQuestion();\n    }\n\n    function loadQuestion() {\n      // Reset state for new question\n      selectedAnswer = null;\n      isAnswerSubmitted = false;\n      submitBtn.disabled = true;\n      submitBtn.style.display = \'block\';\n      nextBtn.style.display = \'none\';\n      document.getElementById(\'feedback-container\').style.display = \'none\';\n\n      // Get current question\n      const currentQuestion = currentQuestions[currentQuestionIndex];\n\n      // Update UI with question data\n      document.getElementById(\'question-text\').textContent = currentQuestion.question;\n      document.getElementById(\'domain-badge\').textContent = currentQuestion.domain;\n      document.getElementById(\'points-badge\').textContent = `${currentQuestion.pointValue} points`;\n      \n      // Update difficulty display\n      updateDifficultyDisplay();\n      \n      // Update progress\n      const progressPercent = (answeredQuestions / MAX_QUESTIONS) * 100;\n      document.getElementById(\'progress-bar\').style.width = `${progressPercent}%`;\n      document.getElementById(\'progress-text\').textContent = `Question ${answeredQuestions + 1} of ${MAX_QUESTIONS}`;\n      document.getElementById(\'question-counter\').textContent = `${answeredQuestions + 1}/${MAX_QUESTIONS}`;\n      document.getElementById(\'points-earned\').textContent = `${pointsEarned} points earned`;\n\n      // Generate options\n      const optionsContainer = document.getElementById(\'options-container\');\n      optionsContainer.innerHTML = \'\';\n      \n      currentQuestion.options.forEach((option, index) => {\n        const optionElement = document.createElement(\'div\');\n        optionElement.className = \'option p-3 border rounded-lg cursor-pointer relative\';\n        optionElement.textContent = option;\n        \n        // Add event listener to select this option\n        optionElement.addEventListener(\'click\', () => {\n          if (isAnswerSubmitted) return;\n          \n          // Remove selected class from all options\n          document.querySelectorAll(\'.option\').forEach(opt => opt.classList.remove(\'selected\'));\n          \n          // Add selected class to this option\n          optionElement.classList.add(\'selected\');\n          \n          // Update selected answer\n          selectedAnswer = option;\n          \n          // Enable submit button\n          submitBtn.disabled = false;\n        });\n        \n        optionsContainer.appendChild(optionElement);\n      });\n    }\n\n    function updateDifficultyDisplay() {\n      const difficultyText = document.getElementById(\'difficulty-display\');\n      let labelText, bgColor;\n      \n      switch(currentDifficulty) {\n        case 1:\n          labelText = "Level 1: Foundational";\n          bgColor = "bg-blue-600";\n          break;\n        case 2:\n          labelText = "Level 2: Intermediate";\n          bgColor = "bg-indigo-600";\n          break;\n        case 3:\n          labelText = "Level 3: Advanced";\n          bgColor = "bg-purple-600";\n          break;\n      }\n      \n      difficultyText.textContent = labelText;\n      difficultyText.className = `${bgColor} px-3 py-1 rounded-full text-sm text-white`;\n    }\n\n    function submitAnswer() {\n      if (!selectedAnswer) return;\n      \n      isAnswerSubmitted = true;\n      \n      const currentQuestion = currentQuestions[currentQuestionIndex];\n      const isCorrect = selectedAnswer === currentQuestion.correctAnswer;\n      \n      // Update state\n      answeredQuestions++;\n      \n      // Track question result for history\n      questionHistory.push({\n        id: currentQuestion.id,\n        difficulty: currentQuestion.difficulty,\n        domain: currentQuestion.domain,\n        isCorrect: isCorrect,\n        pointValue: currentQuestion.pointValue\n      });\n      \n      if (isCorrect) {\n        correctAnswers++;\n        const pointsForThisQuestion = currentQuestion.pointValue;\n        pointsEarned += pointsForThisQuestion;\n        correctStreak++;\n        incorrectStreak = 0;\n        \n        // Update domain scores\n        if (!domainResults[currentQuestion.domain]) {\n          domainResults[currentQuestion.domain] = { \n            correct: 0, \n            total: 0,\n            points: 0\n          };\n        }\n        domainResults[currentQuestion.domain].correct++;\n        domainResults[currentQuestion.domain].points += pointsForThisQuestion;\n        \n        // Play success sound and animation\n        playSuccessSound();\n        triggerConfetti();\n        \n        // Show points animation\n        showPointsAnimation(pointsForThisQuestion);\n        \n        // Update points display immediately\n        document.getElementById(\'points-earned\').textContent = `${pointsEarned} points earned`;\n      } else {\n        incorrectStreak++;\n        correctStreak = 0;\n      }\n      \n      // Always increment total for the domain\n      if (!domainResults[currentQuestion.domain]) {\n        domainResults[currentQuestion.domain] = { \n          correct: 0, \n          total: 0,\n          points: 0\n        };\n      }\n      domainResults[currentQuestion.domain].total++;\n      \n      // Update UI\n      const feedbackContainer = document.getElementById(\'feedback-container\');\n      feedbackContainer.style.display = \'block\';\n      feedbackContainer.className = isCorrect ? \n        \'p-4 rounded-lg border border-green-200 bg-green-50 animate-fade-in\' : \n        \'p-4 rounded-lg border border-red-200 bg-red-50 animate-fade-in\';\n      \n      const feedbackHTML = `\n        <div class="flex items-start">\n          <div class="mr-3 text-2xl">${isCorrect ? \'✓\' : \'✗\'}</div>\n          <div>\n            <div class="${isCorrect ? \'text-green-600\' : \'text-red-600\'} font-bold text-lg mb-1">\n              ${isCorrect ? \'Correct!\' : \'Incorrect\'}\n            </div>\n            <div class="text-gray-700 mb-2">\n              <strong>Correct answer:</strong> ${currentQuestion.correctAnswer}\n            </div>\n            <div class="text-gray-600">\n              ${currentQuestion.explanation}\n            </div>\n          </div>\n        </div>\n      `;\n      \n      feedbackContainer.innerHTML = feedbackHTML;\n      \n      // Update difficulty level based on performance\n      adjustDifficulty();\n      \n      document.getElementById(\'points-earned\').textContent = `${pointsEarned} points earned`;\n      \n      submitBtn.style.display = \'none\';\n      nextBtn.style.display = \'block\';\n      \n      // Highlight correct answer\n      document.querySelectorAll(\'.option\').forEach(option => {\n        if (option.textContent === currentQuestion.correctAnswer) {\n          option.classList.add(\'correct-answer\');\n        } else if (option.classList.contains(\'selected\') && option.textContent !== currentQuestion.correctAnswer) {\n          option.classList.add(\'incorrect-answer\');\n        }\n      });\n    }\n    \n    function adjustDifficulty() {\n      // Get current difficulty before adjustment\n      const previousDifficulty = currentDifficulty;\n      \n      // If the user gets 2 questions correct in a row at their current level, increase difficulty\n      if (correctStreak >= 2 && currentDifficulty < 3) {\n        currentDifficulty++;\n        correctStreak = 0; // Reset streak after changing difficulty\n        \n        // Track highest difficulty reached\n        if (currentDifficulty > maxDifficultyReached) {\n          maxDifficultyReached = currentDifficulty;\n        }\n        \n        // Show difficulty increase notification\n        showDifficultyChangeNotification(true);\n        \n        // Get new questions for the higher difficulty\n        currentQuestions = getQuestionsForDifficulty(currentDifficulty);\n        currentQuestionIndex = 0; // Reset index for new difficulty level\n      }\n      \n      // If the user gets 2 questions wrong in a row, decrease difficulty\n      if (incorrectStreak >= 2 && currentDifficulty > 1) {\n        currentDifficulty--;\n        incorrectStreak = 0; // Reset streak after changing difficulty\n        \n        // Show difficulty decrease notification\n        showDifficultyChangeNotification(false);\n        \n        // Get new questions for the lower difficulty\n        currentQuestions = getQuestionsForDifficulty(currentDifficulty);\n        currentQuestionIndex = 0; // Reset index for new difficulty level\n      }\n      \n      // Add new difficulty to history if it changed\n      if (previousDifficulty !== currentDifficulty) {\n        difficultyHistory.push(currentDifficulty);\n      }\n    }\n    \n    function showDifficultyChangeNotification(isIncrease) {\n      const notification = document.createElement(\'div\');\n      notification.className = isIncrease ? \n        \'notification bg-green-100 border-l-4 border-green-500 text-green-700\' :\n        \'notification bg-amber-100 border-l-4 border-amber-500 text-amber-700\';\n      \n      const icon = document.createElement(\'span\');\n      icon.className = \'mr-2\';\n      icon.innerHTML = isIncrease ? \'⬆️\' : \'⬇️\';\n      \n      const message = document.createElement(\'span\');\n      message.innerHTML = isIncrease ? \n        \'<b>Difficulty increased!</b> Questions will be more challenging.\' :\n        \'<b>Difficulty adjusted.</b> Questions will be more accessible.\';\n      \n      notification.appendChild(icon);\n      notification.appendChild(message);\n      document.body.appendChild(notification);\n      \n      // Notification will be removed by the animation\n      setTimeout(() => {\n        document.body.removeChild(notification);\n      }, 3000);\n    }\n    \n    function nextQuestion() {\n      try {\n        // Clear feedback\n        document.getElementById(\'feedback-container\').style.display = \'none\';\n        \n        // Update points display immediately to ensure it\'s always current\n        document.getElementById(\'points-earned\').textContent = `${pointsEarned} points earned`;\n        \n        // Move to next question in current difficulty level\n        currentQuestionIndex++;\n        \n        // Check if we need new questions at the current difficulty level\n        if (currentQuestionIndex >= currentQuestions.length) {\n          // Reset index and get fresh questions at the current difficulty\n          currentQuestionIndex = 0;\n          currentQuestions = getQuestionsForDifficulty(currentDifficulty);\n        }\n        \n        // If we\'ve reached max questions, end assessment\n        if (answeredQuestions >= MAX_QUESTIONS) {\n          showResults();\n          return;\n        }\n        \n        // Otherwise, load the next question\n        loadQuestion();\n      } catch (error) {\n        // Error recovery - if something goes wrong, show a message and try to continue\n        console.error("Error in nextQuestion:", error);\n        alert("There was a problem loading the next question. The assessment will try to continue.");\n        \n        // Try to reset and continue\n        currentQuestionIndex = 0;\n        currentQuestions = getQuestionsForDifficulty(currentDifficulty);\n        loadQuestion();\n      }\n    }\n    \n    function showResults() {\n      const endTime = new Date();\n      const timeTaken = Math.floor((endTime - startTime) / 1000); // in seconds\n      \n      assessmentScreen.classList.add(\'hidden\');\n      resultsScreen.classList.remove(\'hidden\');\n      \n      // Calculate score as percentage\n      const score = Math.round((correctAnswers / answeredQuestions) * 100);\n      \n      // Update results UI\n      document.getElementById(\'final-score\').textContent = `Your Score: ${score}%`;\n      document.getElementById(\'final-points\').innerHTML = `You earned <span class="font-bold text-green-600">${pointsEarned} points</span>`;\n      document.getElementById(\'final-time\').textContent = `Time taken: ${Math.floor(timeTaken / 60)} minutes ${timeTaken % 60} seconds`;\n      \n      document.getElementById(\'total-questions\').textContent = answeredQuestions;\n      document.getElementById(\'correct-answers\').textContent = correctAnswers;\n      document.getElementById(\'highest-difficulty\').textContent = `${maxDifficultyReached}/3`;\n      document.getElementById(\'accuracy\').textContent = `${score}%`;\n      \n      // Create difficulty chart\n      createDifficultyChart();\n      \n      // Process domain results for strengths and weaknesses\n      const domainPerformance = [];\n      \n      for (const domain in domainResults) {\n        const result = domainResults[domain];\n        const percentage = Math.round((result.correct / result.total) * 100);\n        \n        domainPerformance.push({\n          domain,\n          percentage,\n          points: result.points,\n          correct: result.correct,\n          total: result.total\n        });\n      }\n      \n      // Sort domains by performance\n      domainPerformance.sort((a, b) => b.percentage - a.percentage);\n      \n      // Display strengths (top half of domains)\n      const strengthsContainer = document.getElementById(\'strengths-container\');\n      strengthsContainer.innerHTML = \'\';\n      \n      const numberOfDomains = Object.keys(domainResults).length;\n      const topDomains = domainPerformance.slice(0, Math.ceil(numberOfDomains / 2));\n      \n      if (topDomains.length > 0) {\n        topDomains.forEach(domain => {\n          const domainElement = document.createElement(\'div\');\n          domainElement.className = \'flex justify-between items-center\';\n          domainElement.innerHTML = `\n            <div>\n              <span class="font-medium">${domain.domain}</span>\n              <span class="text-gray-500 text-xs ml-1">(${domain.correct}/${domain.total})</span>\n            </div>\n            <span class="text-green-600 font-bold">${domain.percentage}%</span>\n          `;\n          strengthsContainer.appendChild(domainElement);\n        });\n      } else {\n        strengthsContainer.innerHTML = \'<p class="text-slate-500 italic">Keep practicing to discover your strengths</p>\';\n      }\n      \n      // Display weaknesses (bottom half of domains)\n      const weaknessesContainer = document.getElementById(\'weaknesses-container\');\n      weaknessesContainer.innerHTML = \'\';\n      \n      const bottomDomains = domainPerformance.slice(Math.ceil(numberOfDomains / 2));\n      \n      if (bottomDomains.length > 0) {\n        bottomDomains.forEach(domain => {\n          const domainElement = document.createElement(\'div\');\n          domainElement.className = \'flex justify-between items-center\';\n          domainElement.innerHTML = `\n            <div>\n              <span class="font-medium">${domain.domain}</span>\n              <span class="text-gray-500 text-xs ml-1">(${domain.correct}/${domain.total})</span>\n            </div>\n            <span class="text-amber-600 font-bold">${domain.percentage}%</span>\n          `;\n          weaknessesContainer.appendChild(domainElement);\n        });\n      } else {\n        weaknessesContainer.innerHTML = \'<p class="text-slate-500 italic">Great work! Focus on maintaining your knowledge</p>\';\n      }\n      \n      // Generate personalized recommendations\n      generateRecommendations(bottomDomains);\n      \n      // Trigger a celebratory confetti explosion\n      confetti({\n        particleCount: 100,\n        spread: 70,\n        origin: { y: 0.6 }\n      });\n    }\n    \n    function createDifficultyChart() {\n      const chartContainer = document.getElementById(\'difficulty-chart\');\n      chartContainer.innerHTML = \'\';\n      \n      // Create bars for each question answered\n      questionHistory.forEach((question, index) => {\n        const bar = document.createElement(\'div\');\n        \n        // Set height based on difficulty (1=33%, 2=66%, 3=100%)\n        const heightPercent = (question.difficulty / 3) * 100;\n        \n        // Set colors based on difficulty and correctness\n        let bgColor;\n        if (question.isCorrect) {\n          bgColor = question.difficulty === 1 ? \'bg-blue-400\' : \n                   question.difficulty === 2 ? \'bg-indigo-400\' : \'bg-purple-400\';\n        } else {\n          bgColor = question.difficulty === 1 ? \'bg-blue-200\' : \n                   question.difficulty === 2 ? \'bg-indigo-200\' : \'bg-purple-200\';\n        }\n        \n        bar.className = `flex-1 ${bgColor} mx-0.5 relative`;\n        bar.style.height = `${heightPercent}%`;\n        \n        // Add tooltip with question info\n        bar.title = `Q${index+1}: ${question.domain} (Level ${question.difficulty}) - ${question.isCorrect ? \'Correct\' : \'Incorrect\'}`;\n        \n        // Display difficulty level at the top of the bar for the first question of each level\n        if (index === 0 || questionHistory[index-1].difficulty !== question.difficulty) {\n          const label = document.createElement(\'div\');\n          label.className = \'absolute -top-5 left-0 text-xs font-bold\';\n          label.textContent = `L${question.difficulty}`;\n          bar.appendChild(label);\n        }\n        \n        chartContainer.appendChild(bar);\n      });\n    }\n    \n    function generateRecommendations(weakDomains) {\n      const recommendationsContainer = document.getElementById(\'recommendations-container\');\n      recommendationsContainer.innerHTML = \'\';\n      \n      // Create recommendations based on weakest domains\n      if (weakDomains.length > 0) {\n        weakDomains.forEach(domain => {\n          const recommendationElement = document.createElement(\'div\');\n          recommendationElement.className = \'bg-white rounded-md p-3 border border-indigo-100 flex items-start\';\n          \n          // Generate specific recommendations based on domain\n          let recommendations;\n          switch(domain.domain) {\n            case \'Child Development\':\n              recommendations = "Review child development milestones and theories. Consider exploring resources on cognitive, social, and physical development stages.";\n              break;\n            case \'Classroom Management\':\n              recommendations = "Focus on positive guidance techniques and creating consistent routines. Explore strategies for managing challenging behaviors.";\n              break;\n            case \'Assessment\':\n              recommendations = "Learn more about authentic assessment methods and documentation strategies that capture children\'s natural learning.";\n              break;\n            case \'Social-Emotional Development\':\n              recommendations = "Explore resources on supporting emotional regulation, building secure attachments, and fostering social skills.";\n              break;\n            case \'Brain Development\':\n              recommendations = "Review resources on early brain architecture, executive function development, and the impact of experiences on neural connections.";\n              break;\n            case \'Program Quality\':\n              recommendations = "Study quality standards like ECERS-R and learn strategies for creating rich, developmentally appropriate environments.";\n              break;\n            case \'Trauma and Resilience\':\n              recommendations = "Deepen your understanding of ACEs, trauma-informed practices, and strategies for building resilience in young children.";\n              break;\n            case \'Language Development\':\n              recommendations = "Focus on effective language modeling, book reading strategies, and creating language-rich environments.";\n              break;\n            case \'Guidance and Behavior\':\n              recommendations = "Explore positive guidance techniques, understanding the meaning behind behaviors, and supportive intervention strategies.";\n              break;\n            case \'Cognitive Development\':\n              recommendations = "Learn more about how children construct knowledge through experiences and how to support higher-order thinking skills.";\n              break;\n            case \'Learning Environment\':\n              recommendations = "Study principles of effective classroom design, materials selection, and creating engaging learning centers.";\n              break;\n            default:\n              recommendations = `Review current research and best practices related to ${domain.domain.toLowerCase()}.`;\n          }\n          \n          recommendationElement.innerHTML = `\n            <div class="mr-3 text-indigo-500 text-lg">📚</div>\n            <div>\n              <div class="font-medium text-indigo-700 mb-1">${domain.domain}</div>\n              <p class="text-sm text-gray-600">${recommendations}</p>\n            </div>\n          `;\n          \n          recommendationsContainer.appendChild(recommendationElement);\n        });\n      } else {\n        recommendationsContainer.innerHTML = `\n          <div class="bg-white rounded-md p-3 border border-indigo-100">\n            <p class="text-indigo-700 font-medium">Excellent work! You demonstrated strong knowledge across all domains.</p>\n            <p class="text-sm text-gray-600 mt-1">Continue building your expertise by exploring advanced topics in early childhood education.</p>\n          </div>\n        `;\n      }\n    }\n    \n    function restartAssessment() {\n      // Reset all state\n      currentDifficulty = 1;\n      currentQuestions = getQuestionsForDifficulty(currentDifficulty);\n      currentQuestionIndex = 0;\n      selectedAnswer = null;\n      isAnswerSubmitted = false;\n      correctAnswers = 0;\n      answeredQuestions = 0;\n      pointsEarned = 0;\n      correctStreak = 0;\n      incorrectStreak = 0;\n      maxDifficultyReached = 1;\n      domainResults = {};\n      difficultyHistory = [1];\n      questionHistory = [];\n      \n      // Reset UI\n      resultsScreen.classList.add(\'hidden\');\n      introScreen.classList.remove(\'hidden\');\n      \n      // Shuffle questions\n      level1Questions = shuffleArray(level1Questions);\n      level2Questions = shuffleArray(level2Questions);\n      level3Questions = shuffleArray(level3Questions);\n    }\n    \n    function playSuccessSound() {\n      const audio = new Audio(\'data:audio/mp3;base64,\');\n      audio.volume = 0.5;\n      audio.play();\n    }\n    \n    function triggerConfetti() {\n      const colors = [\'#22c55e\', \'#10b981\', \'#059669\'];\n      \n      confetti({\n        particleCount: 30,\n        angle: 60,\n        spread: 55,\n        origin: { x: 0.1, y: 0.7 },\n        colors: colors\n      });\n      \n      confetti({\n        particleCount: 30,\n        angle: 120,\n        spread: 55,\n        origin: { x: 0.9, y: 0.7 },\n        colors: colors\n      });\n    }\n    // Function to show points animation\n    function showPointsAnimation(points) {\n      const pointsPopup = document.createElement(\'div\');\n      pointsPopup.className = \'fixed z-50 animate-pop\';\n      pointsPopup.style.left = \'50%\';\n      pointsPopup.style.top = \'50%\';\n      pointsPopup.style.transform = \'translate(-50%, -50%)\';\n      pointsPopup.style.pointerEvents = \'none\';\n      \n      // Different colors based on point value\n      let color, size;\n      if (points === 5) {\n        color = \'text-blue-500\';\n        size = \'text-4xl\';\n      } else if (points === 10) {\n        color = \'text-indigo-500\';\n        size = \'text-5xl\';\n      } else {\n        color = \'text-purple-500\';\n        size = \'text-6xl\';\n      }\n      \n      pointsPopup.innerHTML = `<div class="font-bold ${color} ${size} drop-shadow-lg">+${points} points!</div>`;\n      document.body.appendChild(pointsPopup);\n      \n      // Animate up and fade out\n      let top = 50;\n      let opacity = 1;\n      const anim = setInterval(() => {\n        top -= 1;\n        opacity -= 0.03;\n        pointsPopup.style.top = `${top}%`;\n        pointsPopup.style.opacity = opacity;\n        \n        if (opacity <= 0) {\n          clearInterval(anim);\n          document.body.removeChild(pointsPopup);\n        }\n      }, 30);\n    }\n    \n    // Emergency save mechanism - save progress to localStorage\n    function saveProgress() {\n      try {\n        const progressData = {\n          answeredQuestions,\n          correctAnswers,\n          pointsEarned,\n          currentDifficulty,\n          maxDifficultyReached,\n          domainResults,\n          questionHistory,\n          timestamp: new Date().getTime()\n        };\n        \n        localStorage.setItem(\'eceAssessmentProgress\', JSON.stringify(progressData));\n      } catch (e) {\n        console.error("Failed to save progress:", e);\n      }\n    }\n    \n    // Save progress after each answer\n    document.addEventListener(\'visibilitychange\', () => {\n      if (document.visibilityState === \'hidden\' && answeredQuestions > 0) {\n        saveProgress();\n      }\n    });\n    \n    // Also save progress periodically\n    setInterval(saveProgress, 30000);\n  </script>\n', PosixPath('backup/cleanup-phase1/dynamic-ece-assessment.html'), 'config..semgrep.vendored-rules.html.security.audit.insecure-document-method') match_id = eaa089454b1e8fd0ccd9245c2f24b9a9921e606a51ab687b433843ef29cb0d0ace13da08a7f19d29d6a892e75ce298e62856f698e026b15951dd7d609e7e1d6e_0
