;\n      \n      const accuracy = totalCorrect / totalQuestionsTaken * 100;\n      \n      // Generate feedback based on score\n      let feedback;\n      if (points >= 100) {\n        feedback = `Excellent work! You scored ${points} points with ${accuracy.toFixed(0)}% accuracy. You have a strong understanding of early childhood education principles.`;\n      } else if (points >= 70) {\n        feedback = `Good job! You scored ${points} points with ${accuracy.toFixed(0)}% accuracy. You have a solid foundation in early childhood education with some areas to strengthen.`;\n      } else {\n        feedback = `You\'ve taken an important first step and scored ${points} points with ${accuracy.toFixed(0)}% accuracy. Keep exploring these concepts to build your knowledge.`;\n      }\n      \n      finalFeedback.textContent = feedback;\n      \n      // Generate domain analysis\n      domainAnalysis.innerHTML = \'<h3>Domain Analysis</h3>\';\n      \n      // Sort domains by performance (percentage correct)\n      const sortedDomains = Object.entries(domainScores)\n        .map(([domain, stats]) => ({ \n          domain, \n          percentage: (stats.correct / stats.total) * 100,\n          points: stats.points,\n          correct: stats.correct,\n          total: stats.total\n        }))\n        .sort((a, b) => b.percentage - a.percentage);\n      \n      // Display strengths\n      const strengthsDiv = document.createElement(\'div\');\n      strengthsDiv.innerHTML = \'<h4 style="color: #059669;">Strengths</h4>\';\n      \n      const strengths = sortedDomains.filter(d => d.percentage >= 70);\n      if (strengths.length > 0) {\n        const strengthsList = document.createElement(\'ul\');\n        strengths.forEach(domain => {\n          const li = document.createElement(\'li\');\n          li.textContent = `${domain.domain}: ${domain.correct}/${domain.total} correct (${domain.percentage.toFixed(0)}%)`;\n          strengthsList.appendChild(li);\n        });\n        strengthsDiv.appendChild(strengthsList);\n      } else {\n        strengthsDiv.innerHTML += \'<p>Keep practicing to develop your strengths.</p>\';\n      }\n      \n      // Display growth areas\n      const growthDiv = document.createElement(\'div\');\n      growthDiv.innerHTML = \'<h4 style="color: #d97706;">Growth Areas</h4>\';\n      \n      const growthAreas = sortedDomains.filter(d => d.percentage < 70);\n      if (growthAreas.length > 0) {\n        const growthList = document.createElement(\'ul\');\n        growthAreas.forEach(domain => {\n          const li = document.createElement(\'li\');\n          li.textContent = `${domain.domain}: ${domain.correct}/${domain.total} correct (${domain.percentage.toFixed(0)}%)`;\n          growthList.appendChild(li);\n        });\n        growthDiv.appendChild(growthList);\n      } else {\n        growthDiv.innerHTML += \'<p>Great job! You did well across all domains.</p>\';\n      }\n      \n      domainAnalysis.appendChild(strengthsDiv);\n      domainAnalysis.appendChild(growthDiv);\n    }\n\n    // Event listeners\n    submitBtn.addEventListener(\'click\', submitAnswer);\n    nextBtn.addEventListener(\'click\', nextQuestion);\n    restartBtn.addEventListener(\'click\', initQuiz);\n\n    // Start the quiz\n    initQuiz();\n  </script>\n', PosixPath('public/standalone-ece-quiz.html'), 'config..semgrep.vendored-rules.html.security.audit.insecure-document-method') match_id = 6a9f988459f3ffbda603b5de946d6b11ce8edb5a2fe9d17152ddacb0b7609d7823f017e44b93e50a7e717d404cc12911c6ec39a5ad3f14750429aab0eb340343_0
