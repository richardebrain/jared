2025-07-06 02:31:06,000 - semgrep.rule_match - DEBUG - match_key = ('\n        // Assessment data\n        const allQuestions = [\n            {\n                id: 1,\n                text: "Which of the following best describes the zone of proximal development?",\n                domain: "Child Development Theories",\n                options: [\n                    "The area where a child can complete tasks independently",\n                    "The difference between what a child can do with help and what they can do independently",\n                    "The stage where children develop fine motor skills",\n                    "The period when children learn to socialize with peers"\n                ],\n                correctAnswer: 1,\n                explanation: "The zone of proximal development (ZPD) is the difference between what a learner can do without help and what they can achieve with guidance from a more knowledgeable person."\n            },\n            {\n                id: 2,\n                text: "Which approach emphasizes the importance of child-directed play and exploration?",\n                domain: "Curriculum Approaches",\n                options: [\n                    "Direct instruction",\n                    "Reggio Emilia",\n                    "Academic-focused curriculum",\n                    "Teacher-centered learning"\n                ],\n                correctAnswer: 1,\n                explanation: "The Reggio Emilia approach views children as capable, curious individuals and emphasizes child-directed exploration and discovery."\n            },\n            {\n                id: 3,\n                text: "What is the primary purpose of formative assessment in early childhood education?",\n                domain: "Assessment Methods",\n                options: [\n                    "To assign grades to children",\n                    "To compare children\'s abilities",\n                    "To inform ongoing teaching and learning",\n                    "To determine readiness for elementary school"\n                ],\n                correctAnswer: 2,\n                explanation: "Formative assessment is used to monitor student learning and provide ongoing feedback to improve teaching and learning processes."\n            },\n            {\n                id: 4,\n                text: "Which of the following is NOT typically considered one of the CLASS (Classroom Assessment Scoring System) domains?",\n                domain: "Quality Measurement",\n                options: [\n                    "Emotional Support",\n                    "Classroom Organization",\n                    "Instructional Support",\n                    "Physical Environment"\n                ],\n                correctAnswer: 3,\n                explanation: "The CLASS assessment tool has three main domains: Emotional Support, Classroom Organization, and Instructional Support. Physical Environment is not a CLASS domain."\n            },\n            {\n                id: 5,\n                text: "What is the recommended adult-to-child ratio for 3-year-olds according to NAEYC accreditation standards?",\n                domain: "Health & Safety",\n                options: [\n                    "1:15",\n                    "1:10",\n                    "1:8",\n                    "1:6"\n                ],\n                correctAnswer: 2,\n                explanation: "NAEYC recommends a ratio of 1 adult for every 8 three-year-olds with a maximum group size of 16."\n            },\n            {\n                id: 6,\n                text: "Which of the following is a key component of developmentally appropriate practice (DAP)?",\n                domain: "Developmentally Appropriate Practice",\n                options: [\n                    "Using the same approach for all children regardless of development",\n                    "Making decisions based on what children of a certain age should be able to do",\n                    "Considering the needs and capabilities of each individual child",\n                    "Following a strict curriculum regardless of children\'s interests"\n                ],\n                correctAnswer: 2,\n                explanation: "DAP requires teachers to meet children where they are, considering each child\'s age, experience, abilities, and interests."\n            },\n            {\n                id: 7,\n                text: "Which of these is an example of scaffolding in early childhood education?",\n                domain: "Teaching Strategies",\n                options: [\n                    "Giving a child a complex task and expecting them to figure it out independently",\n                    "Providing hints and supports to help a child complete a task they couldn\'t do alone",\n                    "Completing difficult tasks for children to demonstrate proper techniques",\n                    "Letting children only do activities they have already mastered"\n                ],\n                correctAnswer: 1,\n                explanation: "Scaffolding involves providing temporary support to help children master new skills, gradually removing the support as competence increases."\n            },\n            {\n                id: 8,\n                text: "What is the appropriate way to handle a situation where a child hits another child?",\n                domain: "Guidance & Behavior Management",\n                options: [\n                    "Ignore the behavior to avoid giving negative attention",\n                    "Immediately put the child in time-out without discussion",\n                    "Calmly stop the behavior, acknowledge feelings, and teach appropriate alternatives",\n                    "Ask the hit child to hit back so they learn a lesson"\n                ],\n                correctAnswer: 2,\n                explanation: "Effective guidance involves setting clear limits, acknowledging feelings, and teaching children alternative ways to express emotions."\n            },\n            {\n                id: 9,\n                text: "Which of the following would be considered an open-ended question?",\n                domain: "Communication & Language",\n                options: [\n                    "Did you like the story?",\n                    "Can you count to 10?",\n                    "What do you think will happen next in the story?",\n                    "Is this a triangle?"\n                ],\n                correctAnswer: 2,\n                explanation: "Open-ended questions cannot be answered with a simple \'yes\' or \'no\' and encourage children to think critically and express their thoughts."\n            },\n            {\n                id: 10,\n                text: "According to Piaget, in which stage do children develop object permanence?",\n                domain: "Child Development Theories",\n                options: [\n                    "Sensorimotor stage",\n                    "Preoperational stage",\n                    "Concrete operational stage",\n                    "Formal operational stage"\n                ],\n                correctAnswer: 0,\n                explanation: "Object permanence typically develops during the sensorimotor stage (birth to 2 years), when children begin to understand that objects continue to exist even when they cannot be seen."\n            },\n            {\n                id: 11,\n                text: "Which of the following practices best supports emergent literacy?",\n                domain: "Literacy Development",\n                options: [\n                    "Daily handwriting worksheets",\n                    "Flashcards with sight words",\n                    "Reading aloud and engaging children in conversations about stories",\n                    "Teaching the alphabet through rote memorization"\n                ],\n                correctAnswer: 2,\n                explanation: "Emergent literacy is best supported through meaningful interactions with text, including reading aloud, discussing stories, and incorporating literacy into play."\n            },\n            {\n                id: 12,\n                text: "What is the most effective way to engage families in children\'s learning?",\n                domain: "Family Engagement",\n                options: [\n                    "Sending home weekly newsletters about classroom activities",\n                    "Creating opportunities for families to share their expertise and culture in the classroom",\n                    "Having formal parent-teacher conferences twice a year",\n                    "Requiring parents to complete homework assignments with their children"\n                ],\n                correctAnswer: 1,\n                explanation: "Effective family engagement involves creating meaningful partnerships where families\' knowledge and cultures are valued and incorporated into the learning environment."\n            },\n            {\n                id: 13,\n                text: "Which of the following is the best example of an inclusive practice in early childhood education?",\n                domain: "Inclusion & Diversity",\n                options: [\n                    "Grouping children by ability for all activities",\n                    "Adapting materials and strategies to ensure all children can participate",\n                    "Providing separate activities for children with special needs",\n                    "Focusing equally on all cultural holidays throughout the year"\n                ],\n                correctAnswer: 1,\n                explanation: "Inclusive practices involve making adaptations and providing support so that all children can participate meaningfully in the same activities and routines."\n            },\n            {\n                id: 14,\n                text: "Which mathematical concept typically develops first in young children?",\n                domain: "Cognitive Development",\n                options: [\n                    "Multiplication",\n                    "One-to-one correspondence",\n                    "Fractions",\n                    "Algebraic thinking"\n                ],\n                correctAnswer: 1,\n                explanation: "One-to-one correspondence (matching one object to one object or person) is a foundational mathematical concept that typically develops in early childhood."\n            },\n            {\n                id: 15,\n                text: "Which of these is the most appropriate way to support a dual language learner in the classroom?",\n                domain: "Language Development",\n                options: [\n                    "Discourage the use of their home language to accelerate English acquisition",\n                    "Separate them from English-speaking peers to provide specialized instruction",\n                    "Provide visual supports and incorporate words from their home language",\n                    "Speak slowly and loudly to ensure comprehension"\n                ],\n                correctAnswer: 2,\n                explanation: "Supporting dual language learners involves valuing their home language, providing visual cues, and creating a language-rich environment that incorporates elements of their home language."\n            },\n            {\n                id: 16,\n                text: "Which of the following best describes the purpose of learning centers in a preschool classroom?",\n                domain: "Learning Environment",\n                options: [\n                    "To keep children busy while the teacher works with small groups",\n                    "To provide opportunities for choice, exploration, and discovery",\n                    "To prepare children for the structure of elementary school",\n                    "To assess children\'s ability to follow directions"\n                ],\n                correctAnswer: 1,\n                explanation: "Learning centers are designed to promote active engagement, choice, peer interaction, and exploration across different developmental domains."\n            },\n            {\n                id: 17,\n                text: "What is the primary purpose of documentation in Reggio Emilia-inspired programs?",\n                domain: "Observation & Assessment",\n                options: [\n                    "To evaluate children\'s academic progress",\n                    "To create portfolios to share with parents",\n                    "To make children\'s thinking and learning visible",\n                    "To fulfill licensing requirements"\n                ],\n                correctAnswer: 2,\n                explanation: "In Reggio Emilia, documentation serves to make children\'s thoughts, theories, and learning processes visible, helping teachers and children reflect on and extend learning."\n            },\n            {\n                id: 18,\n                text: "Which of the following is NOT considered a protective factor in building children\'s resilience?",\n                domain: "Social-Emotional Development",\n                options: [\n                    "Secure attachment relationships",\n                    "Self-regulation skills",\n                    "Problem-solving abilities",\n                    "Highly structured adult-directed activities"\n                ],\n                correctAnswer: 3,\n                explanation: "Protective factors that build resilience include supportive relationships, self-regulation, problem-solving skills, and opportunities for children to develop a sense of mastery through appropriate challenges."\n            },\n            {\n                id: 19,\n                text: "According to early childhood education best practices, what is the recommended daily minimum amount of time for outdoor play?",\n                domain: "Physical Development",\n                options: [\n                    "15 minutes",\n                    "30 minutes",\n                    "60 minutes",\n                    "90 minutes"\n                ],\n                correctAnswer: 2,\n                explanation: "Best practice guidelines suggest a minimum of 60 minutes of outdoor play daily for young children, weather permitting, to support physical development and overall well-being."\n            },\n            {\n                id: 20,\n                text: "Which of the following best describes appropriate technology use in early childhood settings?",\n                domain: "Technology Integration",\n                options: [\n                    "Children should have unlimited access to technology throughout the day",\n                    "Technology should be avoided entirely until age 7",\n                    "Technology should supplement, not replace, hands-on experiences and face-to-face interactions",\n                    "Children should use technology primarily for entertainment purposes"\n                ],\n                correctAnswer: 2,\n                explanation: "Developmentally appropriate technology use includes intentional selection of digital tools that enhance learning, used with adult guidance and in balance with other activities."\n            },\n            {\n                id: 21,\n                text: "Which is the best example of an authentic assessment approach?",\n                domain: "Assessment Methods",\n                options: [\n                    "Weekly spelling tests",\n                    "Standardized readiness tests",\n                    "Documentation of children\'s work and play over time",\n                    "Comparing all children to age-based milestones"\n                ],\n                correctAnswer: 2,\n                explanation: "Authentic assessment involves documenting children\'s actual work, play, and interactions in natural settings over time to understand their development and learning."\n            },\n            {\n                id: 22,\n                text: "How does the concept of \'funds of knowledge\' relate to working with diverse families?",\n                domain: "Family & Community Engagement",\n                options: [\n                    "It refers to the financial resources families can contribute to the program",\n                    "It recognizes the knowledge, skills and cultural practices of families as valuable resources",\n                    "It describes the educational background of family members",\n                    "It tracks how much information families retain from parent workshops"\n                ],\n                correctAnswer: 1,\n                explanation: "The \'funds of knowledge\' approach recognizes that families possess valuable knowledge, skills, and cultural practices that should be incorporated into and respected within educational settings."\n            },\n            {\n                id: 23,\n                text: "What is the primary purpose of project-based learning in early childhood?",\n                domain: "Curriculum Approaches",\n                options: [\n                    "To teach specific academic content in an organized sequence",\n                    "To prepare children for standardized testing",\n                    "To engage children in in-depth investigation of topics of interest",\n                    "To complete products for display in the classroom"\n                ],\n                correctAnswer: 2,\n                explanation: "Project-based learning engages children in extended, in-depth investigations of topics of interest, promoting deep learning, collaboration, and development across domains."\n            },\n            {\n                id: 24,\n                text: "Which of the following statements about executive function skills is TRUE?",\n                domain: "Cognitive Development",\n                options: [\n                    "They develop naturally and cannot be influenced by the environment",\n                    "They include working memory, inhibitory control, and cognitive flexibility",\n                    "They are fully developed by age 3",\n                    "They are only important for academic learning, not social skills"\n                ],\n                correctAnswer: 1,\n                explanation: "Executive function skills include working memory, inhibitory control, and cognitive flexibility, and they develop gradually throughout childhood with appropriate support and experiences."\n            },\n            {\n                id: 25,\n                text: "What is the most appropriate way to support socio-dramatic play in a preschool classroom?",\n                domain: "Play & Learning",\n                options: [\n                    "Assign roles to ensure all children participate equally",\n                    "Provide open-ended materials and appropriate time and space",\n                    "Require a specific theme to ensure educational content",\n                    "Have adults direct the play to maintain order"\n                ],\n                correctAnswer: 1,\n                explanation: "Supporting socio-dramatic play involves providing open-ended materials, sufficient time and space, and appropriate adult scaffolding without taking over or directing the play."\n            }\n        ];\n\n        let assessmentType = \'basic\';\n        let currentQuestions = [];\n        let currentQuestionIndex = 0;\n        let userAnswers = [];\n        let startTime = null;\n        let timerInterval = null;\n\n        // Set assessment type\n        function setAssessmentType(type) {\n            assessmentType = type;\n            const basicOption = document.querySelector(\'div[onclick="setAssessmentType(\\\'basic\\\')"]\');\n            const comprehensiveOption = document.querySelector(\'div[onclick="setAssessmentType(\\\'comprehensive\\\')"]\');\n            \n            basicOption.classList.remove(\'border-indigo-500\', \'bg-indigo-50\');\n            comprehensiveOption.classList.remove(\'border-indigo-500\', \'bg-indigo-50\');\n            \n            if (type === \'basic\') {\n                basicOption.classList.add(\'border-indigo-500\', \'bg-indigo-50\');\n            } else {\n                comprehensiveOption.classList.add(\'border-indigo-500\', \'bg-indigo-50\');\n            }\n        }\n\n        // Start the assessment\n        function startAssessment() {\n            // Get user info\n            const userName = document.getElementById(\'name\').value;\n            const userEmail = document.getElementById(\'email\').value;\n            \n            // Select questions based on assessment type\n            if (assessmentType === \'basic\') {\n                currentQuestions = allQuestions.slice(0, 15);\n                document.getElementById(\'total-questions\').textContent = \'15\';\n            } else {\n                currentQuestions = allQuestions;\n                document.getElementById(\'total-questions\').textContent = \'25\';\n            }\n            \n            // Initialize user answers array\n            userAnswers = Array(currentQuestions.length).fill(null);\n            \n            // Show the assessment screen\n            document.getElementById(\'setup-screen\').classList.add(\'hidden\');\n            document.getElementById(\'assessment-screen\').classList.remove(\'hidden\');\n            \n            // Display the first question\n            currentQuestionIndex = 0;\n            displayQuestion(currentQuestionIndex);\n            \n            // Start the timer\n            startTime = new Date();\n            timerInterval = setInterval(updateTimer, 1000);\n        }\n\n        // Display a question\n        function displayQuestion(index) {\n            const question = currentQuestions[index];\n            document.getElementById(\'current-question\').textContent = index + 1;\n            document.getElementById(\'question-text\').textContent = question.text;\n            document.getElementById(\'question-domain\').textContent = `Domain: ${question.domain}`;\n            \n            // Update progress bar\n            const progressPercentage = ((index + 1) / currentQuestions.length) * 100;\n            document.getElementById(\'progress-value\').style.width = `${progressPercentage}%`;\n            \n            // Generate options\n            const optionsContainer = document.getElementById(\'options-container\');\n            optionsContainer.innerHTML = \'\';\n            \n            question.options.forEach((option, optionIndex) => {\n                const optionCard = document.createElement(\'div\');\n                optionCard.className = \'option-card p-4\';\n                optionCard.setAttribute(\'data-index\', optionIndex);\n                \n                // If user has already answered this question\n                if (userAnswers[index] !== null) {\n                    if (userAnswers[index] === optionIndex) {\n                        optionCard.classList.add(\'selected\');\n                        if (optionIndex === question.correctAnswer) {\n                            optionCard.classList.add(\'correct\');\n                        } else {\n                            optionCard.classList.add(\'incorrect\');\n                        }\n                    } else if (optionIndex === question.correctAnswer) {\n                        optionCard.classList.add(\'correct\');\n                    }\n                    optionCard.style.pointerEvents = \'none\';\n                } else {\n                    optionCard.addEventListener(\'click\', () => selectOption(optionIndex));\n                }\n                \n                optionCard.innerHTML = `\n                    <div class="flex items-start">\n                        <div class="flex-shrink-0 w-6 h-6 bg-gray-200 rounded-full flex items-center justify-center text-sm mr-3">\n                            ${String.fromCharCode(65 + optionIndex)}\n                        </div>\n                        <span>${option}</span>\n                    </div>\n                `;\n                optionsContainer.appendChild(optionCard);\n            });\n            \n            // Hide feedback container\n            document.getElementById(\'feedback-container\').classList.add(\'hidden\');\n            \n            // Update navigation buttons\n            document.getElementById(\'prev-btn\').disabled = index === 0;\n            document.getElementById(\'next-btn\').disabled = userAnswers[index] === null;\n            \n            if (index === currentQuestions.length - 1 && userAnswers[index] !== null) {\n                document.getElementById(\'next-btn\').textContent = \'Finish\';\n            } else {\n                document.getElementById(\'next-btn\').textContent = \'Next\';\n            }\n        }\n\n        // Select an option\n        function selectOption(optionIndex) {\n            const question = currentQuestions[currentQuestionIndex];\n            userAnswers[currentQuestionIndex] = optionIndex;\n            \n            // Update options UI\n            const options = document.querySelectorAll(\'.option-card\');\n            options.forEach((option, index) => {\n                option.classList.remove(\'selected\', \'correct\', \'incorrect\');\n                option.style.pointerEvents = \'none\';\n                \n                if (index === optionIndex) {\n                    option.classList.add(\'selected\');\n                    if (index === question.correctAnswer) {\n                        option.classList.add(\'correct\');\n                    } else {\n                        option.classList.add(\'incorrect\');\n                    }\n                } else if (index === question.correctAnswer) {\n                    option.classList.add(\'correct\');\n                }\n            });\n            \n            // Show feedback\n            const feedbackContainer = document.getElementById(\'feedback-container\');\n            feedbackContainer.innerHTML = \'\';\n            \n            if (optionIndex === question.correctAnswer) {\n                feedbackContainer.classList.add(\'feedback-correct\');\n                feedbackContainer.classList.remove(\'feedback-incorrect\');\n                feedbackContainer.innerHTML = `\n                    <div class="flex items-start">\n                        <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">\n                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>\n                        </svg>\n                        <div>\n                            <p class="font-semibold text-green-700">Correct!</p>\n                            <p class="text-sm text-gray-600 mt-1">${question.explanation}</p>\n                        </div>\n                    </div>\n                `;\n            } else {\n                feedbackContainer.classList.add(\'feedback-incorrect\');\n                feedbackContainer.classList.remove(\'feedback-correct\');\n                feedbackContainer.innerHTML = `\n                    <div class="flex items-start">\n                        <svg class="w-5 h-5 text-red-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">\n                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>\n                        </svg>\n                        <div>\n                            <p class="font-semibold text-red-700">Incorrect</p>\n                            <p class="text-sm text-gray-600 mt-1">The correct answer is: ${question.options[question.correctAnswer]}</p>\n                            <p class="text-sm text-gray-600 mt-1">${question.explanation}</p>\n                        </div>\n                    </div>\n                `;\n            }\n            feedbackContainer.classList.remove(\'hidden\');\n            \n            // Enable next button\n            document.getElementById(\'next-btn\').disabled = false;\n            \n            // If this is the last question and it\'s answered, show "Finish" on the button\n            if (currentQuestionIndex === currentQuestions.length - 1) {\n                document.getElementById(\'next-btn\').textContent = \'Finish\';\n            }\n        }\n\n        // Navigate to previous or next question\n        function navigateQuestion(direction) {\n            if (direction === 1 && currentQuestionIndex === currentQuestions.length - 1) {\n                // This is the last question, finish the assessment\n                finishAssessment();\n                return;\n            }\n            \n            currentQuestionIndex += direction;\n            displayQuestion(currentQuestionIndex);\n        }\n\n        // Update the timer\n        function updateTimer() {\n            if (!startTime) return;\n            \n            const now = new Date();\n            const elapsedMilliseconds = now - startTime;\n            const elapsedSeconds = Math.floor(elapsedMilliseconds / 1000);\n            const minutes = Math.floor(elapsedSeconds / 60);\n            const seconds = elapsedSeconds % 60;\n            \n            document.getElementById(\'timer\').textContent = `${minutes.toString().padStart(2, \'0\')}:${seconds.toString().padStart(2, \'0\')}`;\n        }\n\n        // Finish the assessment\n        function finishAssessment() {\n            // Stop the timer\n            clearInterval(timerInterval);\n            const endTime = new Date();\n            const totalTimeInSeconds = Math.floor((endTime - startTime) / 1000);\n            const minutes = Math.floor(totalTimeInSeconds / 60);\n            const seconds = totalTimeInSeconds % 60;\n            const timeString = `${minutes.toString().padStart(2, \'0\')}:${seconds.toString().padStart(2, \'0\')}`;\n            \n            // Calculate score\n            let correctCount = 0;\n            userAnswers.forEach((answer, index) => {\n                if (answer === currentQuestions[index].correctAnswer) {\n                    correctCount++;\n                }\n            });\n            \n            const scorePercentage = Math.round((correctCount / currentQuestions.length) * 100);\n            \n            // Calculate domain performance\n            const domainPerformance = {};\n            currentQuestions.forEach((question, index) => {\n                const domain = question.domain;\n                if (!domainPerformance[domain]) {\n                    domainPerformance[domain] = {\n                        total: 0,\n                        correct: 0\n                    };\n                }\n                \n                domainPerformance[domain].total++;\n                if (userAnswers[index] === question.correctAnswer) {\n                    domainPerformance[domain].correct++;\n                }\n            });\n            \n            // Update results UI\n            document.getElementById(\'final-score\').textContent = `${scorePercentage}%`;\n            document.getElementById(\'correct-answers\').textContent = `${correctCount}/${currentQuestions.length}`;\n            document.getElementById(\'time-taken\').textContent = timeString;\n            \n            // Generate domain stats\n            const domainStatsContainer = document.getElementById(\'domain-stats-container\');\n            domainStatsContainer.innerHTML = \'\';\n            \n            Object.entries(domainPerformance).forEach(([domain, stats]) => {\n                const percentage = Math.round((stats.correct / stats.total) * 100);\n                const domainColor = getDomainColorClass(percentage);\n                \n                const domainStat = document.createElement(\'div\');\n                domainStat.className = \'mb-4\';\n                domainStat.innerHTML = `\n                    <div class="flex justify-between items-center mb-1">\n                        <span class="text-sm font-medium text-gray-700">${domain}</span>\n                        <span class="text-sm font-medium ${domainColor.text}">${percentage}%</span>\n                    </div>\n                    <div class="w-full bg-gray-200 rounded-full h-2.5">\n                        <div class="${domainColor.bg} h-2.5 rounded-full" style="width: ${percentage}%"></div>\n                    </div>\n                    <div class="text-xs text-gray-500 mt-1">${stats.correct} / ${stats.total} correct</div>\n                `;\n                domainStatsContainer.appendChild(domainStat);\n            });\n            \n            // Generate recommendations\n            const recommendationsList = document.getElementById(\'recommendations-list\');\n            recommendationsList.innerHTML = \'\';\n            \n            // Find weakest domains\n            const weakDomains = Object.entries(domainPerformance)\n                .map(([domain, stats]) => ({\n                    domain,\n                    percentage: Math.round((stats.correct / stats.total) * 100)\n                }))\n                .sort((a, b) => a.percentage - b.percentage)\n                .slice(0, 3);\n            \n            // Generate recommendations based on weak domains\n            weakDomains.forEach(domainData => {\n                const recommendation = document.createElement(\'li\');\n                recommendation.textContent = getRecommendation(domainData.domain);\n                recommendationsList.appendChild(recommendation);\n            });\n            \n            // Show results screen\n            document.getElementById(\'assessment-screen\').classList.add(\'hidden\');\n            document.getElementById(\'results-screen\').classList.remove(\'hidden\');\n            \n            // Save results to localStorage for detailed view\n            const resultsData = {\n                score: scorePercentage,\n                correctAnswers: correctCount,\n                totalQuestions: currentQuestions.length,\n                completionTime: timeString,\n                domains: Object.entries(domainPerformance).map(([domain, stats]) => ({\n                    name: domain,\n                    score: Math.round((stats.correct / stats.total) * 100)\n                })),\n                recommendations: Array.from(recommendationsList.children).map(li => li.textContent)\n            };\n            \n            localStorage.setItem(\'assessmentResults\', JSON.stringify(resultsData));\n        }\n\n        // Get domain color class based on score\n        function getDomainColorClass(score) {\n            if (score >= 80) {\n                return { bg: \'bg-green-600\', text: \'text-green-600\' };\n            } else if (score >= 70) {\n                return { bg: \'bg-blue-600\', text: \'text-blue-600\' };\n            } else if (score >= 60) {\n                return { bg: \'bg-yellow-600\', text: \'text-yellow-600\' };\n            } else {\n                return { bg: \'bg-red-600\', text: \'text-red-600\' };\n            }\n        }\n\n        // Get recommendation based on domain\n        function getRecommendation(domain) {\n            const recommendations = {\n                "Child Development Theories": "Review key child development theories such as Piaget\'s stages and Vygotsky\'s zone of proximal development.",\n                "Curriculum Approaches": "Study different curriculum approaches, focusing on child-centered methods like Reggio Emilia and play-based learning.",\n                "Assessment Methods": "Explore authentic assessment techniques to better document and understand children\'s learning.",\n                "Quality Measurement": "Familiarize yourself with quality measurement tools like CLASS and apply their principles in your practice.",\n                "Health & Safety": "Review current health and safety guidelines and best practices for early childhood settings.",\n                "Developmentally Appropriate Practice": "Deepen your understanding of how to apply developmentally appropriate practices across all areas.",\n                "Teaching Strategies": "Focus on scaffolding techniques and differentiating instruction for diverse learners.",\n                "Guidance & Behavior Management": "Study positive guidance strategies and techniques for supporting children\'s self-regulation.",\n                "Communication & Language": "Practice using open-ended questions and strategies to extend children\'s language development.",\n                "Literacy Development": "Explore research-based approaches to emergent literacy and methods for rich literacy experiences.",\n                "Family Engagement": "Develop strategies for meaningful family partnerships that value diverse cultures and knowledge.",\n                "Inclusion & Diversity": "Build skills in creating inclusive environments and adapting activities for all children.",\n                "Cognitive Development": "Focus on understanding and supporting the development of executive function skills and mathematical thinking.",\n                "Language Development": "Learn more about supporting dual language learners and language acquisition stages.",\n                "Learning Environment": "Study how to design engaging, well-organized learning spaces that promote all aspects of development.",\n                "Observation & Assessment": "Practice documentation techniques to make children\'s learning visible and inform planning.",\n                "Social-Emotional Development": "Enhance your knowledge of strategies to support resilience and social-emotional skills.",\n                "Physical Development": "Ensure sufficient opportunities for both fine and gross motor development throughout the day.",\n                "Technology Integration": "Learn about developmentally appropriate technology use that enhances rather than replaces hands-on learning.",\n                "Family & Community Engagement": "Explore the \'funds of knowledge\' approach to better incorporate family cultures and expertise.",\n                "Play & Learning": "Deepen your understanding of how to support and extend learning through different types of play."\n            };\n            \n            return recommendations[domain] || `Focus on building your knowledge in ${domain}.`;\n        }\n\n        // Save results and redirect to detailed view\n        function saveAndViewResults() {\n            window.location.href = "/assessment-results.html";\n        }\n\n        // Restart the assessment\n        function restartAssessment() {\n            document.getElementById(\'results-screen\').classList.add(\'hidden\');\n            document.getElementById(\'setup-screen\').classList.remove(\'hidden\');\n            document.getElementById(\'name\').value = \'\';\n            document.getElementById(\'email\').value = \'\';\n        }\n     $X $X. ... .$V = "..." $X. ... .innerHTML = ... $X. ... .outerHTML = ... javascript <script ...>\n        // Assessment data\n        const allQuestions = [\n            {\n                id: 1,\n                text: "Which of the following best describes the zone of proximal development?",\n                domain: "Child Development Theories",\n                options: [\n                    "The area where a child can complete tasks independently",\n                    "The difference between what a child can do with help and what they can do independently",\n                    "The stage where children develop fine motor skills",\n                    "The period when children learn to socialize with peers"\n                ],\n                correctAnswer: 1,\n                explanation: "The zone of proximal development (ZPD) is the difference between what a learner can do without help and what they can achieve with guidance from a more knowledgeable person."\n            },\n            {\n                id: 2,\n                text: "Which approach emphasizes the importance of child-directed play and exploration?",\n                domain: "Curriculum Approaches",\n                options: [\n                    "Direct instruction",\n                    "Reggio Emilia",\n                    "Academic-focused curriculum",\n                    "Teacher-centered learning"\n                ],\n                correctAnswer: 1,\n                explanation: "The Reggio Emilia approach views children as capable, curious individuals and emphasizes child-directed exploration and discovery."\n            },\n            {\n                id: 3,\n                text: "What is the primary purpose of formative assessment in early childhood education?",\n                domain: "Assessment Methods",\n                options: [\n                    "To assign grades to children",\n                    "To compare children\'s abilities",\n                    "To inform ongoing teaching and learning",\n                    "To determine readiness for elementary school"\n                ],\n                correctAnswer: 2,\n                explanation: "Formative assessment is used to monitor student learning and provide ongoing feedback to improve teaching and learning processes."\n            },\n            {\n                id: 4,\n                text: "Which of the following is NOT typically considered one of the CLASS (Classroom Assessment Scoring System) domains?",\n                domain: "Quality Measurement",\n                options: [\n                    "Emotional Support",\n                    "Classroom Organization",\n                    "Instructional Support",\n                    "Physical Environment"\n                ],\n                correctAnswer: 3,\n                explanation: "The CLASS assessment tool has three main domains: Emotional Support, Classroom Organization, and Instructional Support. Physical Environment is not a CLASS domain."\n            },\n            {\n                id: 5,\n                text: "What is the recommended adult-to-child ratio for 3-year-olds according to NAEYC accreditation standards?",\n                domain: "Health & Safety",\n                options: [\n                    "1:15",\n                    "1:10",\n                    "1:8",\n                    "1:6"\n                ],\n                correctAnswer: 2,\n                explanation: "NAEYC recommends a ratio of 1 adult for every 8 three-year-olds with a maximum group size of 16."\n            },\n            {\n                id: 6,\n                text: "Which of the following is a key component of developmentally appropriate practice (DAP)?",\n                domain: "Developmentally Appropriate Practice",\n                options: [\n                    "Using the same approach for all children regardless of development",\n                    "Making decisions based on what children of a certain age should be able to do",\n                    "Considering the needs and capabilities of each individual child",\n                    "Following a strict curriculum regardless of children\'s interests"\n                ],\n                correctAnswer: 2,\n                explanation: "DAP requires teachers to meet children where they are, considering each child\'s age, experience, abilities, and interests."\n            },\n            {\n                id: 7,\n                text: "Which of these is an example of scaffolding in early childhood education?",\n                domain: "Teaching Strategies",\n                options: [\n                    "Giving a child a complex task and expecting them to figure it out independently",\n                    "Providing hints and supports to help a child complete a task they couldn\'t do alone",\n                    "Completing difficult tasks for children to demonstrate proper techniques",\n                    "Letting children only do activities they have already mastered"\n                ],\n                correctAnswer: 1,\n                explanation: "Scaffolding involves providing temporary support to help children master new skills, gradually removing the support as competence increases."\n            },\n            {\n                id: 8,\n                text: "What is the appropriate way to handle a situation where a child hits another child?",\n                domain: "Guidance & Behavior Management",\n                options: [\n                    "Ignore the behavior to avoid giving negative attention",\n                    "Immediately put the child in time-out without discussion",\n                    "Calmly stop the behavior, acknowledge feelings, and teach appropriate alternatives",\n                    "Ask the hit child to hit back so they learn a lesson"\n                ],\n                correctAnswer: 2,\n                explanation: "Effective guidance involves setting clear limits, acknowledging feelings, and teaching children alternative ways to express emotions."\n            },\n            {\n                id: 9,\n                text: "Which of the following would be considered an open-ended question?",\n                domain: "Communication & Language",\n                options: [\n                    "Did you like the story?",\n                    "Can you count to 10?",\n                    "What do you think will happen next in the story?",\n                    "Is this a triangle?"\n                ],\n                correctAnswer: 2,\n                explanation: "Open-ended questions cannot be answered with a simple \'yes\' or \'no\' and encourage children to think critically and express their thoughts."\n            },\n            {\n                id: 10,\n                text: "According to Piaget, in which stage do children develop object permanence?",\n                domain: "Child Development Theories",\n                options: [\n                    "Sensorimotor stage",\n                    "Preoperational stage",\n                    "Concrete operational stage",\n                    "Formal operational stage"\n                ],\n                correctAnswer: 0,\n                explanation: "Object permanence typically develops during the sensorimotor stage (birth to 2 years), when children begin to understand that objects continue to exist even when they cannot be seen."\n            },\n            {\n                id: 11,\n                text: "Which of the following practices best supports emergent literacy?",\n                domain: "Literacy Development",\n                options: [\n                    "Daily handwriting worksheets",\n                    "Flashcards with sight words",\n                    "Reading aloud and engaging children in conversations about stories",\n                    "Teaching the alphabet through rote memorization"\n                ],\n                correctAnswer: 2,\n                explanation: "Emergent literacy is best supported through meaningful interactions with text, including reading aloud, discussing stories, and incorporating literacy into play."\n            },\n            {\n                id: 12,\n                text: "What is the most effective way to engage families in children\'s learning?",\n                domain: "Family Engagement",\n                options: [\n                    "Sending home weekly newsletters about classroom activities",\n                    "Creating opportunities for families to share their expertise and culture in the classroom",\n                    "Having formal parent-teacher conferences twice a year",\n                    "Requiring parents to complete homework assignments with their children"\n                ],\n                correctAnswer: 1,\n                explanation: "Effective family engagement involves creating meaningful partnerships where families\' knowledge and cultures are valued and incorporated into the learning environment."\n            },\n            {\n                id: 13,\n                text: "Which of the following is the best example of an inclusive practice in early childhood education?",\n                domain: "Inclusion & Diversity",\n                options: [\n                    "Grouping children by ability for all activities",\n                    "Adapting materials and strategies to ensure all children can participate",\n                    "Providing separate activities for children with special needs",\n                    "Focusing equally on all cultural holidays throughout the year"\n                ],\n                correctAnswer: 1,\n                explanation: "Inclusive practices involve making adaptations and providing support so that all children can participate meaningfully in the same activities and routines."\n            },\n            {\n                id: 14,\n                text: "Which mathematical concept typically develops first in young children?",\n                domain: "Cognitive Development",\n                options: [\n                    "Multiplication",\n                    "One-to-one correspondence",\n                    "Fractions",\n                    "Algebraic thinking"\n                ],\n                correctAnswer: 1,\n                explanation: "One-to-one correspondence (matching one object to one object or person) is a foundational mathematical concept that typically develops in early childhood."\n            },\n            {\n                id: 15,\n                text: "Which of these is the most appropriate way to support a dual language learner in the classroom?",\n                domain: "Language Development",\n                options: [\n                    "Discourage the use of their home language to accelerate English acquisition",\n                    "Separate them from English-speaking peers to provide specialized instruction",\n                    "Provide visual supports and incorporate words from their home language",\n                    "Speak slowly and loudly to ensure comprehension"\n                ],\n                correctAnswer: 2,\n                explanation: "Supporting dual language learners involves valuing their home language, providing visual cues, and creating a language-rich environment that incorporates elements of their home language."\n            },\n            {\n                id: 16,\n                text: "Which of the following best describes the purpose of learning centers in a preschool classroom?",\n                domain: "Learning Environment",\n                options: [\n                    "To keep children busy while the teacher works with small groups",\n                    "To provide opportunities for choice, exploration, and discovery",\n                    "To prepare children for the structure of elementary school",\n                    "To assess children\'s ability to follow directions"\n                ],\n                correctAnswer: 1,\n                explanation: "Learning centers are designed to promote active engagement, choice, peer interaction, and exploration across different developmental domains."\n            },\n            {\n                id: 17,\n                text: "What is the primary purpose of documentation in Reggio Emilia-inspired programs?",\n                domain: "Observation & Assessment",\n                options: [\n                    "To evaluate children\'s academic progress",\n                    "To create portfolios to share with parents",\n                    "To make children\'s thinking and learning visible",\n                    "To fulfill licensing requirements"\n                ],\n                correctAnswer: 2,\n                explanation: "In Reggio Emilia, documentation serves to make children\'s thoughts, theories, and learning processes visible, helping teachers and children reflect on and extend learning."\n            },\n            {\n                id: 18,\n                text: "Which of the following is NOT considered a protective factor in building children\'s resilience?",\n                domain: "Social-Emotional Development",\n                options: [\n                    "Secure attachment relationships",\n                    "Self-regulation skills",\n                    "Problem-solving abilities",\n                    "Highly structured adult-directed activities"\n                ],\n                correctAnswer: 3,\n                explanation: "Protective factors that build resilience include supportive relationships, self-regulation, problem-solving skills, and opportunities for children to develop a sense of mastery through appropriate challenges."\n            },\n            {\n                id: 19,\n                text: "According to early childhood education best practices, what is the recommended daily minimum amount of time for outdoor play?",\n                domain: "Physical Development",\n                options: [\n                    "15 minutes",\n                    "30 minutes",\n                    "60 minutes",\n                    "90 minutes"\n                ],\n                correctAnswer: 2,\n                explanation: "Best practice guidelines suggest a minimum of 60 minutes of outdoor play daily for young children, weather permitting, to support physical development and overall well-being."\n            },\n            {\n                id: 20,\n                text: "Which of the following best describes appropriate technology use in early childhood settings?",\n                domain: "Technology Integration",\n                options: [\n                    "Children should have unlimited access to technology throughout the day",\n                    "Technology should be avoided entirely until age 7",\n                    "Technology should supplement, not replace, hands-on experiences and face-to-face interactions",\n                    "Children should use technology primarily for entertainment purposes"\n                ],\n                correctAnswer: 2,\n                explanation: "Developmentally appropriate technology use includes intentional selection of digital tools that enhance learning, used with adult guidance and in balance with other activities."\n            },\n            {\n                id: 21,\n                text: "Which is the best example of an authentic assessment approach?",\n                domain: "Assessment Methods",\n                options: [\n                    "Weekly spelling tests",\n                    "Standardized readiness tests",\n                    "Documentation of children\'s work and play over time",\n                    "Comparing all children to age-based milestones"\n                ],\n                correctAnswer: 2,\n                explanation: "Authentic assessment involves documenting children\'s actual work, play, and interactions in natural settings over time to understand their development and learning."\n            },\n            {\n                id: 22,\n                text: "How does the concept of \'funds of knowledge\' relate to working with diverse families?",\n                domain: "Family & Community Engagement",\n                options: [\n                    "It refers to the financial resources families can contribute to the program",\n                    "It recognizes the knowledge, skills and cultural practices of families as valuable resources",\n                    "It describes the educational background of family members",\n                    "It tracks how much information families retain from parent workshops"\n                ],\n                correctAnswer: 1,\n                explanation: "The \'funds of knowledge\' approach recognizes that families possess valuable knowledge, skills, and cultural practices that should be incorporated into and respected within educational settings."\n            },\n            {\n                id: 23,\n                text: "What is the primary purpose of project-based learning in early childhood?",\n                domain: "Curriculum Approaches",\n                options: [\n                    "To teach specific academic content in an organized sequence",\n                    "To prepare children for standardized testing",\n                    "To engage children in in-depth investigation of topics of interest",\n                    "To complete products for display in the classroom"\n                ],\n                correctAnswer: 2,\n                explanation: "Project-based learning engages children in extended, in-depth investigations of topics of interest, promoting deep learning, collaboration, and development across domains."\n            },\n            {\n                id: 24,\n                text: "Which of the following statements about executive function skills is TRUE?",\n                domain: "Cognitive Development",\n                options: [\n                    "They develop naturally and cannot be influenced by the environment",\n                    "They include working memory, inhibitory control, and cognitive flexibility",\n                    "They are fully developed by age 3",\n                    "They are only important for academic learning, not social skills"\n                ],\n                correctAnswer: 1,\n                explanation: "Executive function skills include working memory, inhibitory control, and cognitive flexibility, and they develop gradually throughout childhood with appropriate support and experiences."\n            },\n            {\n                id: 25,\n                text: "What is the most appropriate way to support socio-dramatic play in a preschool classroom?",\n                domain: "Play & Learning",\n                options: [\n                    "Assign roles to ensure all children participate equally",\n                    "Provide open-ended materials and appropriate time and space",\n                    "Require a specific theme to ensure educational content",\n                    "Have adults direct the play to maintain order"\n                ],\n                correctAnswer: 1,\n                explanation: "Supporting socio-dramatic play involves providing open-ended materials, sufficient time and space, and appropriate adult scaffolding without taking over or directing the play."\n            }\n        ];\n\n        let assessmentType = \'basic\';\n        let currentQuestions = [];\n        let currentQuestionIndex = 0;\n        let userAnswers = [];\n        let startTime = null;\n        let timerInterval = null;\n\n        // Set assessment type\n        function setAssessmentType(type) {\n            assessmentType = type;\n            const basicOption = document.querySelector(\'div[onclick="setAssessmentType(\\\'basic\\\')"]\');\n            const comprehensiveOption = document.querySelector(\'div[onclick="setAssessmentType(\\\'comprehensive\\\')"]\');\n            \n            basicOption.classList.remove(\'border-indigo-500\', \'bg-indigo-50\');\n            comprehensiveOption.classList.remove(\'border-indigo-500\', \'bg-indigo-50\');\n            \n            if (type === \'basic\') {\n                basicOption.classList.add(\'border-indigo-500\', \'bg-indigo-50\');\n            } else {\n                comprehensiveOption.classList.add(\'border-indigo-500\', \'bg-indigo-50\');\n            }\n        }\n\n        // Start the assessment\n        function startAssessment() {\n            // Get user info\n            const userName = document.getElementById(\'name\').value;\n            const userEmail = document.getElementById(\'email\').value;\n            \n            // Select questions based on assessment type\n            if (assessmentType === \'basic\') {\n                currentQuestions = allQuestions.slice(0, 15);\n                document.getElementById(\'total-questions\').textContent = \'15\';\n            } else {\n                currentQuestions = allQuestions;\n                document.getElementById(\'total-questions\').textContent = \'25\';\n            }\n            \n            // Initialize user answers array\n            userAnswers = Array(currentQuestions.length).fill(null);\n            \n            // Show the assessment screen\n            document.getElementById(\'setup-screen\').classList.add(\'hidden\');\n            document.getElementById(\'assessment-screen\').classList.remove(\'hidden\');\n            \n            // Display the first question\n            currentQuestionIndex = 0;\n            displayQuestion(currentQuestionIndex);\n            \n            // Start the timer\n            startTime = new Date();\n            timerInterval = setInterval(updateTimer, 1000);\n        }\n\n        // Display a question\n        function displayQuestion(index) {\n            const question = currentQuestions[index];\n            document.getElementById(\'current-question\').textContent = index + 1;\n            document.getElementById(\'question-text\').textContent = question.text;\n            document.getElementById(\'question-domain\').textContent = `Domain: ${question.domain}`;\n            \n            // Update progress bar\n            const progressPercentage = ((index + 1) / currentQuestions.length) * 100;\n            document.getElementById(\'progress-value\').style.width = `${progressPercentage}%`;\n            \n            // Generate options\n            const optionsContainer = document.getElementById(\'options-container\');\n            optionsContainer.innerHTML = \'\';\n            \n            question.options.forEach((option, optionIndex) => {\n                const optionCard = document.createElement(\'div\');\n                optionCard.className = \'option-card p-4\';\n                optionCard.setAttribute(\'data-index\', optionIndex);\n                \n                // If user has already answered this question\n                if (userAnswers[index] !== null) {\n                    if (userAnswers[index] === optionIndex) {\n                        optionCard.classList.add(\'selected\');\n                        if (optionIndex === question.correctAnswer) {\n                            optionCard.classList.add(\'correct\');\n                        } else {\n                            optionCard.classList.add(\'incorrect\');\n                        }\n                    } else if (optionIndex === question.correctAnswer) {\n                        optionCard.classList.add(\'correct\');\n                    }\n                    optionCard.style.pointerEvents = \'none\';\n                } else {\n                    optionCard.addEventListener(\'click\', () => selectOption(optionIndex));\n                }\n                \n                optionCard.innerHTML = `\n                    <div class="flex items-start">\n                        <div class="flex-shrink-0 w-6 h-6 bg-gray-200 rounded-full flex items-center justify-center text-sm mr-3">\n                            ${String.fromCharCode(65 + optionIndex)}\n                        </div>\n                        <span>${option}</span>\n                    </div>\n                `;\n                optionsContainer.appendChild(optionCard);\n            });\n            \n            // Hide feedback container\n            document.getElementById(\'feedback-container\').classList.add(\'hidden\');\n            \n            // Update navigation buttons\n            document.getElementById(\'prev-btn\').disabled = index === 0;\n            document.getElementById(\'next-btn\').disabled = userAnswers[index] === null;\n            \n            if (index === currentQuestions.length - 1 && userAnswers[index] !== null) {\n                document.getElementById(\'next-btn\').textContent = \'Finish\';\n            } else {\n                document.getElementById(\'next-btn\').textContent = \'Next\';\n            }\n        }\n\n        // Select an option\n        function selectOption(optionIndex) {\n            const question = currentQuestions[currentQuestionIndex];\n            userAnswers[currentQuestionIndex] = optionIndex;\n            \n            // Update options UI\n            const options = document.querySelectorAll(\'.option-card\');\n            options.forEach((option, index) => {\n                option.classList.remove(\'selected\', \'correct\', \'incorrect\');\n                option.style.pointerEvents = \'none\';\n                \n                if (index === optionIndex) {\n                    option.classList.add(\'selected\');\n                    if (index === question.correctAnswer) {\n                        option.classList.add(\'correct\');\n                    } else {\n                        option.classList.add(\'incorrect\');\n                    }\n                } else if (index === question.correctAnswer) {\n                    option.classList.add(\'correct\');\n                }\n            });\n            \n            // Show feedback\n            const feedbackContainer = document.getElementById(\'feedback-container\');\n            feedbackContainer.innerHTML = \'\';\n            \n            if (optionIndex === question.correctAnswer) {\n                feedbackContainer.classList.add(\'feedback-correct\');\n                feedbackContainer.classList.remove(\'feedback-incorrect\');\n                feedbackContainer.innerHTML = `\n                    <div class="flex items-start">\n                        <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">\n                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>\n                        </svg>\n                        <div>\n                            <p class="font-semibold text-green-700">Correct!</p>\n                            <p class="text-sm text-gray-600 mt-1">${question.explanation}</p>\n                        </div>\n                    </div>\n                `;\n            } else {\n                feedbackContainer.classList.add(\'feedback-incorrect\');\n                feedbackContainer.classList.remove(\'feedback-correct\');\n                feedbackContainer.innerHTML = `\n                    <div class="flex items-start">\n                        <svg class="w-5 h-5 text-red-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">\n                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>\n                        </svg>\n                        <div>\n                            <p class="font-semibold text-red-700">Incorrect</p>\n                            <p class="text-sm text-gray-600 mt-1">The correct answer is: ${question.options[question.correctAnswer]}</p>\n                            <p class="text-sm text-gray-600 mt-1">${question.explanation}</p>\n                        </div>\n                    </div>\n                `;\n            }\n            feedbackContainer.classList.remove(\'hidden\');\n            \n            // Enable next button\n            document.getElementById(\'next-btn\').disabled = false;\n            \n            // If this is the last question and it\'s answered, show "Finish" on the button\n            if (currentQuestionIndex === currentQuestions.length - 1) {\n                document.getElementById(\'next-btn\').textContent = \'Finish\';\n            }\n        }\n\n        // Navigate to previous or next question\n        function navigateQuestion(direction) {\n            if (direction === 1 && currentQuestionIndex === currentQuestions.length - 1) {\n                // This is the last question, finish the assessment\n                finishAssessment();\n                return;\n            }\n            \n            currentQuestionIndex += direction;\n            displayQuestion(currentQuestionIndex);\n        }\n\n        // Update the timer\n        function updateTimer() {\n            if (!startTime) return;\n            \n            const now = new Date();\n            const elapsedMilliseconds = now - startTime;\n            const elapsedSeconds = Math.floor(elapsedMilliseconds / 1000);\n            const minutes = Math.floor(elapsedSeconds / 60);\n            const seconds = elapsedSeconds % 60;\n            \n            document.getElementById(\'timer\').textContent = `${minutes.toString().padStart(2, \'0\')}:${seconds.toString().padStart(2, \'0\')}`;\n        }\n\n        // Finish the assessment\n        function finishAssessment() {\n            // Stop the timer\n            clearInterval(timerInterval);\n            const endTime = new Date();\n            const totalTimeInSeconds = Math.floor((endTime - startTime) / 1000);\n            const minutes = Math.floor(totalTimeInSeconds / 60);\n            const seconds = totalTimeInSeconds % 60;\n            const timeString = `${minutes.toString().padStart(2, \'0\')}:${seconds.toString().padStart(2, \'0\')}`;\n            \n            // Calculate score\n            let correctCount = 0;\n            userAnswers.forEach((answer, index) => {\n                if (answer === currentQuestions[index].correctAnswer) {\n                    correctCount++;\n                }\n            });\n            \n            const scorePercentage = Math.round((correctCount / currentQuestions.length) * 100);\n            \n            // Calculate domain performance\n            const domainPerformance = {};\n            currentQuestions.forEach((question, index) => {\n                const domain = question.domain;\n                if (!domainPerformance[domain]) {\n                    domainPerformance[domain] = {\n                        total: 0,\n                        correct: 0\n                    };\n                }\n                \n                domainPerformance[domain].total++;\n                if (userAnswers[index] === question.correctAnswer) {\n                    domainPerformance[domain].correct++;\n                }\n            });\n            \n            // Update results UI\n            document.getElementById(\'final-score\').textContent = `${scorePercentage}%`;\n            document.getElementById(\'correct-answers\').textContent = `${correctCount}/${currentQuestions.length}`;\n            document.getElementById(\'time-taken\').textContent = timeString;\n            \n            // Generate domain stats\n            const domainStatsContainer = document.getElementById(\'domain-stats-container\');\n            domainStatsContainer.innerHTML = \'\';\n            \n            Object.entries(domainPerformance).forEach(([domain, stats]) => {\n                const percentage = Math.round((stats.correct / stats.total) * 100);\n                const domainColor = getDomainColorClass(percentage);\n                \n                const domainStat = document.createElement(\'div\');\n                domainStat.className = \'mb-4\';\n                domainStat.innerHTML = `\n                    <div class="flex justify-between items-center mb-1">\n                        <span class="text-sm font-medium text-gray-700">${domain}</span>\n                        <span class="text-sm font-medium ${domainColor.text}">${percentage}%</span>\n                    </div>\n                    <div class="w-full bg-gray-200 rounded-full h-2.5">\n                        <div class="${domainColor.bg} h-2.5 rounded-full" style="width: ${percentage}%"></div>\n                    </div>\n                    <div class="text-xs text-gray-500 mt-1">${stats.correct} / ${stats.total} correct</div>\n                `;\n                domainStatsContainer.appendChild(domainStat);\n            });\n            \n            // Generate recommendations\n            const recommendationsList = document.getElementById(\'recommendations-list\');\n            recommendationsList.innerHTML = \'\';\n            \n            // Find weakest domains\n            const weakDomains = Object.entries(domainPerformance)\n                .map(([domain, stats]) => ({\n                    domain,\n                    percentage: Math.round((stats.correct / stats.total) * 100)\n                }))\n                .sort((a, b) => a.percentage - b.percentage)\n                .slice(0, 3);\n            \n            // Generate recommendations based on weak domains\n            weakDomains.forEach(domainData => {\n                const recommendation = document.createElement(\'li\');\n                recommendation.textContent = getRecommendation(domainData.domain);\n                recommendationsList.appendChild(recommendation);\n            });\n            \n            // Show results screen\n            document.getElementById(\'assessment-screen\').classList.add(\'hidden\');\n            document.getElementById(\'results-screen\').classList.remove(\'hidden\');\n            \n            // Save results to localStorage for detailed view\n            const resultsData = {\n                score: scorePercentage,\n                correctAnswers: correctCount,\n                totalQuestions: currentQuestions.length,\n                completionTime: timeString,\n                domains: Object.entries(domainPerformance).map(([domain, stats]) => ({\n                    name: domain,\n                    score: Math.round((stats.correct / stats.total) * 100)\n                })),\n                recommendations: Array.from(recommendationsList.children).map(li => li.textContent)\n            };\n            \n            localStorage.setItem(\'assessmentResults\', JSON.stringify(resultsData));\n        }\n\n        // Get domain color class based on score\n        function getDomainColorClass(score) {\n            if (score >= 80) {\n                return { bg: \'bg-green-600\', text: \'text-green-600\' };\n            } else if (score >= 70) {\n                return { bg: \'bg-blue-600\', text: \'text-blue-600\' };\n            } else if (score >= 60) {\n                return { bg: \'bg-yellow-600\', text: \'text-yellow-600\' };\n            } else {\n                return { bg: \'bg-red-600\', text: \'text-red-600\' };\n            }\n        }\n\n        // Get recommendation based on domain\n        function getRecommendation(domain) {\n            const recommendations = {\n                "Child Development Theories": "Review key child development theories such as Piaget\'s stages and Vygotsky\'s zone of proximal development.",\n                "Curriculum Approaches": "Study different curriculum approaches, focusing on child-centered methods like Reggio Emilia and play-based learning.",\n                "Assessment Methods": "Explore authentic assessment techniques to better document and understand children\'s learning.",\n                "Quality Measurement": "Familiarize yourself with quality measurement tools like CLASS and apply their principles in your practice.",\n                "Health & Safety": "Review current health and safety guidelines and best practices for early childhood settings.",\n                "Developmentally Appropriate Practice": "Deepen your understanding of how to apply developmentally appropriate practices across all areas.",\n                "Teaching Strategies": "Focus on scaffolding techniques and differentiating instruction for diverse learners.",\n                "Guidance & Behavior Management": "Study positive guidance strategies and techniques for supporting children\'s self-regulation.",\n                "Communication & Language": "Practice using open-ended questions and strategies to extend children\'s language development.",\n                "Literacy Development": "Explore research-based approaches to emergent literacy and methods for rich literacy experiences.",\n                "Family Engagement": "Develop strategies for meaningful family partnerships that value diverse cultures and knowledge.",\n                "Inclusion & Diversity": "Build skills in creating inclusive environments and adapting activities for all children.",\n                "Cognitive Development": "Focus on understanding and supporting the development of executive function skills and mathematical thinking.",\n                "Language Development": "Learn more about supporting dual language learners and language acquisition stages.",\n                "Learning Environment": "Study how to design engaging, well-organized learning spaces that promote all aspects of development.",\n                "Observation & Assessment": "Practice documentation techniques to make children\'s learning visible and inform planning.",\n                "Social-Emotional Development": "Enhance your knowledge of strategies to support resilience and social-emotional skills.",\n                "Physical Development": "Ensure sufficient opportunities for both fine and gross motor development throughout the day.",\n                "Technology Integration": "Learn about developmentally appropriate technology use that enhances rather than replaces hands-on learning.",\n                "Family & Community Engagement": "Explore the \'funds of knowledge\' approach to better incorporate family cultures and expertise.",\n                "Play & Learning": "Deepen your understanding of how to support and extend learning through different types of play."\n            };\n            \n            return recommendations[domain] || `Focus on building your knowledge in ${domain}.`;\n        }\n\n        // Save results and redirect to detailed view\n        function saveAndViewResults() {\n            window.location.href = "/assessment-results.html";\n        }\n\n        // Restart the assessment\n        function restartAssessment() {\n            document.getElementById(\'results-screen\').classList.add(\'hidden\');\n            document.getElementById(\'setup-screen\').classList.remove(\'hidden\');\n            document.getElementById(\'name\').value = \'\';\n            document.getElementById(\'email\').value = \'\';\n        }\n    </script>\n', PosixPath('backup/cleanup-phase1/assessment.html'), 'config..semgrep.vendored-rules.html.security.audit.insecure-document-method') match_id = 18b8d6cabeafeca15d694504979ceaab571749bd5a91bde4fe7a271dda2796659d1010ff4a3d6a9f86bcccd49139e0de1c66206ad39b6547281e462f651b97a2_0
2025-07-06 02:31:06,010 - semgrep.rule_match - DEBUG - match_key = ('\n        // Assessment data\n        const allQuestions = [\n            {\n                id: 1,\n                text: "Which of the following best describes the zone of proximal development?",\n                domain: "Child Development Theories",\n                options: [\n                    "The area where a child can complete tasks independently",\n                    "The difference between what a child can do with help and what they can do independently",\n                    "The stage where children develop fine motor skills",\n                    "The period when children learn to socialize with peers"\n                ],\n                correctAnswer: 1,\n                explanation: "The zone of proximal development (ZPD) is the difference between what a learner can do without help and what they can achieve with guidance from a more knowledgeable person."\n            },\n            {\n                id: 2,\n                text: "Which approach emphasizes the importance of child-directed play and exploration?",\n                domain: "Curriculum Approaches",\n                options: [\n                    "Direct instruction",\n                    "Reggio Emilia",\n                    "Academic-focused curriculum",\n                    "Teacher-centered learning"\n                ],\n                correctAnswer: 1,\n                explanation: "The Reggio Emilia approach views children as capable, curious individuals and emphasizes child-directed exploration and discovery."\n            },\n            {\n                id: 3,\n                text: "What is the primary purpose of formative assessment in early childhood education?",\n                domain: "Assessment Methods",\n                options: [\n                    "To assign grades to children",\n                    "To compare children\'s abilities",\n                    "To inform ongoing teaching and learning",\n                    "To determine readiness for elementary school"\n                ],\n                correctAnswer: 2,\n                explanation: "Formative assessment is used to monitor student learning and provide ongoing feedback to improve teaching and learning processes."\n            },\n            {\n                id: 4,\n                text: "Which of the following is NOT typically considered one of the CLASS (Classroom Assessment Scoring System) domains?",\n                domain: "Quality Measurement",\n                options: [\n                    "Emotional Support",\n                    "Classroom Organization",\n                    "Instructional Support",\n                    "Physical Environment"\n                ],\n                correctAnswer: 3,\n                explanation: "The CLASS assessment tool has three main domains: Emotional Support, Classroom Organization, and Instructional Support. Physical Environment is not a CLASS domain."\n            },\n            {\n                id: 5,\n                text: "What is the recommended adult-to-child ratio for 3-year-olds according to NAEYC accreditation standards?",\n                domain: "Health & Safety",\n                options: [\n                    "1:15",\n                    "1:10",\n                    "1:8",\n                    "1:6"\n                ],\n                correctAnswer: 2,\n                explanation: "NAEYC recommends a ratio of 1 adult for every 8 three-year-olds with a maximum group size of 16."\n            },\n            {\n                id: 6,\n                text: "Which of the following is a key component of developmentally appropriate practice (DAP)?",\n                domain: "Developmentally Appropriate Practice",\n                options: [\n                    "Using the same approach for all children regardless of development",\n                    "Making decisions based on what children of a certain age should be able to do",\n                    "Considering the needs and capabilities of each individual child",\n                    "Following a strict curriculum regardless of children\'s interests"\n                ],\n                correctAnswer: 2,\n                explanation: "DAP requires teachers to meet children where they are, considering each child\'s age, experience, abilities, and interests."\n            },\n            {\n                id: 7,\n                text: "Which of these is an example of scaffolding in early childhood education?",\n                domain: "Teaching Strategies",\n                options: [\n                    "Giving a child a complex task and expecting them to figure it out independently",\n                    "Providing hints and supports to help a child complete a task they couldn\'t do alone",\n                    "Completing difficult tasks for children to demonstrate proper techniques",\n                    "Letting children only do activities they have already mastered"\n                ],\n                correctAnswer: 1,\n                explanation: "Scaffolding involves providing temporary support to help children master new skills, gradually removing the support as competence increases."\n            },\n            {\n                id: 8,\n                text: "What is the appropriate way to handle a situation where a child hits another child?",\n                domain: "Guidance & Behavior Management",\n                options: [\n                    "Ignore the behavior to avoid giving negative attention",\n                    "Immediately put the child in time-out without discussion",\n                    "Calmly stop the behavior, acknowledge feelings, and teach appropriate alternatives",\n                    "Ask the hit child to hit back so they learn a lesson"\n                ],\n                correctAnswer: 2,\n                explanation: "Effective guidance involves setting clear limits, acknowledging feelings, and teaching children alternative ways to express emotions."\n            },\n            {\n                id: 9,\n                text: "Which of the following would be considered an open-ended question?",\n                domain: "Communication & Language",\n                options: [\n                    "Did you like the story?",\n                    "Can you count to 10?",\n                    "What do you think will happen next in the story?",\n                    "Is this a triangle?"\n                ],\n                correctAnswer: 2,\n                explanation: "Open-ended questions cannot be answered with a simple \'yes\' or \'no\' and encourage children to think critically and express their thoughts."\n            },\n            {\n                id: 10,\n                text: "According to Piaget, in which stage do children develop object permanence?",\n                domain: "Child Development Theories",\n                options: [\n                    "Sensorimotor stage",\n                    "Preoperational stage",\n                    "Concrete operational stage",\n                    "Formal operational stage"\n                ],\n                correctAnswer: 0,\n                explanation: "Object permanence typically develops during the sensorimotor stage (birth to 2 years), when children begin to understand that objects continue to exist even when they cannot be seen."\n            },\n            {\n                id: 11,\n                text: "Which of the following practices best supports emergent literacy?",\n                domain: "Literacy Development",\n                options: [\n                    "Daily handwriting worksheets",\n                    "Flashcards with sight words",\n                    "Reading aloud and engaging children in conversations about stories",\n                    "Teaching the alphabet through rote memorization"\n                ],\n                correctAnswer: 2,\n                explanation: "Emergent literacy is best supported through meaningful interactions with text, including reading aloud, discussing stories, and incorporating literacy into play."\n            },\n            {\n                id: 12,\n                text: "What is the most effective way to engage families in children\'s learning?",\n                domain: "Family Engagement",\n                options: [\n                    "Sending home weekly newsletters about classroom activities",\n                    "Creating opportunities for families to share their expertise and culture in the classroom",\n                    "Having formal parent-teacher conferences twice a year",\n                    "Requiring parents to complete homework assignments with their children"\n                ],\n                correctAnswer: 1,\n                explanation: "Effective family engagement involves creating meaningful partnerships where families\' knowledge and cultures are valued and incorporated into the learning environment."\n            },\n            {\n                id: 13,\n                text: "Which of the following is the best example of an inclusive practice in early childhood education?",\n                domain: "Inclusion & Diversity",\n                options: [\n                    "Grouping children by ability for all activities",\n                    "Adapting materials and strategies to ensure all children can participate",\n                    "Providing separate activities for children with special needs",\n                    "Focusing equally on all cultural holidays throughout the year"\n                ],\n                correctAnswer: 1,\n                explanation: "Inclusive practices involve making adaptations and providing support so that all children can participate meaningfully in the same activities and routines."\n            },\n            {\n                id: 14,\n                text: "Which mathematical concept typically develops first in young children?",\n                domain: "Cognitive Development",\n                options: [\n                    "Multiplication",\n                    "One-to-one correspondence",\n                    "Fractions",\n                    "Algebraic thinking"\n                ],\n                correctAnswer: 1,\n                explanation: "One-to-one correspondence (matching one object to one object or person) is a foundational mathematical concept that typically develops in early childhood."\n            },\n            {\n                id: 15,\n                text: "Which of these is the most appropriate way to support a dual language learner in the classroom?",\n                domain: "Language Development",\n                options: [\n                    "Discourage the use of their home language to accelerate English acquisition",\n                    "Separate them from English-speaking peers to provide specialized instruction",\n                    "Provide visual supports and incorporate words from their home language",\n                    "Speak slowly and loudly to ensure comprehension"\n                ],\n                correctAnswer: 2,\n                explanation: "Supporting dual language learners involves valuing their home language, providing visual cues, and creating a language-rich environment that incorporates elements of their home language."\n            },\n            {\n                id: 16,\n                text: "Which of the following best describes the purpose of learning centers in a preschool classroom?",\n                domain: "Learning Environment",\n                options: [\n                    "To keep children busy while the teacher works with small groups",\n                    "To provide opportunities for choice, exploration, and discovery",\n                    "To prepare children for the structure of elementary school",\n                    "To assess children\'s ability to follow directions"\n                ],\n                correctAnswer: 1,\n                explanation: "Learning centers are designed to promote active engagement, choice, peer interaction, and exploration across different developmental domains."\n            },\n            {\n                id: 17,\n                text: "What is the primary purpose of documentation in Reggio Emilia-inspired programs?",\n                domain: "Observation & Assessment",\n                options: [\n                    "To evaluate children\'s academic progress",\n                    "To create portfolios to share with parents",\n                    "To make children\'s thinking and learning visible",\n                    "To fulfill licensing requirements"\n                ],\n                correctAnswer: 2,\n                explanation: "In Reggio Emilia, documentation serves to make children\'s thoughts, theories, and learning processes visible, helping teachers and children reflect on and extend learning."\n            },\n            {\n                id: 18,\n                text: "Which of the following is NOT considered a protective factor in building children\'s resilience?",\n                domain: "Social-Emotional Development",\n                options: [\n                    "Secure attachment relationships",\n                    "Self-regulation skills",\n                    "Problem-solving abilities",\n                    "Highly structured adult-directed activities"\n                ],\n                correctAnswer: 3,\n                explanation: "Protective factors that build resilience include supportive relationships, self-regulation, problem-solving skills, and opportunities for children to develop a sense of mastery through appropriate challenges."\n            },\n            {\n                id: 19,\n                text: "According to early childhood education best practices, what is the recommended daily minimum amount of time for outdoor play?",\n                domain: "Physical Development",\n                options: [\n                    "15 minutes",\n                    "30 minutes",\n                    "60 minutes",\n                    "90 minutes"\n                ],\n                correctAnswer: 2,\n                explanation: "Best practice guidelines suggest a minimum of 60 minutes of outdoor play daily for young children, weather permitting, to support physical development and overall well-being."\n            },\n            {\n                id: 20,\n                text: "Which of the following best describes appropriate technology use in early childhood settings?",\n                domain: "Technology Integration",\n                options: [\n                    "Children should have unlimited access to technology throughout the day",\n                    "Technology should be avoided entirely until age 7",\n                    "Technology should supplement, not replace, hands-on experiences and face-to-face interactions",\n                    "Children should use technology primarily for entertainment purposes"\n                ],\n                correctAnswer: 2,\n                explanation: "Developmentally appropriate technology use includes intentional selection of digital tools that enhance learning, used with adult guidance and in balance with other activities."\n            },\n            {\n                id: 21,\n                text: "Which is the best example of an authentic assessment approach?",\n                domain: "Assessment Methods",\n                options: [\n                    "Weekly spelling tests",\n                    "Standardized readiness tests",\n                    "Documentation of children\'s work and play over time",\n                    "Comparing all children to age-based milestones"\n                ],\n                correctAnswer: 2,\n                explanation: "Authentic assessment involves documenting children\'s actual work, play, and interactions in natural settings over time to understand their development and learning."\n            },\n            {\n                id: 22,\n                text: "How does the concept of \'funds of knowledge\' relate to working with diverse families?",\n                domain: "Family & Community Engagement",\n                options: [\n                    "It refers to the financial resources families can contribute to the program",\n                    "It recognizes the knowledge, skills and cultural practices of families as valuable resources",\n                    "It describes the educational background of family members",\n                    "It tracks how much information families retain from parent workshops"\n                ],\n                correctAnswer: 1,\n                explanation: "The \'funds of knowledge\' approach recognizes that families possess valuable knowledge, skills, and cultural practices that should be incorporated into and respected within educational settings."\n            },\n            {\n                id: 23,\n                text: "What is the primary purpose of project-based learning in early childhood?",\n                domain: "Curriculum Approaches",\n                options: [\n                    "To teach specific academic content in an organized sequence",\n                    "To prepare children for standardized testing",\n                    "To engage children in in-depth investigation of topics of interest",\n                    "To complete products for display in the classroom"\n                ],\n                correctAnswer: 2,\n                explanation: "Project-based learning engages children in extended, in-depth investigations of topics of interest, promoting deep learning, collaboration, and development across domains."\n            },\n            {\n                id: 24,\n                text: "Which of the following statements about executive function skills is TRUE?",\n                domain: "Cognitive Development",\n                options: [\n                    "They develop naturally and cannot be influenced by the environment",\n                    "They include working memory, inhibitory control, and cognitive flexibility",\n                    "They are fully developed by age 3",\n                    "They are only important for academic learning, not social skills"\n                ],\n                correctAnswer: 1,\n                explanation: "Executive function skills include working memory, inhibitory control, and cognitive flexibility, and they develop gradually throughout childhood with appropriate support and experiences."\n            },\n            {\n                id: 25,\n                text: "What is the most appropriate way to support socio-dramatic play in a preschool classroom?",\n                domain: "Play & Learning",\n                options: [\n                    "Assign roles to ensure all children participate equally",\n                    "Provide open-ended materials and appropriate time and space",\n                    "Require a specific theme to ensure educational content",\n                    "Have adults direct the play to maintain order"\n                ],\n                correctAnswer: 1,\n                explanation: "Supporting socio-dramatic play involves providing open-ended materials, sufficient time and space, and appropriate adult scaffolding without taking over or directing the play."\n            }\n        ];\n\n        let assessmentType = \'basic\';\n        let currentQuestions = [];\n        let currentQuestionIndex = 0;\n        let userAnswers = [];\n        let startTime = null;\n        let timerInterval = null;\n\n        // Set assessment type\n        function setAssessmentType(type) {\n            assessmentType = type;\n            const basicOption = document.querySelector(\'div[onclick="setAssessmentType(\\\'basic\\\')"]\');\n            const comprehensiveOption = document.querySelector(\'div[onclick="setAssessmentType(\\\'comprehensive\\\')"]\');\n            \n            basicOption.classList.remove(\'border-indigo-500\', \'bg-indigo-50\');\n            comprehensiveOption.classList.remove(\'border-indigo-500\', \'bg-indigo-50\');\n            \n            if (type === \'basic\') {\n                basicOption.classList.add(\'border-indigo-500\', \'bg-indigo-50\');\n            } else {\n                comprehensiveOption.classList.add(\'border-indigo-500\', \'bg-indigo-50\');\n            }\n        }\n\n        // Start the assessment\n        function startAssessment() {\n            // Get user info\n            const userName = document.getElementById(\'name\').value;\n            const userEmail = document.getElementById(\'email\').value;\n            \n            // Select questions based on assessment type\n            if (assessmentType === \'basic\') {\n                currentQuestions = allQuestions.slice(0, 15);\n                document.getElementById(\'total-questions\').textContent = \'15\';\n            } else {\n                currentQuestions = allQuestions;\n                document.getElementById(\'total-questions\').textContent = \'25\';\n            }\n            \n            // Initialize user answers array\n            userAnswers = Array(currentQuestions.length).fill(null);\n            \n            // Show the assessment screen\n            document.getElementById(\'setup-screen\').classList.add(\'hidden\');\n            document.getElementById(\'assessment-screen\').classList.remove(\'hidden\');\n            \n            // Display the first question\n            currentQuestionIndex = 0;\n            displayQuestion(currentQuestionIndex);\n            \n            // Start the timer\n            startTime = new Date();\n            timerInterval = setInterval(updateTimer, 1000);\n        }\n\n        // Display a question\n        function displayQuestion(index) {\n            const question = currentQuestions[index];\n            document.getElementById(\'current-question\').textContent = index + 1;\n            document.getElementById(\'question-text\').textContent = question.text;\n            document.getElementById(\'question-domain\').textContent = `Domain: ${question.domain}`;\n            \n            // Update progress bar\n            const progressPercentage = ((index + 1) / currentQuestions.length) * 100;\n            document.getElementById(\'progress-value\').style.width = `${progressPercentage}%`;\n            \n            // Generate options\n            const optionsContainer = document.getElementById(\'options-container\');\n            optionsContainer.innerHTML = \'\';\n            \n            question.options.forEach((option, optionIndex) => {\n                const optionCard = document.createElement(\'div\');\n                optionCard.className = \'option-card p-4\';\n                optionCard.setAttribute(\'data-index\', optionIndex);\n                \n                // If user has already answered this question\n                if (userAnswers[index] !== null) {\n                    if (userAnswers[index] === optionIndex) {\n                        optionCard.classList.add(\'selected\');\n                        if (optionIndex === question.correctAnswer) {\n                            optionCard.classList.add(\'correct\');\n                        } else {\n                            optionCard.classList.add(\'incorrect\');\n                        }\n                    } else if (optionIndex === question.correctAnswer) {\n                        optionCard.classList.add(\'correct\');\n                    }\n                    optionCard.style.pointerEvents = \'none\';\n                } else {\n                    optionCard.addEventListener(\'click\', () => selectOption(optionIndex));\n                }\n                \n                optionCard.innerHTML = `\n                    <div class="flex items-start">\n                        <div class="flex-shrink-0 w-6 h-6 bg-gray-200 rounded-full flex items-center justify-center text-sm mr-3">\n                            ${String.fromCharCode(65 + optionIndex)}\n                        </div>\n                        <span>${option}</span>\n                    </div>\n                `;\n                optionsContainer.appendChild(optionCard);\n            });\n            \n            // Hide feedback container\n            document.getElementById(\'feedback-container\').classList.add(\'hidden\');\n            \n            // Update navigation buttons\n            document.getElementById(\'prev-btn\').disabled = index === 0;\n            document.getElementById(\'next-btn\').disabled = userAnswers[index] === null;\n            \n            if (index === currentQuestions.length - 1 && userAnswers[index] !== null) {\n                document.getElementById(\'next-btn\').textContent = \'Finish\';\n            } else {\n                document.getElementById(\'next-btn\').textContent = \'Next\';\n            }\n        }\n\n        // Select an option\n        function selectOption(optionIndex) {\n            const question = currentQuestions[currentQuestionIndex];\n            userAnswers[currentQuestionIndex] = optionIndex;\n            \n            // Update options UI\n            const options = document.querySelectorAll(\'.option-card\');\n            options.forEach((option, index) => {\n                option.classList.remove(\'selected\', \'correct\', \'incorrect\');\n                option.style.pointerEvents = \'none\';\n                \n                if (index === optionIndex) {\n                    option.classList.add(\'selected\');\n                    if (index === question.correctAnswer) {\n                        option.classList.add(\'correct\');\n                    } else {\n                        option.classList.add(\'incorrect\');\n                    }\n                } else if (index === question.correctAnswer) {\n                    option.classList.add(\'correct\');\n                }\n            });\n            \n            // Show feedback\n            const feedbackContainer = document.getElementById(\'feedback-container\');\n            feedbackContainer.innerHTML = \'\';\n            \n            if (optionIndex === question.correctAnswer) {\n                feedbackContainer.classList.add(\'feedback-correct\');\n                feedbackContainer.classList.remove(\'feedback-incorrect\');\n                feedbackContainer.innerHTML = `\n                    <div class="flex items-start">\n                        <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">\n                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>\n                        </svg>\n                        <div>\n                            <p class="font-semibold text-green-700">Correct!</p>\n                            <p class="text-sm text-gray-600 mt-1">${question.explanation}</p>\n                        </div>\n                    </div>\n                `;\n            } else {\n                feedbackContainer.classList.add(\'feedback-incorrect\');\n                feedbackContainer.classList.remove(\'feedback-correct\');\n                feedbackContainer.innerHTML = `\n                    <div class="flex items-start">\n                        <svg class="w-5 h-5 text-red-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">\n                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>\n                        </svg>\n                        <div>\n                            <p class="font-semibold text-red-700">Incorrect</p>\n                            <p class="text-sm text-gray-600 mt-1">The correct answer is: ${question.options[question.correctAnswer]}</p>\n                            <p class="text-sm text-gray-600 mt-1">${question.explanation}</p>\n                        </div>\n                    </div>\n                `;\n            }\n            feedbackContainer.classList.remove(\'hidden\');\n            \n            // Enable next button\n            document.getElementById(\'next-btn\').disabled = false;\n            \n            // If this is the last question and it\'s answered, show "Finish" on the button\n            if (currentQuestionIndex === currentQuestions.length - 1) {\n                document.getElementById(\'next-btn\').textContent = \'Finish\';\n            }\n        }\n\n        // Navigate to previous or next question\n        function navigateQuestion(direction) {\n            if (direction === 1 && currentQuestionIndex === currentQuestions.length - 1) {\n                // This is the last question, finish the assessment\n                finishAssessment();\n                return;\n            }\n            \n            currentQuestionIndex += direction;\n            displayQuestion(currentQuestionIndex);\n        }\n\n        // Update the timer\n        function updateTimer() {\n            if (!startTime) return;\n            \n            const now = new Date();\n            const elapsedMilliseconds = now - startTime;\n            const elapsedSeconds = Math.floor(elapsedMilliseconds / 1000);\n            const minutes = Math.floor(elapsedSeconds / 60);\n            const seconds = elapsedSeconds % 60;\n            \n            document.getElementById(\'timer\').textContent = `${minutes.toString().padStart(2, \'0\')}:${seconds.toString().padStart(2, \'0\')}`;\n        }\n\n        // Finish the assessment\n        function finishAssessment() {\n            // Stop the timer\n            clearInterval(timerInterval);\n            const endTime = new Date();\n            const totalTimeInSeconds = Math.floor((endTime - startTime) / 1000);\n            const minutes = Math.floor(totalTimeInSeconds / 60);\n            const seconds = totalTimeInSeconds % 60;\n            const timeString = `${minutes.toString().padStart(2, \'0\')}:${seconds.toString().padStart(2, \'0\')}`;\n            \n            // Calculate score\n            let correctCount = 0;\n            userAnswers.forEach((answer, index) => {\n                if (answer === currentQuestions[index].correctAnswer) {\n                    correctCount++;\n                }\n            });\n            \n            const scorePercentage = Math.round((correctCount / currentQuestions.length) * 100);\n            \n            // Calculate domain performance\n            const domainPerformance = {};\n            currentQuestions.forEach((question, index) => {\n                const domain = question.domain;\n                if (!domainPerformance[domain]) {\n                    domainPerformance[domain] = {\n                        total: 0,\n                        correct: 0\n                    };\n                }\n                \n                domainPerformance[domain].total++;\n                if (userAnswers[index] === question.correctAnswer) {\n                    domainPerformance[domain].correct++;\n                }\n            });\n            \n            // Update results UI\n            document.getElementById(\'final-score\').textContent = `${scorePercentage}%`;\n            document.getElementById(\'correct-answers\').textContent = `${correctCount}/${currentQuestions.length}`;\n            document.getElementById(\'time-taken\').textContent = timeString;\n            \n            // Generate domain stats\n            const domainStatsContainer = document.getElementById(\'domain-stats-container\');\n            domainStatsContainer.innerHTML = \'\';\n            \n            Object.entries(domainPerformance).forEach(([domain, stats]) => {\n                const percentage = Math.round((stats.correct / stats.total) * 100);\n                const domainColor = getDomainColorClass(percentage);\n                \n                const domainStat = document.createElement(\'div\');\n                domainStat.className = \'mb-4\';\n                domainStat.innerHTML = `\n                    <div class="flex justify-between items-center mb-1">\n                        <span class="text-sm font-medium text-gray-700">${domain}</span>\n                        <span class="text-sm font-medium ${domainColor.text}">${percentage}%</span>\n                    </div>\n                    <div class="w-full bg-gray-200 rounded-full h-2.5">\n                        <div class="${domainColor.bg} h-2.5 rounded-full" style="width: ${percentage}%"></div>\n                    </div>\n                    <div class="text-xs text-gray-500 mt-1">${stats.correct} / ${stats.total} correct</div>\n                `;\n                domainStatsContainer.appendChild(domainStat);\n            });\n            \n            // Generate recommendations\n            const recommendationsList = document.getElementById(\'recommendations-list\');\n            recommendationsList.innerHTML = \'\';\n            \n            // Find weakest domains\n            const weakDomains = Object.entries(domainPerformance)\n                .map(([domain, stats]) => ({\n                    domain,\n                    percentage: Math.round((stats.correct / stats.total) * 100)\n                }))\n                .sort((a, b) => a.percentage - b.percentage)\n                .slice(0, 3);\n            \n            // Generate recommendations based on weak domains\n            weakDomains.forEach(domainData => {\n                const recommendation = document.createElement(\'li\');\n                recommendation.textContent = getRecommendation(domainData.domain);\n                recommendationsList.appendChild(recommendation);\n            });\n            \n            // Show results screen\n            document.getElementById(\'assessment-screen\').classList.add(\'hidden\');\n            document.getElementById(\'results-screen\').classList.remove(\'hidden\');\n            \n            // Save results to localStorage for detailed view\n            const resultsData = {\n                score: scorePercentage,\n                correctAnswers: correctCount,\n                totalQuestions: currentQuestions.length,\n                completionTime: timeString,\n                domains: Object.entries(domainPerformance).map(([domain, stats]) => ({\n                    name: domain,\n                    score: Math.round((stats.correct / stats.total) * 100)\n                })),\n                recommendations: Array.from(recommendationsList.children).map(li => li.textContent)\n            };\n            \n            localStorage.setItem(\'assessmentResults\', JSON.stringify(resultsData));\n        }\n\n        // Get domain color class based on score\n        function getDomainColorClass(score) {\n            if (score >= 80) {\n                return { bg: \'bg-green-600\', text: \'text-green-600\' };\n            } else if (score >= 70) {\n                return { bg: \'bg-blue-600\', text: \'text-blue-600\' };\n            } else if (score >= 60) {\n                return { bg: \'bg-yellow-600\', text: \'text-yellow-600\' };\n            } else {\n                return { bg: \'bg-red-600\', text: \'text-red-600\' };\n            }\n        }\n\n        // Get recommendation based on domain\n        function getRecommendation(domain) {\n            const recommendations = {\n                "Child Development Theories": "Review key child development theories such as Piaget\'s stages and Vygotsky\'s zone of proximal development.",\n                "Curriculum Approaches": "Study different curriculum approaches, focusing on child-centered methods like Reggio Emilia and play-based learning.",\n                "Assessment Methods": "Explore authentic assessment techniques to better document and understand children\'s learning.",\n                "Quality Measurement": "Familiarize yourself with quality measurement tools like CLASS and apply their principles in your practice.",\n                "Health & Safety": "Review current health and safety guidelines and best practices for early childhood settings.",\n                "Developmentally Appropriate Practice": "Deepen your understanding of how to apply developmentally appropriate practices across all areas.",\n                "Teaching Strategies": "Focus on scaffolding techniques and differentiating instruction for diverse learners.",\n                "Guidance & Behavior Management": "Study positive guidance strategies and techniques for supporting children\'s self-regulation.",\n                "Communication & Language": "Practice using open-ended questions and strategies to extend children\'s language development.",\n                "Literacy Development": "Explore research-based approaches to emergent literacy and methods for rich literacy experiences.",\n                "Family Engagement": "Develop strategies for meaningful family partnerships that value diverse cultures and knowledge.",\n                "Inclusion & Diversity": "Build skills in creating inclusive environments and adapting activities for all children.",\n                "Cognitive Development": "Focus on understanding and supporting the development of executive function skills and mathematical thinking.",\n                "Language Development": "Learn more about supporting dual language learners and language acquisition stages.",\n                "Learning Environment": "Study how to design engaging, well-organized learning spaces that promote all aspects of development.",\n                "Observation & Assessment": "Practice documentation techniques to make children\'s learning visible and inform planning.",\n                "Social-Emotional Development": "Enhance your knowledge of strategies to support resilience and social-emotional skills.",\n                "Physical Development": "Ensure sufficient opportunities for both fine and gross motor development throughout the day.",\n                "Technology Integration": "Learn about developmentally appropriate technology use that enhances rather than replaces hands-on learning.",\n                "Family & Community Engagement": "Explore the \'funds of knowledge\' approach to better incorporate family cultures and expertise.",\n                "Play & Learning": "Deepen your understanding of how to support and extend learning through different types of play."\n            };\n            \n            return recommendations[domain] || `Focus on building your knowledge in ${domain}.`;\n        }\n\n        // Save results and redirect to detailed view\n        function saveAndViewResults() {\n            window.location.href = "/assessment-results.html";\n        }\n\n        // Restart the assessment\n        function restartAssessment() {\n            document.getElementById(\'results-screen\').classList.add(\'hidden\');\n            document.getElementById(\'setup-screen\').classList.remove(\'hidden\');\n            document.getElementById(\'name\').value = \'\';\n            document.getElementById(\'email\').value = \'\';\n        }\n     $X $X. ... .$V = "..." $X. ... .innerHTML = ... $X. ... .outerHTML = ... javascript <script ...>\n        // Assessment data\n        const allQuestions = [\n            {\n                id: 1,\n                text: "Which of the following best describes the zone of proximal development?",\n                domain: "Child Development Theories",\n                options: [\n                    "The area where a child can complete tasks independently",\n                    "The difference between what a child can do with help and what they can do independently",\n                    "The stage where children develop fine motor skills",\n                    "The period when children learn to socialize with peers"\n                ],\n                correctAnswer: 1,\n                explanation: "The zone of proximal development (ZPD) is the difference between what a learner can do without help and what they can achieve with guidance from a more knowledgeable person."\n            },\n            {\n                id: 2,\n                text: "Which approach emphasizes the importance of child-directed play and exploration?",\n                domain: "Curriculum Approaches",\n                options: [\n                    "Direct instruction",\n                    "Reggio Emilia",\n                    "Academic-focused curriculum",\n                    "Teacher-centered learning"\n                ],\n                correctAnswer: 1,\n                explanation: "The Reggio Emilia approach views children as capable, curious individuals and emphasizes child-directed exploration and discovery."\n            },\n            {\n                id: 3,\n                text: "What is the primary purpose of formative assessment in early childhood education?",\n                domain: "Assessment Methods",\n                options: [\n                    "To assign grades to children",\n                    "To compare children\'s abilities",\n                    "To inform ongoing teaching and learning",\n                    "To determine readiness for elementary school"\n                ],\n                correctAnswer: 2,\n                explanation: "Formative assessment is used to monitor student learning and provide ongoing feedback to improve teaching and learning processes."\n            },\n            {\n                id: 4,\n                text: "Which of the following is NOT typically considered one of the CLASS (Classroom Assessment Scoring System) domains?",\n                domain: "Quality Measurement",\n                options: [\n                    "Emotional Support",\n                    "Classroom Organization",\n                    "Instructional Support",\n                    "Physical Environment"\n                ],\n                correctAnswer: 3,\n                explanation: "The CLASS assessment tool has three main domains: Emotional Support, Classroom Organization, and Instructional Support. Physical Environment is not a CLASS domain."\n            },\n            {\n                id: 5,\n                text: "What is the recommended adult-to-child ratio for 3-year-olds according to NAEYC accreditation standards?",\n                domain: "Health & Safety",\n                options: [\n                    "1:15",\n                    "1:10",\n                    "1:8",\n                    "1:6"\n                ],\n                correctAnswer: 2,\n                explanation: "NAEYC recommends a ratio of 1 adult for every 8 three-year-olds with a maximum group size of 16."\n            },\n            {\n                id: 6,\n                text: "Which of the following is a key component of developmentally appropriate practice (DAP)?",\n                domain: "Developmentally Appropriate Practice",\n                options: [\n                    "Using the same approach for all children regardless of development",\n                    "Making decisions based on what children of a certain age should be able to do",\n                    "Considering the needs and capabilities of each individual child",\n                    "Following a strict curriculum regardless of children\'s interests"\n                ],\n                correctAnswer: 2,\n                explanation: "DAP requires teachers to meet children where they are, considering each child\'s age, experience, abilities, and interests."\n            },\n            {\n                id: 7,\n                text: "Which of these is an example of scaffolding in early childhood education?",\n                domain: "Teaching Strategies",\n                options: [\n                    "Giving a child a complex task and expecting them to figure it out independently",\n                    "Providing hints and supports to help a child complete a task they couldn\'t do alone",\n                    "Completing difficult tasks for children to demonstrate proper techniques",\n                    "Letting children only do activities they have already mastered"\n                ],\n                correctAnswer: 1,\n                explanation: "Scaffolding involves providing temporary support to help children master new skills, gradually removing the support as competence increases."\n            },\n            {\n                id: 8,\n                text: "What is the appropriate way to handle a situation where a child hits another child?",\n                domain: "Guidance & Behavior Management",\n                options: [\n                    "Ignore the behavior to avoid giving negative attention",\n                    "Immediately put the child in time-out without discussion",\n                    "Calmly stop the behavior, acknowledge feelings, and teach appropriate alternatives",\n                    "Ask the hit child to hit back so they learn a lesson"\n                ],\n                correctAnswer: 2,\n                explanation: "Effective guidance involves setting clear limits, acknowledging feelings, and teaching children alternative ways to express emotions."\n            },\n            {\n                id: 9,\n                text: "Which of the following would be considered an open-ended question?",\n                domain: "Communication & Language",\n                options: [\n                    "Did you like the story?",\n                    "Can you count to 10?",\n                    "What do you think will happen next in the story?",\n                    "Is this a triangle?"\n                ],\n                correctAnswer: 2,\n                explanation: "Open-ended questions cannot be answered with a simple \'yes\' or \'no\' and encourage children to think critically and express their thoughts."\n            },\n            {\n                id: 10,\n                text: "According to Piaget, in which stage do children develop object permanence?",\n                domain: "Child Development Theories",\n                options: [\n                    "Sensorimotor stage",\n                    "Preoperational stage",\n                    "Concrete operational stage",\n                    "Formal operational stage"\n                ],\n                correctAnswer: 0,\n                explanation: "Object permanence typically develops during the sensorimotor stage (birth to 2 years), when children begin to understand that objects continue to exist even when they cannot be seen."\n            },\n            {\n                id: 11,\n                text: "Which of the following practices best supports emergent literacy?",\n                domain: "Literacy Development",\n                options: [\n                    "Daily handwriting worksheets",\n                    "Flashcards with sight words",\n                    "Reading aloud and engaging children in conversations about stories",\n                    "Teaching the alphabet through rote memorization"\n                ],\n                correctAnswer: 2,\n                explanation: "Emergent literacy is best supported through meaningful interactions with text, including reading aloud, discussing stories, and incorporating literacy into play."\n            },\n            {\n                id: 12,\n                text: "What is the most effective way to engage families in children\'s learning?",\n                domain: "Family Engagement",\n                options: [\n                    "Sending home weekly newsletters about classroom activities",\n                    "Creating opportunities for families to share their expertise and culture in the classroom",\n                    "Having formal parent-teacher conferences twice a year",\n                    "Requiring parents to complete homework assignments with their children"\n                ],\n                correctAnswer: 1,\n                explanation: "Effective family engagement involves creating meaningful partnerships where families\' knowledge and cultures are valued and incorporated into the learning environment."\n            },\n            {\n                id: 13,\n                text: "Which of the following is the best example of an inclusive practice in early childhood education?",\n                domain: "Inclusion & Diversity",\n                options: [\n                    "Grouping children by ability for all activities",\n                    "Adapting materials and strategies to ensure all children can participate",\n                    "Providing separate activities for children with special needs",\n                    "Focusing equally on all cultural holidays throughout the year"\n                ],\n                correctAnswer: 1,\n                explanation: "Inclusive practices involve making adaptations and providing support so that all children can participate meaningfully in the same activities and routines."\n            },\n            {\n                id: 14,\n                text: "Which mathematical concept typically develops first in young children?",\n                domain: "Cognitive Development",\n                options: [\n                    "Multiplication",\n                    "One-to-one correspondence",\n                    "Fractions",\n                    "Algebraic thinking"\n                ],\n                correctAnswer: 1,\n                explanation: "One-to-one correspondence (matching one object to one object or person) is a foundational mathematical concept that typically develops in early childhood."\n            },\n            {\n                id: 15,\n                text: "Which of these is the most appropriate way to support a dual language learner in the classroom?",\n                domain: "Language Development",\n                options: [\n                    "Discourage the use of their home language to accelerate English acquisition",\n                    "Separate them from English-speaking peers to provide specialized instruction",\n                    "Provide visual supports and incorporate words from their home language",\n                    "Speak slowly and loudly to ensure comprehension"\n                ],\n                correctAnswer: 2,\n                explanation: "Supporting dual language learners involves valuing their home language, providing visual cues, and creating a language-rich environment that incorporates elements of their home language."\n            },\n            {\n                id: 16,\n                text: "Which of the following best describes the purpose of learning centers in a preschool classroom?",\n                domain: "Learning Environment",\n                options: [\n                    "To keep children busy while the teacher works with small groups",\n                    "To provide opportunities for choice, exploration, and discovery",\n                    "To prepare children for the structure of elementary school",\n                    "To assess children\'s ability to follow directions"\n                ],\n                correctAnswer: 1,\n                explanation: "Learning centers are designed to promote active engagement, choice, peer interaction, and exploration across different developmental domains."\n            },\n            {\n                id: 17,\n                text: "What is the primary purpose of documentation in Reggio Emilia-inspired programs?",\n                domain: "Observation & Assessment",\n                options: [\n                    "To evaluate children\'s academic progress",\n                    "To create portfolios to share with parents",\n                    "To make children\'s thinking and learning visible",\n                    "To fulfill licensing requirements"\n                ],\n                correctAnswer: 2,\n                explanation: "In Reggio Emilia, documentation serves to make children\'s thoughts, theories, and learning processes visible, helping teachers and children reflect on and extend learning."\n            },\n            {\n                id: 18,\n                text: "Which of the following is NOT considered a protective factor in building children\'s resilience?",\n                domain: "Social-Emotional Development",\n                options: [\n                    "Secure attachment relationships",\n                    "Self-regulation skills",\n                    "Problem-solving abilities",\n                    "Highly structured adult-directed activities"\n                ],\n                correctAnswer: 3,\n                explanation: "Protective factors that build resilience include supportive relationships, self-regulation, problem-solving skills, and opportunities for children to develop a sense of mastery through appropriate challenges."\n            },\n            {\n                id: 19,\n                text: "According to early childhood education best practices, what is the recommended daily minimum amount of time for outdoor play?",\n                domain: "Physical Development",\n                options: [\n                    "15 minutes",\n                    "30 minutes",\n                    "60 minutes",\n                    "90 minutes"\n                ],\n                correctAnswer: 2,\n                explanation: "Best practice guidelines suggest a minimum of 60 minutes of outdoor play daily for young children, weather permitting, to support physical development and overall well-being."\n            },\n            {\n                id: 20,\n                text: "Which of the following best describes appropriate technology use in early childhood settings?",\n                domain: "Technology Integration",\n                options: [\n                    "Children should have unlimited access to technology throughout the day",\n                    "Technology should be avoided entirely until age 7",\n                    "Technology should supplement, not replace, hands-on experiences and face-to-face interactions",\n                    "Children should use technology primarily for entertainment purposes"\n                ],\n                correctAnswer: 2,\n                explanation: "Developmentally appropriate technology use includes intentional selection of digital tools that enhance learning, used with adult guidance and in balance with other activities."\n            },\n            {\n                id: 21,\n                text: "Which is the best example of an authentic assessment approach?",\n                domain: "Assessment Methods",\n                options: [\n                    "Weekly spelling tests",\n                    "Standardized readiness tests",\n                    "Documentation of children\'s work and play over time",\n                    "Comparing all children to age-based milestones"\n                ],\n                correctAnswer: 2,\n                explanation: "Authentic assessment involves documenting children\'s actual work, play, and interactions in natural settings over time to understand their development and learning."\n            },\n            {\n                id: 22,\n                text: "How does the concept of \'funds of knowledge\' relate to working with diverse families?",\n                domain: "Family & Community Engagement",\n                options: [\n                    "It refers to the financial resources families can contribute to the program",\n                    "It recognizes the knowledge, skills and cultural practices of families as valuable resources",\n                    "It describes the educational background of family members",\n                    "It tracks how much information families retain from parent workshops"\n                ],\n                correctAnswer: 1,\n                explanation: "The \'funds of knowledge\' approach recognizes that families possess valuable knowledge, skills, and cultural practices that should be incorporated into and respected within educational settings."\n            },\n            {\n                id: 23,\n                text: "What is the primary purpose of project-based learning in early childhood?",\n                domain: "Curriculum Approaches",\n                options: [\n                    "To teach specific academic content in an organized sequence",\n                    "To prepare children for standardized testing",\n                    "To engage children in in-depth investigation of topics of interest",\n                    "To complete products for display in the classroom"\n                ],\n                correctAnswer: 2,\n                explanation: "Project-based learning engages children in extended, in-depth investigations of topics of interest, promoting deep learning, collaboration, and development across domains."\n            },\n            {\n                id: 24,\n                text: "Which of the following statements about executive function skills is TRUE?",\n                domain: "Cognitive Development",\n                options: [\n                    "They develop naturally and cannot be influenced by the environment",\n                    "They include working memory, inhibitory control, and cognitive flexibility",\n                    "They are fully developed by age 3",\n                    "They are only important for academic learning, not social skills"\n                ],\n                correctAnswer: 1,\n                explanation: "Executive function skills include working memory, inhibitory control, and cognitive flexibility, and they develop gradually throughout childhood with appropriate support and experiences."\n            },\n            {\n                id: 25,\n                text: "What is the most appropriate way to support socio-dramatic play in a preschool classroom?",\n                domain: "Play & Learning",\n                options: [\n                    "Assign roles to ensure all children participate equally",\n                    "Provide open-ended materials and appropriate time and space",\n                    "Require a specific theme to ensure educational content",\n                    "Have adults direct the play to maintain order"\n                ],\n                correctAnswer: 1,\n                explanation: "Supporting socio-dramatic play involves providing open-ended materials, sufficient time and space, and appropriate adult scaffolding without taking over or directing the play."\n            }\n        ];\n\n        let assessmentType = \'basic\';\n        let currentQuestions = [];\n        let currentQuestionIndex = 0;\n        let userAnswers = [];\n        let startTime = null;\n        let timerInterval = null;\n\n        // Set assessment type\n        function setAssessmentType(type) {\n            assessmentType = type;\n            const basicOption = document.querySelector(\'div[onclick="setAssessmentType(\\\'basic\\\')"]\');\n            const comprehensiveOption = document.querySelector(\'div[onclick="setAssessmentType(\\\'comprehensive\\\')"]\');\n            \n            basicOption.classList.remove(\'border-indigo-500\', \'bg-indigo-50\');\n            comprehensiveOption.classList.remove(\'border-indigo-500\', \'bg-indigo-50\');\n            \n            if (type === \'basic\') {\n                basicOption.classList.add(\'border-indigo-500\', \'bg-indigo-50\');\n            } else {\n                comprehensiveOption.classList.add(\'border-indigo-500\', \'bg-indigo-50\');\n            }\n        }\n\n        // Start the assessment\n        function startAssessment() {\n            // Get user info\n            const userName = document.getElementById(\'name\').value;\n            const userEmail = document.getElementById(\'email\').value;\n            \n            // Select questions based on assessment type\n            if (assessmentType === \'basic\') {\n                currentQuestions = allQuestions.slice(0, 15);\n                document.getElementById(\'total-questions\').textContent = \'15\';\n            } else {\n                currentQuestions = allQuestions;\n                document.getElementById(\'total-questions\').textContent = \'25\';\n            }\n            \n            // Initialize user answers array\n            userAnswers = Array(currentQuestions.length).fill(null);\n            \n            // Show the assessment screen\n            document.getElementById(\'setup-screen\').classList.add(\'hidden\');\n            document.getElementById(\'assessment-screen\').classList.remove(\'hidden\');\n            \n            // Display the first question\n            currentQuestionIndex = 0;\n            displayQuestion(currentQuestionIndex);\n            \n            // Start the timer\n            startTime = new Date();\n            timerInterval = setInterval(updateTimer, 1000);\n        }\n\n        // Display a question\n        function displayQuestion(index) {\n            const question = currentQuestions[index];\n            document.getElementById(\'current-question\').textContent = index + 1;\n            document.getElementById(\'question-text\').textContent = question.text;\n            document.getElementById(\'question-domain\').textContent = `Domain: ${question.domain}`;\n            \n            // Update progress bar\n            const progressPercentage = ((index + 1) / currentQuestions.length) * 100;\n            document.getElementById(\'progress-value\').style.width = `${progressPercentage}%`;\n            \n            // Generate options\n            const optionsContainer = document.getElementById(\'options-container\');\n            optionsContainer.innerHTML = \'\';\n            \n            question.options.forEach((option, optionIndex) => {\n                const optionCard = document.createElement(\'div\');\n                optionCard.className = \'option-card p-4\';\n                optionCard.setAttribute(\'data-index\', optionIndex);\n                \n                // If user has already answered this question\n                if (userAnswers[index] !== null) {\n                    if (userAnswers[index] === optionIndex) {\n                        optionCard.classList.add(\'selected\');\n                        if (optionIndex === question.correctAnswer) {\n                            optionCard.classList.add(\'correct\');\n                        } else {\n                            optionCard.classList.add(\'incorrect\');\n                        }\n                    } else if (optionIndex === question.correctAnswer) {\n                        optionCard.classList.add(\'correct\');\n                    }\n                    optionCard.style.pointerEvents = \'none\';\n                } else {\n                    optionCard.addEventListener(\'click\', () => selectOption(optionIndex));\n                }\n                \n                optionCard.innerHTML = `\n                    <div class="flex items-start">\n                        <div class="flex-shrink-0 w-6 h-6 bg-gray-200 rounded-full flex items-center justify-center text-sm mr-3">\n                            ${String.fromCharCode(65 + optionIndex)}\n                        </div>\n                        <span>${option}</span>\n                    </div>\n                `;\n                optionsContainer.appendChild(optionCard);\n            });\n            \n            // Hide feedback container\n            document.getElementById(\'feedback-container\').classList.add(\'hidden\');\n            \n            // Update navigation buttons\n            document.getElementById(\'prev-btn\').disabled = index === 0;\n            document.getElementById(\'next-btn\').disabled = userAnswers[index] === null;\n            \n            if (index === currentQuestions.length - 1 && userAnswers[index] !== null) {\n                document.getElementById(\'next-btn\').textContent = \'Finish\';\n            } else {\n                document.getElementById(\'next-btn\').textContent = \'Next\';\n            }\n        }\n\n        // Select an option\n        function selectOption(optionIndex) {\n            const question = currentQuestions[currentQuestionIndex];\n            userAnswers[currentQuestionIndex] = optionIndex;\n            \n            // Update options UI\n            const options = document.querySelectorAll(\'.option-card\');\n            options.forEach((option, index) => {\n                option.classList.remove(\'selected\', \'correct\', \'incorrect\');\n                option.style.pointerEvents = \'none\';\n                \n                if (index === optionIndex) {\n                    option.classList.add(\'selected\');\n                    if (index === question.correctAnswer) {\n                        option.classList.add(\'correct\');\n                    } else {\n                        option.classList.add(\'incorrect\');\n                    }\n                } else if (index === question.correctAnswer) {\n                    option.classList.add(\'correct\');\n                }\n            });\n            \n            // Show feedback\n            const feedbackContainer = document.getElementById(\'feedback-container\');\n            feedbackContainer.innerHTML = \'\';\n            \n            if (optionIndex === question.correctAnswer) {\n                feedbackContainer.classList.add(\'feedback-correct\');\n                feedbackContainer.classList.remove(\'feedback-incorrect\');\n                feedbackContainer.innerHTML = `\n                    <div class="flex items-start">\n                        <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">\n                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>\n                        </svg>\n                        <div>\n                            <p class="font-semibold text-green-700">Correct!</p>\n                            <p class="text-sm text-gray-600 mt-1">${question.explanation}</p>\n                        </div>\n                    </div>\n                `;\n            } else {\n                feedbackContainer.classList.add(\'feedback-incorrect\');\n                feedbackContainer.classList.remove(\'feedback-correct\');\n                feedbackContainer.innerHTML = `\n                    <div class="flex items-start">\n                        <svg class="w-5 h-5 text-red-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">\n                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>\n                        </svg>\n                        <div>\n                            <p class="font-semibold text-red-700">Incorrect</p>\n                            <p class="text-sm text-gray-600 mt-1">The correct answer is: ${question.options[question.correctAnswer]}</p>\n                            <p class="text-sm text-gray-600 mt-1">${question.explanation}</p>\n                        </div>\n                    </div>\n                `;\n            }\n            feedbackContainer.classList.remove(\'hidden\');\n            \n            // Enable next button\n            document.getElementById(\'next-btn\').disabled = false;\n            \n            // If this is the last question and it\'s answered, show "Finish" on the button\n            if (currentQuestionIndex === currentQuestions.length - 1) {\n                document.getElementById(\'next-btn\').textContent = \'Finish\';\n            }\n        }\n\n        // Navigate to previous or next question\n        function navigateQuestion(direction) {\n            if (direction === 1 && currentQuestionIndex === currentQuestions.length - 1) {\n                // This is the last question, finish the assessment\n                finishAssessment();\n                return;\n            }\n            \n            currentQuestionIndex += direction;\n            displayQuestion(currentQuestionIndex);\n        }\n\n        // Update the timer\n        function updateTimer() {\n            if (!startTime) return;\n            \n            const now = new Date();\n            const elapsedMilliseconds = now - startTime;\n            const elapsedSeconds = Math.floor(elapsedMilliseconds / 1000);\n            const minutes = Math.floor(elapsedSeconds / 60);\n            const seconds = elapsedSeconds % 60;\n            \n            document.getElementById(\'timer\').textContent = `${minutes.toString().padStart(2, \'0\')}:${seconds.toString().padStart(2, \'0\')}`;\n        }\n\n        // Finish the assessment\n        function finishAssessment() {\n            // Stop the timer\n            clearInterval(timerInterval);\n            const endTime = new Date();\n            const totalTimeInSeconds = Math.floor((endTime - startTime) / 1000);\n            const minutes = Math.floor(totalTimeInSeconds / 60);\n            const seconds = totalTimeInSeconds % 60;\n            const timeString = `${minutes.toString().padStart(2, \'0\')}:${seconds.toString().padStart(2, \'0\')}`;\n            \n            // Calculate score\n            let correctCount = 0;\n            userAnswers.forEach((answer, index) => {\n                if (answer === currentQuestions[index].correctAnswer) {\n                    correctCount++;\n                }\n            });\n            \n            const scorePercentage = Math.round((correctCount / currentQuestions.length) * 100);\n            \n            // Calculate domain performance\n            const domainPerformance = {};\n            currentQuestions.forEach((question, index) => {\n                const domain = question.domain;\n                if (!domainPerformance[domain]) {\n                    domainPerformance[domain] = {\n                        total: 0,\n                        correct: 0\n                    };\n                }\n                \n                domainPerformance[domain].total++;\n                if (userAnswers[index] === question.correctAnswer) {\n                    domainPerformance[domain].correct++;\n                }\n            });\n            \n            // Update results UI\n            document.getElementById(\'final-score\').textContent = `${scorePercentage}%`;\n            document.getElementById(\'correct-answers\').textContent = `${correctCount}/${currentQuestions.length}`;\n            document.getElementById(\'time-taken\').textContent = timeString;\n            \n            // Generate domain stats\n            const domainStatsContainer = document.getElementById(\'domain-stats-container\');\n            domainStatsContainer.innerHTML = \'\';\n            \n            Object.entries(domainPerformance).forEach(([domain, stats]) => {\n                const percentage = Math.round((stats.correct / stats.total) * 100);\n                const domainColor = getDomainColorClass(percentage);\n                \n                const domainStat = document.createElement(\'div\');\n                domainStat.className = \'mb-4\';\n                domainStat.innerHTML = `\n                    <div class="flex justify-between items-center mb-1">\n                        <span class="text-sm font-medium text-gray-700">${domain}</span>\n                        <span class="text-sm font-medium ${domainColor.text}">${percentage}%</span>\n                    </div>\n                    <div class="w-full bg-gray-200 rounded-full h-2.5">\n                        <div class="${domainColor.bg} h-2.5 rounded-full" style="width: ${percentage}%"></div>\n                    </div>\n                    <div class="text-xs text-gray-500 mt-1">${stats.correct} / ${stats.total} correct</div>\n                `;\n                domainStatsContainer.appendChild(domainStat);\n            });\n            \n            // Generate recommendations\n            const recommendationsList = document.getElementById(\'recommendations-list\');\n            recommendationsList.innerHTML = \'\';\n            \n            // Find weakest domains\n            const weakDomains = Object.entries(domainPerformance)\n                .map(([domain, stats]) => ({\n                    domain,\n                    percentage: Math.round((stats.correct / stats.total) * 100)\n                }))\n                .sort((a, b) => a.percentage - b.percentage)\n                .slice(0, 3);\n            \n            // Generate recommendations based on weak domains\n            weakDomains.forEach(domainData => {\n                const recommendation = document.createElement(\'li\');\n                recommendation.textContent = getRecommendation(domainData.domain);\n                recommendationsList.appendChild(recommendation);\n            });\n            \n            // Show results screen\n            document.getElementById(\'assessment-screen\').classList.add(\'hidden\');\n            document.getElementById(\'results-screen\').classList.remove(\'hidden\');\n            \n            // Save results to localStorage for detailed view\n            const resultsData = {\n                score: scorePercentage,\n                correctAnswers: correctCount,\n                totalQuestions: currentQuestions.length,\n                completionTime: timeString,\n                domains: Object.entries(domainPerformance).map(([domain, stats]) => ({\n                    name: domain,\n                    score: Math.round((stats.correct / stats.total) * 100)\n                })),\n                recommendations: Array.from(recommendationsList.children).map(li => li.textContent)\n            };\n            \n            localStorage.setItem(\'assessmentResults\', JSON.stringify(resultsData));\n        }\n\n        // Get domain color class based on score\n        function getDomainColorClass(score) {\n            if (score >= 80) {\n                return { bg: \'bg-green-600\', text: \'text-green-600\' };\n            } else if (score >= 70) {\n                return { bg: \'bg-blue-600\', text: \'text-blue-600\' };\n            } else if (score >= 60) {\n                return { bg: \'bg-yellow-600\', text: \'text-yellow-600\' };\n            } else {\n                return { bg: \'bg-red-600\', text: \'text-red-600\' };\n            }\n        }\n\n        // Get recommendation based on domain\n        function getRecommendation(domain) {\n            const recommendations = {\n                "Child Development Theories": "Review key child development theories such as Piaget\'s stages and Vygotsky\'s zone of proximal development.",\n                "Curriculum Approaches": "Study different curriculum approaches, focusing on child-centered methods like Reggio Emilia and play-based learning.",\n                "Assessment Methods": "Explore authentic assessment techniques to better document and understand children\'s learning.",\n                "Quality Measurement": "Familiarize yourself with quality measurement tools like CLASS and apply their principles in your practice.",\n                "Health & Safety": "Review current health and safety guidelines and best practices for early childhood settings.",\n                "Developmentally Appropriate Practice": "Deepen your understanding of how to apply developmentally appropriate practices across all areas.",\n                "Teaching Strategies": "Focus on scaffolding techniques and differentiating instruction for diverse learners.",\n                "Guidance & Behavior Management": "Study positive guidance strategies and techniques for supporting children\'s self-regulation.",\n                "Communication & Language": "Practice using open-ended questions and strategies to extend children\'s language development.",\n                "Literacy Development": "Explore research-based approaches to emergent literacy and methods for rich literacy experiences.",\n                "Family Engagement": "Develop strategies for meaningful family partnerships that value diverse cultures and knowledge.",\n                "Inclusion & Diversity": "Build skills in creating inclusive environments and adapting activities for all children.",\n                "Cognitive Development": "Focus on understanding and supporting the development of executive function skills and mathematical thinking.",\n                "Language Development": "Learn more about supporting dual language learners and language acquisition stages.",\n                "Learning Environment": "Study how to design engaging, well-organized learning spaces that promote all aspects of development.",\n                "Observation & Assessment": "Practice documentation techniques to make children\'s learning visible and inform planning.",\n                "Social-Emotional Development": "Enhance your knowledge of strategies to support resilience and social-emotional skills.",\n                "Physical Development": "Ensure sufficient opportunities for both fine and gross motor development throughout the day.",\n                "Technology Integration": "Learn about developmentally appropriate technology use that enhances rather than replaces hands-on learning.",\n                "Family & Community Engagement": "Explore the \'funds of knowledge\' approach to better incorporate family cultures and expertise.",\n                "Play & Learning": "Deepen your understanding of how to support and extend learning through different types of play."\n            };\n            \n            return recommendations[domain] || `Focus on building your knowledge in ${domain}.`;\n        }\n\n        // Save results and redirect to detailed view\n        function saveAndViewResults() {\n            window.location.href = "/assessment-results.html";\n        }\n\n        // Restart the assessment\n        function restartAssessment() {\n            document.getElementById(\'results-screen\').classList.add(\'hidden\');\n            document.getElementById(\'setup-screen\').classList.remove(\'hidden\');\n            document.getElementById(\'name\').value = \'\';\n            document.getElementById(\'email\').value = \'\';\n        }\n    </script>\n', PosixPath('backup/cleanup-phase1/assessment.html'), 'config..semgrep.vendored-rules.html.security.audit.insecure-document-method') match_id = 18b8d6cabeafeca15d694504979ceaab571749bd5a91bde4fe7a271dda2796659d1010ff4a3d6a9f86bcccd49139e0de1c66206ad39b6547281e462f651b97a2_0
2025-07-06 02:31:06,019 - semgrep.rule_match - DEBUG - match_key = ('\n        // Assessment data\n        const allQuestions = [\n            {\n                id: 1,\n                text: "Which of the following best describes the zone of proximal development?",\n                domain: "Child Development Theories",\n                options: [\n                    "The area where a child can complete tasks independently",\n                    "The difference between what a child can do with help and what they can do independently",\n                    "The stage where children develop fine motor skills",\n                    "The period when children learn to socialize with peers"\n                ],\n                correctAnswer: 1,\n                explanation: "The zone of proximal development (ZPD) is the difference between what a learner can do without help and what they can achieve with guidance from a more knowledgeable person."\n            },\n            {\n                id: 2,\n                text: "Which approach emphasizes the importance of child-directed play and exploration?",\n                domain: "Curriculum Approaches",\n                options: [\n                    "Direct instruction",\n                    "Reggio Emilia",\n                    "Academic-focused curriculum",\n                    "Teacher-centered learning"\n                ],\n                correctAnswer: 1,\n                explanation: "The Reggio Emilia approach views children as capable, curious individuals and emphasizes child-directed exploration and discovery."\n            },\n            {\n                id: 3,\n                text: "What is the primary purpose of formative assessment in early childhood education?",\n                domain: "Assessment Methods",\n                options: [\n                    "To assign grades to children",\n                    "To compare children\'s abilities",\n                    "To inform ongoing teaching and learning",\n                    "To determine readiness for elementary school"\n                ],\n                correctAnswer: 2,\n                explanation: "Formative assessment is used to monitor student learning and provide ongoing feedback to improve teaching and learning processes."\n            },\n            {\n                id: 4,\n                text: "Which of the following is NOT typically considered one of the CLASS (Classroom Assessment Scoring System) domains?",\n                domain: "Quality Measurement",\n                options: [\n                    "Emotional Support",\n                    "Classroom Organization",\n                    "Instructional Support",\n                    "Physical Environment"\n                ],\n                correctAnswer: 3,\n                explanation: "The CLASS assessment tool has three main domains: Emotional Support, Classroom Organization, and Instructional Support. Physical Environment is not a CLASS domain."\n            },\n            {\n                id: 5,\n                text: "What is the recommended adult-to-child ratio for 3-year-olds according to NAEYC accreditation standards?",\n                domain: "Health & Safety",\n                options: [\n                    "1:15",\n                    "1:10",\n                    "1:8",\n                    "1:6"\n                ],\n                correctAnswer: 2,\n                explanation: "NAEYC recommends a ratio of 1 adult for every 8 three-year-olds with a maximum group size of 16."\n            },\n            {\n                id: 6,\n                text: "Which of the following is a key component of developmentally appropriate practice (DAP)?",\n                domain: "Developmentally Appropriate Practice",\n                options: [\n                    "Using the same approach for all children regardless of development",\n                    "Making decisions based on what children of a certain age should be able to do",\n                    "Considering the needs and capabilities of each individual child",\n                    "Following a strict curriculum regardless of children\'s interests"\n                ],\n                correctAnswer: 2,\n                explanation: "DAP requires teachers to meet children where they are, considering each child\'s age, experience, abilities, and interests."\n            },\n            {\n                id: 7,\n                text: "Which of these is an example of scaffolding in early childhood education?",\n                domain: "Teaching Strategies",\n                options: [\n                    "Giving a child a complex task and expecting them to figure it out independently",\n                    "Providing hints and supports to help a child complete a task they couldn\'t do alone",\n                    "Completing difficult tasks for children to demonstrate proper techniques",\n                    "Letting children only do activities they have already mastered"\n                ],\n                correctAnswer: 1,\n                explanation: "Scaffolding involves providing temporary support to help children master new skills, gradually removing the support as competence increases."\n            },\n            {\n                id: 8,\n                text: "What is the appropriate way to handle a situation where a child hits another child?",\n                domain: "Guidance & Behavior Management",\n                options: [\n                    "Ignore the behavior to avoid giving negative attention",\n                    "Immediately put the child in time-out without discussion",\n                    "Calmly stop the behavior, acknowledge feelings, and teach appropriate alternatives",\n                    "Ask the hit child to hit back so they learn a lesson"\n                ],\n                correctAnswer: 2,\n                explanation: "Effective guidance involves setting clear limits, acknowledging feelings, and teaching children alternative ways to express emotions."\n            },\n            {\n                id: 9,\n                text: "Which of the following would be considered an open-ended question?",\n                domain: "Communication & Language",\n                options: [\n                    "Did you like the story?",\n                    "Can you count to 10?",\n                    "What do you think will happen next in the story?",\n                    "Is this a triangle?"\n                ],\n                correctAnswer: 2,\n                explanation: "Open-ended questions cannot be answered with a simple \'yes\' or \'no\' and encourage children to think critically and express their thoughts."\n            },\n            {\n                id: 10,\n                text: "According to Piaget, in which stage do children develop object permanence?",\n                domain: "Child Development Theories",\n                options: [\n                    "Sensorimotor stage",\n                    "Preoperational stage",\n                    "Concrete operational stage",\n                    "Formal operational stage"\n                ],\n                correctAnswer: 0,\n                explanation: "Object permanence typically develops during the sensorimotor stage (birth to 2 years), when children begin to understand that objects continue to exist even when they cannot be seen."\n            },\n            {\n                id: 11,\n                text: "Which of the following practices best supports emergent literacy?",\n                domain: "Literacy Development",\n                options: [\n                    "Daily handwriting worksheets",\n                    "Flashcards with sight words",\n                    "Reading aloud and engaging children in conversations about stories",\n                    "Teaching the alphabet through rote memorization"\n                ],\n                correctAnswer: 2,\n                explanation: "Emergent literacy is best supported through meaningful interactions with text, including reading aloud, discussing stories, and incorporating literacy into play."\n            },\n            {\n                id: 12,\n                text: "What is the most effective way to engage families in children\'s learning?",\n                domain: "Family Engagement",\n                options: [\n                    "Sending home weekly newsletters about classroom activities",\n                    "Creating opportunities for families to share their expertise and culture in the classroom",\n                    "Having formal parent-teacher conferences twice a year",\n                    "Requiring parents to complete homework assignments with their children"\n                ],\n                correctAnswer: 1,\n                explanation: "Effective family engagement involves creating meaningful partnerships where families\' knowledge and cultures are valued and incorporated into the learning environment."\n            },\n            {\n                id: 13,\n                text: "Which of the following is the best example of an inclusive practice in early childhood education?",\n                domain: "Inclusion & Diversity",\n                options: [\n                    "Grouping children by ability for all activities",\n                    "Adapting materials and strategies to ensure all children can participate",\n                    "Providing separate activities for children with special needs",\n                    "Focusing equally on all cultural holidays throughout the year"\n                ],\n                correctAnswer: 1,\n                explanation: "Inclusive practices involve making adaptations and providing support so that all children can participate meaningfully in the same activities and routines."\n            },\n            {\n                id: 14,\n                text: "Which mathematical concept typically develops first in young children?",\n                domain: "Cognitive Development",\n                options: [\n                    "Multiplication",\n                    "One-to-one correspondence",\n                    "Fractions",\n                    "Algebraic thinking"\n                ],\n                correctAnswer: 1,\n                explanation: "One-to-one correspondence (matching one object to one object or person) is a foundational mathematical concept that typically develops in early childhood."\n            },\n            {\n                id: 15,\n                text: "Which of these is the most appropriate way to support a dual language learner in the classroom?",\n                domain: "Language Development",\n                options: [\n                    "Discourage the use of their home language to accelerate English acquisition",\n                    "Separate them from English-speaking peers to provide specialized instruction",\n                    "Provide visual supports and incorporate words from their home language",\n                    "Speak slowly and loudly to ensure comprehension"\n                ],\n                correctAnswer: 2,\n                explanation: "Supporting dual language learners involves valuing their home language, providing visual cues, and creating a language-rich environment that incorporates elements of their home language."\n            },\n            {\n                id: 16,\n                text: "Which of the following best describes the purpose of learning centers in a preschool classroom?",\n                domain: "Learning Environment",\n                options: [\n                    "To keep children busy while the teacher works with small groups",\n                    "To provide opportunities for choice, exploration, and discovery",\n                    "To prepare children for the structure of elementary school",\n                    "To assess children\'s ability to follow directions"\n                ],\n                correctAnswer: 1,\n                explanation: "Learning centers are designed to promote active engagement, choice, peer interaction, and exploration across different developmental domains."\n            },\n            {\n                id: 17,\n                text: "What is the primary purpose of documentation in Reggio Emilia-inspired programs?",\n                domain: "Observation & Assessment",\n                options: [\n                    "To evaluate children\'s academic progress",\n                    "To create portfolios to share with parents",\n                    "To make children\'s thinking and learning visible",\n                    "To fulfill licensing requirements"\n                ],\n                correctAnswer: 2,\n                explanation: "In Reggio Emilia, documentation serves to make children\'s thoughts, theories, and learning processes visible, helping teachers and children reflect on and extend learning."\n            },\n            {\n                id: 18,\n                text: "Which of the following is NOT considered a protective factor in building children\'s resilience?",\n                domain: "Social-Emotional Development",\n                options: [\n                    "Secure attachment relationships",\n                    "Self-regulation skills",\n                    "Problem-solving abilities",\n                    "Highly structured adult-directed activities"\n                ],\n                correctAnswer: 3,\n                explanation: "Protective factors that build resilience include supportive relationships, self-regulation, problem-solving skills, and opportunities for children to develop a sense of mastery through appropriate challenges."\n            },\n            {\n                id: 19,\n                text: "According to early childhood education best practices, what is the recommended daily minimum amount of time for outdoor play?",\n                domain: "Physical Development",\n                options: [\n                    "15 minutes",\n                    "30 minutes",\n                    "60 minutes",\n                    "90 minutes"\n                ],\n                correctAnswer: 2,\n                explanation: "Best practice guidelines suggest a minimum of 60 minutes of outdoor play daily for young children, weather permitting, to support physical development and overall well-being."\n            },\n            {\n                id: 20,\n                text: "Which of the following best describes appropriate technology use in early childhood settings?",\n                domain: "Technology Integration",\n                options: [\n                    "Children should have unlimited access to technology throughout the day",\n                    "Technology should be avoided entirely until age 7",\n                    "Technology should supplement, not replace, hands-on experiences and face-to-face interactions",\n                    "Children should use technology primarily for entertainment purposes"\n                ],\n                correctAnswer: 2,\n                explanation: "Developmentally appropriate technology use includes intentional selection of digital tools that enhance learning, used with adult guidance and in balance with other activities."\n            },\n            {\n                id: 21,\n                text: "Which is the best example of an authentic assessment approach?",\n                domain: "Assessment Methods",\n                options: [\n                    "Weekly spelling tests",\n                    "Standardized readiness tests",\n                    "Documentation of children\'s work and play over time",\n                    "Comparing all children to age-based milestones"\n                ],\n                correctAnswer: 2,\n                explanation: "Authentic assessment involves documenting children\'s actual work, play, and interactions in natural settings over time to understand their development and learning."\n            },\n            {\n                id: 22,\n                text: "How does the concept of \'funds of knowledge\' relate to working with diverse families?",\n                domain: "Family & Community Engagement",\n                options: [\n                    "It refers to the financial resources families can contribute to the program",\n                    "It recognizes the knowledge, skills and cultural practices of families as valuable resources",\n                    "It describes the educational background of family members",\n                    "It tracks how much information families retain from parent workshops"\n                ],\n                correctAnswer: 1,\n                explanation: "The \'funds of knowledge\' approach recognizes that families possess valuable knowledge, skills, and cultural practices that should be incorporated into and respected within educational settings."\n            },\n            {\n                id: 23,\n                text: "What is the primary purpose of project-based learning in early childhood?",\n                domain: "Curriculum Approaches",\n                options: [\n                    "To teach specific academic content in an organized sequence",\n                    "To prepare children for standardized testing",\n                    "To engage children in in-depth investigation of topics of interest",\n                    "To complete products for display in the classroom"\n                ],\n                correctAnswer: 2,\n                explanation: "Project-based learning engages children in extended, in-depth investigations of topics of interest, promoting deep learning, collaboration, and development across domains."\n            },\n            {\n                id: 24,\n                text: "Which of the following statements about executive function skills is TRUE?",\n                domain: "Cognitive Development",\n                options: [\n                    "They develop naturally and cannot be influenced by the environment",\n                    "They include working memory, inhibitory control, and cognitive flexibility",\n                    "They are fully developed by age 3",\n                    "They are only important for academic learning, not social skills"\n                ],\n                correctAnswer: 1,\n                explanation: "Executive function skills include working memory, inhibitory control, and cognitive flexibility, and they develop gradually throughout childhood with appropriate support and experiences."\n            },\n            {\n                id: 25,\n                text: "What is the most appropriate way to support socio-dramatic play in a preschool classroom?",\n                domain: "Play & Learning",\n                options: [\n                    "Assign roles to ensure all children participate equally",\n                    "Provide open-ended materials and appropriate time and space",\n                    "Require a specific theme to ensure educational content",\n                    "Have adults direct the play to maintain order"\n                ],\n                correctAnswer: 1,\n                explanation: "Supporting socio-dramatic play involves providing open-ended materials, sufficient time and space, and appropriate adult scaffolding without taking over or directing the play."\n            }\n        ];\n\n        let assessmentType = \'basic\';\n        let currentQuestions = [];\n        let currentQuestionIndex = 0;\n        let userAnswers = [];\n        let startTime = null;\n        let timerInterval = null;\n\n        // Set assessment type\n        function setAssessmentType(type) {\n            assessmentType = type;\n            const basicOption = document.querySelector(\'div[onclick="setAssessmentType(\\\'basic\\\')"]\');\n            const comprehensiveOption = document.querySelector(\'div[onclick="setAssessmentType(\\\'comprehensive\\\')"]\');\n            \n            basicOption.classList.remove(\'border-indigo-500\', \'bg-indigo-50\');\n            comprehensiveOption.classList.remove(\'border-indigo-500\', \'bg-indigo-50\');\n            \n            if (type === \'basic\') {\n                basicOption.classList.add(\'border-indigo-500\', \'bg-indigo-50\');\n            } else {\n                comprehensiveOption.classList.add(\'border-indigo-500\', \'bg-indigo-50\');\n            }\n        }\n\n        // Start the assessment\n        function startAssessment() {\n            // Get user info\n            const userName = document.getElementById(\'name\').value;\n            const userEmail = document.getElementById(\'email\').value;\n            \n            // Select questions based on assessment type\n            if (assessmentType === \'basic\') {\n                currentQuestions = allQuestions.slice(0, 15);\n                document.getElementById(\'total-questions\').textContent = \'15\';\n            } else {\n                currentQuestions = allQuestions;\n                document.getElementById(\'total-questions\').textContent = \'25\';\n            }\n            \n            // Initialize user answers array\n            userAnswers = Array(currentQuestions.length).fill(null);\n            \n            // Show the assessment screen\n            document.getElementById(\'setup-screen\').classList.add(\'hidden\');\n            document.getElementById(\'assessment-screen\').classList.remove(\'hidden\');\n            \n            // Display the first question\n            currentQuestionIndex = 0;\n            displayQuestion(currentQuestionIndex);\n            \n            // Start the timer\n            startTime = new Date();\n            timerInterval = setInterval(updateTimer, 1000);\n        }\n\n        // Display a question\n        function displayQuestion(index) {\n            const question = currentQuestions[index];\n            document.getElementById(\'current-question\').textContent = index + 1;\n            document.getElementById(\'question-text\').textContent = question.text;\n            document.getElementById(\'question-domain\').textContent = `Domain: ${question.domain}`;\n            \n            // Update progress bar\n            const progressPercentage = ((index + 1) / currentQuestions.length) * 100;\n            document.getElementById(\'progress-value\').style.width = `${progressPercentage}%`;\n            \n            // Generate options\n            const optionsContainer = document.getElementById(\'options-container\');\n            optionsContainer.innerHTML = \'\';\n            \n            question.options.forEach((option, optionIndex) => {\n                const optionCard = document.createElement(\'div\');\n                optionCard.className = \'option-card p-4\';\n                optionCard.setAttribute(\'data-index\', optionIndex);\n                \n                // If user has already answered this question\n                if (userAnswers[index] !== null) {\n                    if (userAnswers[index] === optionIndex) {\n                        optionCard.classList.add(\'selected\');\n                        if (optionIndex === question.correctAnswer) {\n                            optionCard.classList.add(\'correct\');\n                        } else {\n                            optionCard.classList.add(\'incorrect\');\n                        }\n                    } else if (optionIndex === question.correctAnswer) {\n                        optionCard.classList.add(\'correct\');\n                    }\n                    optionCard.style.pointerEvents = \'none\';\n                } else {\n                    optionCard.addEventListener(\'click\', () => selectOption(optionIndex));\n                }\n                \n                optionCard.innerHTML = `\n                    <div class="flex items-start">\n                        <div class="flex-shrink-0 w-6 h-6 bg-gray-200 rounded-full flex items-center justify-center text-sm mr-3">\n                            ${String.fromCharCode(65 + optionIndex)}\n                        </div>\n                        <span>${option}</span>\n                    </div>\n                `;\n                optionsContainer.appendChild(optionCard);\n            });\n            \n            // Hide feedback container\n            document.getElementById(\'feedback-container\').classList.add(\'hidden\');\n            \n            // Update navigation buttons\n            document.getElementById(\'prev-btn\').disabled = index === 0;\n            document.getElementById(\'next-btn\').disabled = userAnswers[index] === null;\n            \n            if (index === currentQuestions.length - 1 && userAnswers[index] !== null) {\n                document.getElementById(\'next-btn\').textContent = \'Finish\';\n            } else {\n                document.getElementById(\'next-btn\').textContent = \'Next\';\n            }\n        }\n\n        // Select an option\n        function selectOption(optionIndex) {\n            const question = currentQuestions[currentQuestionIndex];\n            userAnswers[currentQuestionIndex] = optionIndex;\n            \n            // Update options UI\n            const options = document.querySelectorAll(\'.option-card\');\n            options.forEach((option, index) => {\n                option.classList.remove(\'selected\', \'correct\', \'incorrect\');\n                option.style.pointerEvents = \'none\';\n                \n                if (index === optionIndex) {\n                    option.classList.add(\'selected\');\n                    if (index === question.correctAnswer) {\n                        option.classList.add(\'correct\');\n                    } else {\n                        option.classList.add(\'incorrect\');\n                    }\n                } else if (index === question.correctAnswer) {\n                    option.classList.add(\'correct\');\n                }\n            });\n            \n            // Show feedback\n            const feedbackContainer = document.getElementById(\'feedback-container\');\n            feedbackContainer.innerHTML = \'\';\n            \n            if (optionIndex === question.correctAnswer) {\n                feedbackContainer.classList.add(\'feedback-correct\');\n                feedbackContainer.classList.remove(\'feedback-incorrect\');\n                feedbackContainer.innerHTML = `\n                    <div class="flex items-start">\n                        <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">\n                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>\n                        </svg>\n                        <div>\n                            <p class="font-semibold text-green-700">Correct!</p>\n                            <p class="text-sm text-gray-600 mt-1">${question.explanation}</p>\n                        </div>\n                    </div>\n                `;\n            } else {\n                feedbackContainer.classList.add(\'feedback-incorrect\');\n                feedbackContainer.classList.remove(\'feedback-correct\');\n                feedbackContainer.innerHTML = `\n                    <div class="flex items-start">\n                        <svg class="w-5 h-5 text-red-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">\n                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>\n                        </svg>\n                        <div>\n                            <p class="font-semibold text-red-700">Incorrect</p>\n                            <p class="text-sm text-gray-600 mt-1">The correct answer is: ${question.options[question.correctAnswer]}</p>\n                            <p class="text-sm text-gray-600 mt-1">${question.explanation}</p>\n                        </div>\n                    </div>\n                `;\n            }\n            feedbackContainer.classList.remove(\'hidden\');\n            \n            // Enable next button\n            document.getElementById(\'next-btn\').disabled = false;\n            \n            // If this is the last question and it\'s answered, show "Finish" on the button\n            if (currentQuestionIndex === currentQuestions.length - 1) {\n                document.getElementById(\'next-btn\').textContent = \'Finish\';\n            }\n        }\n\n        // Navigate to previous or next question\n        function navigateQuestion(direction) {\n            if (direction === 1 && currentQuestionIndex === currentQuestions.length - 1) {\n                // This is the last question, finish the assessment\n                finishAssessment();\n                return;\n            }\n            \n            currentQuestionIndex += direction;\n            displayQuestion(currentQuestionIndex);\n        }\n\n        // Update the timer\n        function updateTimer() {\n            if (!startTime) return;\n            \n            const now = new Date();\n            const elapsedMilliseconds = now - startTime;\n            const elapsedSeconds = Math.floor(elapsedMilliseconds / 1000);\n            const minutes = Math.floor(elapsedSeconds / 60);\n            const seconds = elapsedSeconds % 60;\n            \n            document.getElementById(\'timer\').textContent = `${minutes.toString().padStart(2, \'0\')}:${seconds.toString().padStart(2, \'0\')}`;\n        }\n\n        // Finish the assessment\n        function finishAssessment() {\n            // Stop the timer\n            clearInterval(timerInterval);\n            const endTime = new Date();\n            const totalTimeInSeconds = Math.floor((endTime - startTime) / 1000);\n            const minutes = Math.floor(totalTimeInSeconds / 60);\n            const seconds = totalTimeInSeconds % 60;\n            const timeString = `${minutes.toString().padStart(2, \'0\')}:${seconds.toString().padStart(2, \'0\')}`;\n            \n            // Calculate score\n            let correctCount = 0;\n            userAnswers.forEach((answer, index) => {\n                if (answer === currentQuestions[index].correctAnswer) {\n                    correctCount++;\n                }\n            });\n            \n            const scorePercentage = Math.round((correctCount / currentQuestions.length) * 100);\n            \n            // Calculate domain performance\n            const domainPerformance = {};\n            currentQuestions.forEach((question, index) => {\n                const domain = question.domain;\n                if (!domainPerformance[domain]) {\n                    domainPerformance[domain] = {\n                        total: 0,\n                        correct: 0\n                    };\n                }\n                \n                domainPerformance[domain].total++;\n                if (userAnswers[index] === question.correctAnswer) {\n                    domainPerformance[domain].correct++;\n                }\n            });\n            \n            // Update results UI\n            document.getElementById(\'final-score\').textContent = `${scorePercentage}%`;\n            document.getElementById(\'correct-answers\').textContent = `${correctCount}/${currentQuestions.length}`;\n            document.getElementById(\'time-taken\').textContent = timeString;\n            \n            // Generate domain stats\n            const domainStatsContainer = document.getElementById(\'domain-stats-container\');\n            domainStatsContainer.innerHTML = \'\';\n            \n            Object.entries(domainPerformance).forEach(([domain, stats]) => {\n                const percentage = Math.round((stats.correct / stats.total) * 100);\n                const domainColor = getDomainColorClass(percentage);\n                \n                const domainStat = document.createElement(\'div\');\n                domainStat.className = \'mb-4\';\n                domainStat.innerHTML = `\n                    <div class="flex justify-between items-center mb-1">\n                        <span class="text-sm font-medium text-gray-700">${domain}</span>\n                        <span class="text-sm font-medium ${domainColor.text}">${percentage}%</span>\n                    </div>\n                    <div class="w-full bg-gray-200 rounded-full h-2.5">\n                        <div class="${domainColor.bg} h-2.5 rounded-full" style="width: ${percentage}%"></div>\n                    </div>\n                    <div class="text-xs text-gray-500 mt-1">${stats.correct} / ${stats.total} correct</div>\n                `;\n                domainStatsContainer.appendChild(domainStat);\n            });\n            \n            // Generate recommendations\n            const recommendationsList = document.getElementById(\'recommendations-list\');\n            recommendationsList.innerHTML = \'\';\n            \n            // Find weakest domains\n            const weakDomains = Object.entries(domainPerformance)\n                .map(([domain, stats]) => ({\n                    domain,\n                    percentage: Math.round((stats.correct / stats.total) * 100)\n                }))\n                .sort((a, b) => a.percentage - b.percentage)\n                .slice(0, 3);\n            \n            // Generate recommendations based on weak domains\n            weakDomains.forEach(domainData => {\n                const recommendation = document.createElement(\'li\');\n                recommendation.textContent = getRecommendation(domainData.domain);\n                recommendationsList.appendChild(recommendation);\n            });\n            \n            // Show results screen\n            document.getElementById(\'assessment-screen\').classList.add(\'hidden\');\n            document.getElementById(\'results-screen\').classList.remove(\'hidden\');\n            \n            // Save results to localStorage for detailed view\n            const resultsData = {\n                score: scorePercentage,\n                correctAnswers: correctCount,\n                totalQuestions: currentQuestions.length,\n                completionTime: timeString,\n                domains: Object.entries(domainPerformance).map(([domain, stats]) => ({\n                    name: domain,\n                    score: Math.round((stats.correct / stats.total) * 100)\n                })),\n                recommendations: Array.from(recommendationsList.children).map(li => li.textContent)\n            };\n            \n            localStorage.setItem(\'assessmentResults\', JSON.stringify(resultsData));\n        }\n\n        // Get domain color class based on score\n        function getDomainColorClass(score) {\n            if (score >= 80) {\n                return { bg: \'bg-green-600\', text: \'text-green-600\' };\n            } else if (score >= 70) {\n                return { bg: \'bg-blue-600\', text: \'text-blue-600\' };\n            } else if (score >= 60) {\n                return { bg: \'bg-yellow-600\', text: \'text-yellow-600\' };\n            } else {\n                return { bg: \'bg-red-600\', text: \'text-red-600\' };\n            }\n        }\n\n        // Get recommendation based on domain\n        function getRecommendation(domain) {\n            const recommendations = {\n                "Child Development Theories": "Review key child development theories such as Piaget\'s stages and Vygotsky\'s zone of proximal development.",\n                "Curriculum Approaches": "Study different curriculum approaches, focusing on child-centered methods like Reggio Emilia and play-based learning.",\n                "Assessment Methods": "Explore authentic assessment techniques to better document and understand children\'s learning.",\n                "Quality Measurement": "Familiarize yourself with quality measurement tools like CLASS and apply their principles in your practice.",\n                "Health & Safety": "Review current health and safety guidelines and best practices for early childhood settings.",\n                "Developmentally Appropriate Practice": "Deepen your understanding of how to apply developmentally appropriate practices across all areas.",\n                "Teaching Strategies": "Focus on scaffolding techniques and differentiating instruction for diverse learners.",\n                "Guidance & Behavior Management": "Study positive guidance strategies and techniques for supporting children\'s self-regulation.",\n                "Communication & Language": "Practice using open-ended questions and strategies to extend children\'s language development.",\n                "Literacy Development": "Explore research-based approaches to emergent literacy and methods for rich literacy experiences.",\n                "Family Engagement": "Develop strategies for meaningful family partnerships that value diverse cultures and knowledge.",\n                "Inclusion & Diversity": "Build skills in creating inclusive environments and adapting activities for all children.",\n                "Cognitive Development": "Focus on understanding and supporting the development of executive function skills and mathematical thinking.",\n                "Language Development": "Learn more about supporting dual language learners and language acquisition stages.",\n                "Learning Environment": "Study how to design engaging, well-organized learning spaces that promote all aspects of development.",\n                "Observation & Assessment": "Practice documentation techniques to make children\'s learning visible and inform planning.",\n                "Social-Emotional Development": "Enhance your knowledge of strategies to support resilience and social-emotional skills.",\n                "Physical Development": "Ensure sufficient opportunities for both fine and gross motor development throughout the day.",\n                "Technology Integration": "Learn about developmentally appropriate technology use that enhances rather than replaces hands-on learning.",\n                "Family & Community Engagement": "Explore the \'funds of knowledge\' approach to better incorporate family cultures and expertise.",\n                "Play & Learning": "Deepen your understanding of how to support and extend learning through different types of play."\n            };\n            \n            return recommendations[domain] || `Focus on building your knowledge in ${domain}.`;\n        }\n\n        // Save results and redirect to detailed view\n        function saveAndViewResults() {\n            window.location.href = "/assessment-results.html";\n        }\n\n        // Restart the assessment\n        function restartAssessment() {\n            document.getElementById(\'results-screen\').classList.add(\'hidden\');\n            document.getElementById(\'setup-screen\').classList.remove(\'hidden\');\n            document.getElementById(\'name\').value = \'\';\n            document.getElementById(\'email\').value = \'\';\n        }\n     $X $X. ... .$V = "..." $X. ... .innerHTML = ... $X. ... .outerHTML = ... javascript <script ...>\n        // Assessment data\n        const allQuestions = [\n            {\n                id: 1,\n                text: "Which of the following best describes the zone of proximal development?",\n                domain: "Child Development Theories",\n                options: [\n                    "The area where a child can complete tasks independently",\n                    "The difference between what a child can do with help and what they can do independently",\n                    "The stage where children develop fine motor skills",\n                    "The period when children learn to socialize with peers"\n                ],\n                correctAnswer: 1,\n                explanation: "The zone of proximal development (ZPD) is the difference between what a learner can do without help and what they can achieve with guidance from a more knowledgeable person."\n            },\n            {\n                id: 2,\n                text: "Which approach emphasizes the importance of child-directed play and exploration?",\n                domain: "Curriculum Approaches",\n                options: [\n                    "Direct instruction",\n                    "Reggio Emilia",\n                    "Academic-focused curriculum",\n                    "Teacher-centered learning"\n                ],\n                correctAnswer: 1,\n                explanation: "The Reggio Emilia approach views children as capable, curious individuals and emphasizes child-directed exploration and discovery."\n            },\n            {\n                id: 3,\n                text: "What is the primary purpose of formative assessment in early childhood education?",\n                domain: "Assessment Methods",\n                options: [\n                    "To assign grades to children",\n                    "To compare children\'s abilities",\n                    "To inform ongoing teaching and learning",\n                    "To determine readiness for elementary school"\n                ],\n                correctAnswer: 2,\n                explanation: "Formative assessment is used to monitor student learning and provide ongoing feedback to improve teaching and learning processes."\n            },\n            {\n                id: 4,\n                text: "Which of the following is NOT typically considered one of the CLASS (Classroom Assessment Scoring System) domains?",\n                domain: "Quality Measurement",\n                options: [\n                    "Emotional Support",\n                    "Classroom Organization",\n                    "Instructional Support",\n                    "Physical Environment"\n                ],\n                correctAnswer: 3,\n                explanation: "The CLASS assessment tool has three main domains: Emotional Support, Classroom Organization, and Instructional Support. Physical Environment is not a CLASS domain."\n            },\n            {\n                id: 5,\n                text: "What is the recommended adult-to-child ratio for 3-year-olds according to NAEYC accreditation standards?",\n                domain: "Health & Safety",\n                options: [\n                    "1:15",\n                    "1:10",\n                    "1:8",\n                    "1:6"\n                ],\n                correctAnswer: 2,\n                explanation: "NAEYC recommends a ratio of 1 adult for every 8 three-year-olds with a maximum group size of 16."\n            },\n            {\n                id: 6,\n                text: "Which of the following is a key component of developmentally appropriate practice (DAP)?",\n                domain: "Developmentally Appropriate Practice",\n                options: [\n                    "Using the same approach for all children regardless of development",\n                    "Making decisions based on what children of a certain age should be able to do",\n                    "Considering the needs and capabilities of each individual child",\n                    "Following a strict curriculum regardless of children\'s interests"\n                ],\n                correctAnswer: 2,\n                explanation: "DAP requires teachers to meet children where they are, considering each child\'s age, experience, abilities, and interests."\n            },\n            {\n                id: 7,\n                text: "Which of these is an example of scaffolding in early childhood education?",\n                domain: "Teaching Strategies",\n                options: [\n                    "Giving a child a complex task and expecting them to figure it out independently",\n                    "Providing hints and supports to help a child complete a task they couldn\'t do alone",\n                    "Completing difficult tasks for children to demonstrate proper techniques",\n                    "Letting children only do activities they have already mastered"\n                ],\n                correctAnswer: 1,\n                explanation: "Scaffolding involves providing temporary support to help children master new skills, gradually removing the support as competence increases."\n            },\n            {\n                id: 8,\n                text: "What is the appropriate way to handle a situation where a child hits another child?",\n                domain: "Guidance & Behavior Management",\n                options: [\n                    "Ignore the behavior to avoid giving negative attention",\n                    "Immediately put the child in time-out without discussion",\n                    "Calmly stop the behavior, acknowledge feelings, and teach appropriate alternatives",\n                    "Ask the hit child to hit back so they learn a lesson"\n                ],\n                correctAnswer: 2,\n                explanation: "Effective guidance involves setting clear limits, acknowledging feelings, and teaching children alternative ways to express emotions."\n            },\n            {\n                id: 9,\n                text: "Which of the following would be considered an open-ended question?",\n                domain: "Communication & Language",\n                options: [\n                    "Did you like the story?",\n                    "Can you count to 10?",\n                    "What do you think will happen next in the story?",\n                    "Is this a triangle?"\n                ],\n                correctAnswer: 2,\n                explanation: "Open-ended questions cannot be answered with a simple \'yes\' or \'no\' and encourage children to think critically and express their thoughts."\n            },\n            {\n                id: 10,\n                text: "According to Piaget, in which stage do children develop object permanence?",\n                domain: "Child Development Theories",\n                options: [\n                    "Sensorimotor stage",\n                    "Preoperational stage",\n                    "Concrete operational stage",\n                    "Formal operational stage"\n                ],\n                correctAnswer: 0,\n                explanation: "Object permanence typically develops during the sensorimotor stage (birth to 2 years), when children begin to understand that objects continue to exist even when they cannot be seen."\n            },\n            {\n                id: 11,\n                text: "Which of the following practices best supports emergent literacy?",\n                domain: "Literacy Development",\n                options: [\n                    "Daily handwriting worksheets",\n                    "Flashcards with sight words",\n                    "Reading aloud and engaging children in conversations about stories",\n                    "Teaching the alphabet through rote memorization"\n                ],\n                correctAnswer: 2,\n                explanation: "Emergent literacy is best supported through meaningful interactions with text, including reading aloud, discussing stories, and incorporating literacy into play."\n            },\n            {\n                id: 12,\n                text: "What is the most effective way to engage families in children\'s learning?",\n                domain: "Family Engagement",\n                options: [\n                    "Sending home weekly newsletters about classroom activities",\n                    "Creating opportunities for families to share their expertise and culture in the classroom",\n                    "Having formal parent-teacher conferences twice a year",\n                    "Requiring parents to complete homework assignments with their children"\n                ],\n                correctAnswer: 1,\n                explanation: "Effective family engagement involves creating meaningful partnerships where families\' knowledge and cultures are valued and incorporated into the learning environment."\n            },\n            {\n                id: 13,\n                text: "Which of the following is the best example of an inclusive practice in early childhood education?",\n                domain: "Inclusion & Diversity",\n                options: [\n                    "Grouping children by ability for all activities",\n                    "Adapting materials and strategies to ensure all children can participate",\n                    "Providing separate activities for children with special needs",\n                    "Focusing equally on all cultural holidays throughout the year"\n                ],\n                correctAnswer: 1,\n                explanation: "Inclusive practices involve making adaptations and providing support so that all children can participate meaningfully in the same activities and routines."\n            },\n            {\n                id: 14,\n                text: "Which mathematical concept typically develops first in young children?",\n                domain: "Cognitive Development",\n                options: [\n                    "Multiplication",\n                    "One-to-one correspondence",\n                    "Fractions",\n                    "Algebraic thinking"\n                ],\n                correctAnswer: 1,\n                explanation: "One-to-one correspondence (matching one object to one object or person) is a foundational mathematical concept that typically develops in early childhood."\n            },\n            {\n                id: 15,\n                text: "Which of these is the most appropriate way to support a dual language learner in the classroom?",\n                domain: "Language Development",\n                options: [\n                    "Discourage the use of their home language to accelerate English acquisition",\n                    "Separate them from English-speaking peers to provide specialized instruction",\n                    "Provide visual supports and incorporate words from their home language",\n                    "Speak slowly and loudly to ensure comprehension"\n                ],\n                correctAnswer: 2,\n                explanation: "Supporting dual language learners involves valuing their home language, providing visual cues, and creating a language-rich environment that incorporates elements of their home language."\n            },\n            {\n                id: 16,\n                text: "Which of the following best describes the purpose of learning centers in a preschool classroom?",\n                domain: "Learning Environment",\n                options: [\n                    "To keep children busy while the teacher works with small groups",\n                    "To provide opportunities for choice, exploration, and discovery",\n                    "To prepare children for the structure of elementary school",\n                    "To assess children\'s ability to follow directions"\n                ],\n                correctAnswer: 1,\n                explanation: "Learning centers are designed to promote active engagement, choice, peer interaction, and exploration across different developmental domains."\n            },\n            {\n                id: 17,\n                text: "What is the primary purpose of documentation in Reggio Emilia-inspired programs?",\n                domain: "Observation & Assessment",\n                options: [\n                    "To evaluate children\'s academic progress",\n                    "To create portfolios to share with parents",\n                    "To make children\'s thinking and learning visible",\n                    "To fulfill licensing requirements"\n                ],\n                correctAnswer: 2,\n                explanation: "In Reggio Emilia, documentation serves to make children\'s thoughts, theories, and learning processes visible, helping teachers and children reflect on and extend learning."\n            },\n            {\n                id: 18,\n                text: "Which of the following is NOT considered a protective factor in building children\'s resilience?",\n                domain: "Social-Emotional Development",\n                options: [\n                    "Secure attachment relationships",\n                    "Self-regulation skills",\n                    "Problem-solving abilities",\n                    "Highly structured adult-directed activities"\n                ],\n                correctAnswer: 3,\n                explanation: "Protective factors that build resilience include supportive relationships, self-regulation, problem-solving skills, and opportunities for children to develop a sense of mastery through appropriate challenges."\n            },\n            {\n                id: 19,\n                text: "According to early childhood education best practices, what is the recommended daily minimum amount of time for outdoor play?",\n                domain: "Physical Development",\n                options: [\n                    "15 minutes",\n                    "30 minutes",\n                    "60 minutes",\n                    "90 minutes"\n                ],\n                correctAnswer: 2,\n                explanation: "Best practice guidelines suggest a minimum of 60 minutes of outdoor play daily for young children, weather permitting, to support physical development and overall well-being."\n            },\n            {\n                id: 20,\n                text: "Which of the following best describes appropriate technology use in early childhood settings?",\n                domain: "Technology Integration",\n                options: [\n                    "Children should have unlimited access to technology throughout the day",\n                    "Technology should be avoided entirely until age 7",\n                    "Technology should supplement, not replace, hands-on experiences and face-to-face interactions",\n                    "Children should use technology primarily for entertainment purposes"\n                ],\n                correctAnswer: 2,\n                explanation: "Developmentally appropriate technology use includes intentional selection of digital tools that enhance learning, used with adult guidance and in balance with other activities."\n            },\n            {\n                id: 21,\n                text: "Which is the best example of an authentic assessment approach?",\n                domain: "Assessment Methods",\n                options: [\n                    "Weekly spelling tests",\n                    "Standardized readiness tests",\n                    "Documentation of children\'s work and play over time",\n                    "Comparing all children to age-based milestones"\n                ],\n                correctAnswer: 2,\n                explanation: "Authentic assessment involves documenting children\'s actual work, play, and interactions in natural settings over time to understand their development and learning."\n            },\n            {\n                id: 22,\n                text: "How does the concept of \'funds of knowledge\' relate to working with diverse families?",\n                domain: "Family & Community Engagement",\n                options: [\n                    "It refers to the financial resources families can contribute to the program",\n                    "It recognizes the knowledge, skills and cultural practices of families as valuable resources",\n                    "It describes the educational background of family members",\n                    "It tracks how much information families retain from parent workshops"\n                ],\n                correctAnswer: 1,\n                explanation: "The \'funds of knowledge\' approach recognizes that families possess valuable knowledge, skills, and cultural practices that should be incorporated into and respected within educational settings."\n            },\n            {\n                id: 23,\n                text: "What is the primary purpose of project-based learning in early childhood?",\n                domain: "Curriculum Approaches",\n                options: [\n                    "To teach specific academic content in an organized sequence",\n                    "To prepare children for standardized testing",\n                    "To engage children in in-depth investigation of topics of interest",\n                    "To complete products for display in the classroom"\n                ],\n                correctAnswer: 2,\n                explanation: "Project-based learning engages children in extended, in-depth investigations of topics of interest, promoting deep learning, collaboration, and development across domains."\n            },\n            {\n                id: 24,\n                text: "Which of the following statements about executive function skills is TRUE?",\n                domain: "Cognitive Development",\n                options: [\n                    "They develop naturally and cannot be influenced by the environment",\n                    "They include working memory, inhibitory control, and cognitive flexibility",\n                    "They are fully developed by age 3",\n                    "They are only important for academic learning, not social skills"\n                ],\n                correctAnswer: 1,\n                explanation: "Executive function skills include working memory, inhibitory control, and cognitive flexibility, and they develop gradually throughout childhood with appropriate support and experiences."\n            },\n            {\n                id: 25,\n                text: "What is the most appropriate way to support socio-dramatic play in a preschool classroom?",\n                domain: "Play & Learning",\n                options: [\n                    "Assign roles to ensure all children participate equally",\n                    "Provide open-ended materials and appropriate time and space",\n                    "Require a specific theme to ensure educational content",\n                    "Have adults direct the play to maintain order"\n                ],\n                correctAnswer: 1,\n                explanation: "Supporting socio-dramatic play involves providing open-ended materials, sufficient time and space, and appropriate adult scaffolding without taking over or directing the play."\n            }\n        ];\n\n        let assessmentType = \'basic\';\n        let currentQuestions = [];\n        let currentQuestionIndex = 0;\n        let userAnswers = [];\n        let startTime = null;\n        let timerInterval = null;\n\n        // Set assessment type\n        function setAssessmentType(type) {\n            assessmentType = type;\n            const basicOption = document.querySelector(\'div[onclick="setAssessmentType(\\\'basic\\\')"]\');\n            const comprehensiveOption = document.querySelector(\'div[onclick="setAssessmentType(\\\'comprehensive\\\')"]\');\n            \n            basicOption.classList.remove(\'border-indigo-500\', \'bg-indigo-50\');\n            comprehensiveOption.classList.remove(\'border-indigo-500\', \'bg-indigo-50\');\n            \n            if (type === \'basic\') {\n                basicOption.classList.add(\'border-indigo-500\', \'bg-indigo-50\');\n            } else {\n                comprehensiveOption.classList.add(\'border-indigo-500\', \'bg-indigo-50\');\n            }\n        }\n\n        // Start the assessment\n        function startAssessment() {\n            // Get user info\n            const userName = document.getElementById(\'name\').value;\n            const userEmail = document.getElementById(\'email\').value;\n            \n            // Select questions based on assessment type\n            if (assessmentType === \'basic\') {\n                currentQuestions = allQuestions.slice(0, 15);\n                document.getElementById(\'total-questions\').textContent = \'15\';\n            } else {\n                currentQuestions = allQuestions;\n                document.getElementById(\'total-questions\').textContent = \'25\';\n            }\n            \n            // Initialize user answers array\n            userAnswers = Array(currentQuestions.length).fill(null);\n            \n            // Show the assessment screen\n            document.getElementById(\'setup-screen\').classList.add(\'hidden\');\n            document.getElementById(\'assessment-screen\').classList.remove(\'hidden\');\n            \n            // Display the first question\n            currentQuestionIndex = 0;\n            displayQuestion(currentQuestionIndex);\n            \n            // Start the timer\n            startTime = new Date();\n            timerInterval = setInterval(updateTimer, 1000);\n        }\n\n        // Display a question\n        function displayQuestion(index) {\n            const question = currentQuestions[index];\n            document.getElementById(\'current-question\').textContent = index + 1;\n            document.getElementById(\'question-text\').textContent = question.text;\n            document.getElementById(\'question-domain\').textContent = `Domain: ${question.domain}`;\n            \n            // Update progress bar\n            const progressPercentage = ((index + 1) / currentQuestions.length) * 100;\n            document.getElementById(\'progress-value\').style.width = `${progressPercentage}%`;\n            \n            // Generate options\n            const optionsContainer = document.getElementById(\'options-container\');\n            optionsContainer.innerHTML = \'\';\n            \n            question.options.forEach((option, optionIndex) => {\n                const optionCard = document.createElement(\'div\');\n                optionCard.className = \'option-card p-4\';\n                optionCard.setAttribute(\'data-index\', optionIndex);\n                \n                // If user has already answered this question\n                if (userAnswers[index] !== null) {\n                    if (userAnswers[index] === optionIndex) {\n                        optionCard.classList.add(\'selected\');\n                        if (optionIndex === question.correctAnswer) {\n                            optionCard.classList.add(\'correct\');\n                        } else {\n                            optionCard.classList.add(\'incorrect\');\n                        }\n                    } else if (optionIndex === question.correctAnswer) {\n                        optionCard.classList.add(\'correct\');\n                    }\n                    optionCard.style.pointerEvents = \'none\';\n                } else {\n                    optionCard.addEventListener(\'click\', () => selectOption(optionIndex));\n                }\n                \n                optionCard.innerHTML = `\n                    <div class="flex items-start">\n                        <div class="flex-shrink-0 w-6 h-6 bg-gray-200 rounded-full flex items-center justify-center text-sm mr-3">\n                            ${String.fromCharCode(65 + optionIndex)}\n                        </div>\n                        <span>${option}</span>\n                    </div>\n                `;\n                optionsContainer.appendChild(optionCard);\n            });\n            \n            // Hide feedback container\n            document.getElementById(\'feedback-container\').classList.add(\'hidden\');\n            \n            // Update navigation buttons\n            document.getElementById(\'prev-btn\').disabled = index === 0;\n            document.getElementById(\'next-btn\').disabled = userAnswers[index] === null;\n            \n            if (index === currentQuestions.length - 1 && userAnswers[index] !== null) {\n                document.getElementById(\'next-btn\').textContent = \'Finish\';\n            } else {\n                document.getElementById(\'next-btn\').textContent = \'Next\';\n            }\n        }\n\n        // Select an option\n        function selectOption(optionIndex) {\n            const question = currentQuestions[currentQuestionIndex];\n            userAnswers[currentQuestionIndex] = optionIndex;\n            \n            // Update options UI\n            const options = document.querySelectorAll(\'.option-card\');\n            options.forEach((option, index) => {\n                option.classList.remove(\'selected\', \'correct\', \'incorrect\');\n                option.style.pointerEvents = \'none\';\n                \n                if (index === optionIndex) {\n                    option.classList.add(\'selected\');\n                    if (index === question.correctAnswer) {\n                        option.classList.add(\'correct\');\n                    } else {\n                        option.classList.add(\'incorrect\');\n                    }\n                } else if (index === question.correctAnswer) {\n                    option.classList.add(\'correct\');\n                }\n            });\n            \n            // Show feedback\n            const feedbackContainer = document.getElementById(\'feedback-container\');\n            feedbackContainer.innerHTML = \'\';\n            \n            if (optionIndex === question.correctAnswer) {\n                feedbackContainer.classList.add(\'feedback-correct\');\n                feedbackContainer.classList.remove(\'feedback-incorrect\');\n                feedbackContainer.innerHTML = `\n                    <div class="flex items-start">\n                        <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">\n                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>\n                        </svg>\n                        <div>\n                            <p class="font-semibold text-green-700">Correct!</p>\n                            <p class="text-sm text-gray-600 mt-1">${question.explanation}</p>\n                        </div>\n                    </div>\n                `;\n            } else {\n                feedbackContainer.classList.add(\'feedback-incorrect\');\n                feedbackContainer.classList.remove(\'feedback-correct\');\n                feedbackContainer.innerHTML = `\n                    <div class="flex items-start">\n                        <svg class="w-5 h-5 text-red-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">\n                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>\n                        </svg>\n                        <div>\n                            <p class="font-semibold text-red-700">Incorrect</p>\n                            <p class="text-sm text-gray-600 mt-1">The correct answer is: ${question.options[question.correctAnswer]}</p>\n                            <p class="text-sm text-gray-600 mt-1">${question.explanation}</p>\n                        </div>\n                    </div>\n                `;\n            }\n            feedbackContainer.classList.remove(\'hidden\');\n            \n            // Enable next button\n            document.getElementById(\'next-btn\').disabled = false;\n            \n            // If this is the last question and it\'s answered, show "Finish" on the button\n            if (currentQuestionIndex === currentQuestions.length - 1) {\n                document.getElementById(\'next-btn\').textContent = \'Finish\';\n            }\n        }\n\n        // Navigate to previous or next question\n        function navigateQuestion(direction) {\n            if (direction === 1 && currentQuestionIndex === currentQuestions.length - 1) {\n                // This is the last question, finish the assessment\n                finishAssessment();\n                return;\n            }\n            \n            currentQuestionIndex += direction;\n            displayQuestion(currentQuestionIndex);\n        }\n\n        // Update the timer\n        function updateTimer() {\n            if (!startTime) return;\n            \n            const now = new Date();\n            const elapsedMilliseconds = now - startTime;\n            const elapsedSeconds = Math.floor(elapsedMilliseconds / 1000);\n            const minutes = Math.floor(elapsedSeconds / 60);\n            const seconds = elapsedSeconds % 60;\n            \n            document.getElementById(\'timer\').textContent = `${minutes.toString().padStart(2, \'0\')}:${seconds.toString().padStart(2, \'0\')}`;\n        }\n\n        // Finish the assessment\n        function finishAssessment() {\n            // Stop the timer\n            clearInterval(timerInterval);\n            const endTime = new Date();\n            const totalTimeInSeconds = Math.floor((endTime - startTime) / 1000);\n            const minutes = Math.floor(totalTimeInSeconds / 60);\n            const seconds = totalTimeInSeconds % 60;\n            const timeString = `${minutes.toString().padStart(2, \'0\')}:${seconds.toString().padStart(2, \'0\')}`;\n            \n            // Calculate score\n            let correctCount = 0;\n            userAnswers.forEach((answer, index) => {\n                if (answer === currentQuestions[index].correctAnswer) {\n                    correctCount++;\n                }\n            });\n            \n            const scorePercentage = Math.round((correctCount / currentQuestions.length) * 100);\n            \n            // Calculate domain performance\n            const domainPerformance = {};\n            currentQuestions.forEach((question, index) => {\n                const domain = question.domain;\n                if (!domainPerformance[domain]) {\n                    domainPerformance[domain] = {\n                        total: 0,\n                        correct: 0\n                    };\n                }\n                \n                domainPerformance[domain].total++;\n                if (userAnswers[index] === question.correctAnswer) {\n                    domainPerformance[domain].correct++;\n                }\n            });\n            \n            // Update results UI\n            document.getElementById(\'final-score\').textContent = `${scorePercentage}%`;\n            document.getElementById(\'correct-answers\').textContent = `${correctCount}/${currentQuestions.length}`;\n            document.getElementById(\'time-taken\').textContent = timeString;\n            \n            // Generate domain stats\n            const domainStatsContainer = document.getElementById(\'domain-stats-container\');\n            domainStatsContainer.innerHTML = \'\';\n            \n            Object.entries(domainPerformance).forEach(([domain, stats]) => {\n                const percentage = Math.round((stats.correct / stats.total) * 100);\n                const domainColor = getDomainColorClass(percentage);\n                \n                const domainStat = document.createElement(\'div\');\n                domainStat.className = \'mb-4\';\n                domainStat.innerHTML = `\n                    <div class="flex justify-between items-center mb-1">\n                        <span class="text-sm font-medium text-gray-700">${domain}</span>\n                        <span class="text-sm font-medium ${domainColor.text}">${percentage}%</span>\n                    </div>\n                    <div class="w-full bg-gray-200 rounded-full h-2.5">\n                        <div class="${domainColor.bg} h-2.5 rounded-full" style="width: ${percentage}%"></div>\n                    </div>\n                    <div class="text-xs text-gray-500 mt-1">${stats.correct} / ${stats.total} correct</div>\n                `;\n                domainStatsContainer.appendChild(domainStat);\n            });\n            \n            // Generate recommendations\n            const recommendationsList = document.getElementById(\'recommendations-list\');\n            recommendationsList.innerHTML = \'\';\n            \n            // Find weakest domains\n            const weakDomains = Object.entries(domainPerformance)\n                .map(([domain, stats]) => ({\n                    domain,\n                    percentage: Math.round((stats.correct / stats.total) * 100)\n                }))\n                .sort((a, b) => a.percentage - b.percentage)\n                .slice(0, 3);\n            \n            // Generate recommendations based on weak domains\n            weakDomains.forEach(domainData => {\n                const recommendation = document.createElement(\'li\');\n                recommendation.textContent = getRecommendation(domainData.domain);\n                recommendationsList.appendChild(recommendation);\n            });\n            \n            // Show results screen\n            document.getElementById(\'assessment-screen\').classList.add(\'hidden\');\n            document.getElementById(\'results-screen\').classList.remove(\'hidden\');\n            \n            // Save results to localStorage for detailed view\n            const resultsData = {\n                score: scorePercentage,\n                correctAnswers: correctCount,\n                totalQuestions: currentQuestions.length,\n                completionTime: timeString,\n                domains: Object.entries(domainPerformance).map(([domain, stats]) => ({\n                    name: domain,\n                    score: Math.round((stats.correct / stats.total) * 100)\n                })),\n                recommendations: Array.from(recommendationsList.children).map(li => li.textContent)\n            };\n            \n            localStorage.setItem(\'assessmentResults\', JSON.stringify(resultsData));\n        }\n\n        // Get domain color class based on score\n        function getDomainColorClass(score) {\n            if (score >= 80) {\n                return { bg: \'bg-green-600\', text: \'text-green-600\' };\n            } else if (score >= 70) {\n                return { bg: \'bg-blue-600\', text: \'text-blue-600\' };\n            } else if (score >= 60) {\n                return { bg: \'bg-yellow-600\', text: \'text-yellow-600\' };\n            } else {\n                return { bg: \'bg-red-600\', text: \'text-red-600\' };\n            }\n        }\n\n        // Get recommendation based on domain\n        function getRecommendation(domain) {\n            const recommendations = {\n                "Child Development Theories": "Review key child development theories such as Piaget\'s stages and Vygotsky\'s zone of proximal development.",\n                "Curriculum Approaches": "Study different curriculum approaches, focusing on child-centered methods like Reggio Emilia and play-based learning.",\n                "Assessment Methods": "Explore authentic assessment techniques to better document and understand children\'s learning.",\n                "Quality Measurement": "Familiarize yourself with quality measurement tools like CLASS and apply their principles in your practice.",\n                "Health & Safety": "Review current health and safety guidelines and best practices for early childhood settings.",\n                "Developmentally Appropriate Practice": "Deepen your understanding of how to apply developmentally appropriate practices across all areas.",\n                "Teaching Strategies": "Focus on scaffolding techniques and differentiating instruction for diverse learners.",\n                "Guidance & Behavior Management": "Study positive guidance strategies and techniques for supporting children\'s self-regulation.",\n                "Communication & Language": "Practice using open-ended questions and strategies to extend children\'s language development.",\n                "Literacy Development": "Explore research-based approaches to emergent literacy and methods for rich literacy experiences.",\n                "Family Engagement": "Develop strategies for meaningful family partnerships that value diverse cultures and knowledge.",\n                "Inclusion & Diversity": "Build skills in creating inclusive environments and adapting activities for all children.",\n                "Cognitive Development": "Focus on understanding and supporting the development of executive function skills and mathematical thinking.",\n                "Language Development": "Learn more about supporting dual language learners and language acquisition stages.",\n                "Learning Environment": "Study how to design engaging, well-organized learning spaces that promote all aspects of development.",\n                "Observation & Assessment": "Practice documentation techniques to make children\'s learning visible and inform planning.",\n                "Social-Emotional Development": "Enhance your knowledge of strategies to support resilience and social-emotional skills.",\n                "Physical Development": "Ensure sufficient opportunities for both fine and gross motor development throughout the day.",\n                "Technology Integration": "Learn about developmentally appropriate technology use that enhances rather than replaces hands-on learning.",\n                "Family & Community Engagement": "Explore the \'funds of knowledge\' approach to better incorporate family cultures and expertise.",\n                "Play & Learning": "Deepen your understanding of how to support and extend learning through different types of play."\n            };\n            \n            return recommendations[domain] || `Focus on building your knowledge in ${domain}.`;\n        }\n\n        // Save results and redirect to detailed view\n        function saveAndViewResults() {\n            window.location.href = "/assessment-results.html";\n        }\n\n        // Restart the assessment\n        function restartAssessment() {\n            document.getElementById(\'results-screen\').classList.add(\'hidden\');\n            document.getElementById(\'setup-screen\').classList.remove(\'hidden\');\n            document.getElementById(\'name\').value = \'\';\n            document.getElementById(\'email\').value = \'\';\n        }\n    </script>\n', PosixPath('backup/cleanup-phase1/assessment.html'), 'config..semgrep.vendored-rules.html.security.audit.insecure-document-method') match_id = 18b8d6cabeafeca15d694504979ceaab571749bd5a91bde4fe7a271dda2796659d1010ff4a3d6a9f86bcccd49139e0de1c66206ad39b6547281e462f651b97a2_0
