               "Review health and safety protocols for classroom settings"\n            ];\n\n            recommendations.forEach(recommendation => {\n                const li = document.createElement(\'li\');\n                li.textContent = recommendation;\n                recommendationsList.appendChild(li);\n            });\n        });\n\n        // Helper function to get domain color based on score\n        function getDomainColor(score) {\n            if (score >= 80) {\n                return { bg: \'bg-green-600\', text: \'text-white\' };\n            } else if (score >= 70) {\n                return { bg: \'bg-blue-600\', text: \'text-white\' };\n            } else if (score >= 60) {\n                return { bg: \'bg-yellow-600\', text: \'text-white\' };\n            } else {\n                return { bg: \'bg-red-600\', text: \'text-white\' };\n            }\n        }\n    </script>\n', PosixPath('backup/cleanup-phase1/assessment-results.html'), 'config..semgrep.vendored-rules.html.security.audit.insecure-document-method') match_id = 80c5b50bd4aa5bfeaac232abd6f6069a9fad3658a2c266ea27611c1d842f7637bc0d7ab640c43f453f564d0ad5a472d0708fea41fdd101e29f108545b24dfa88_0
